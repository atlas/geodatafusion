# Edge cases for ST_MakePolygon, not covered by the PostGIS docs examples.

# A shell
query T
SELECT ST_AsText(ST_MakePolygon('LINESTRING(0 0,4 0,4 4,0 0)'::geometry))
----
POLYGON((0 0,4 0,4 4,0 0))

query T
SELECT ST_AsEWKT(ST_MakePolygon('SRID=4326;LINESTRING Z (0 0 1,1 0 2,1 1 3,0 0 1)'::geometry))
----
SRID=4326;POLYGON((0 0 1,1 0 2,1 1 3,0 0 1))

query T
SELECT ST_AsEWKT(ST_MakePolygon('LINESTRING Z (0 0 1,1 0 2,1 1 3,0 0 5)'::geometry))
----
POLYGON((0 0 1,1 0 2,1 1 3,0 0 5))

query T
SELECT ST_AsEWKT(ST_MakePolygon('LINESTRING M (0 0 1,1 0 2,1 1 3,0 0 5)'::geometry))
----
POLYGONM((0 0 1,1 0 2,1 1 3,0 0 5))

# Holes
query T
SELECT ST_AsText(ST_MakePolygon('LINESTRING(0 0,4 0,4 4,0 0)'::geometry, ARRAY['LINESTRING(1 1,2 1,2 2,1 1)'::geometry, 'LINESTRING(3 1,3.5 1,3.5 2,3 1)'::geometry]))
----
POLYGON((0 0,4 0,4 4,0 0),(1 1,2 1,2 2,1 1),(3 1,3.5 1,3.5 2,3 1))

query T
SELECT ST_AsText(ST_MakePolygon('LINESTRING(0 0,4 0,4 4,0 0)'::geometry, ARRAY['LINESTRING(1 1,2 1,2 2,1 1)'::geometry]))
----
POLYGON((0 0,4 0,4 4,0 0),(1 1,2 1,2 2,1 1))

# NULL
query T
SELECT ST_MakePolygon(NULL::geometry)
----
NULL

query T
SELECT ST_AsText(ST_MakePolygon('LINESTRING(0 0,4 0,4 4,0 0)'::geometry, NULL))
----
NULL

# Invalid rings
query error
SELECT ST_MakePolygon('LINESTRING(0 0,1 0,1 1)'::geometry)

query error
SELECT ST_MakePolygon('LINESTRING(0 0,1 0,0 0)'::geometry)

query error
SELECT ST_MakePolygon('LINESTRING(0 0,1 0,1 1,0 1)'::geometry)

query error
SELECT ST_MakePolygon('LINESTRING EMPTY'::geometry)

query error
SELECT ST_MakePolygon('POINT(1 1)'::geometry)

query error
SELECT ST_MakePolygon('MULTILINESTRING((0 0,1 0,1 1,0 0))'::geometry)

query error
SELECT ST_MakePolygon('LINESTRING(0 0,4 0,4 4,0 0)'::geometry, ARRAY['LINESTRING(1 1,2 1,2 2)'::geometry])

query error
SELECT ST_MakePolygon('LINESTRING(0 0,4 0,4 4,0 0)'::geometry, ARRAY['POINT(1 1)'::geometry])

query error
SELECT ST_MakePolygon('LINESTRING(0 0,4 0,4 4,0 0)'::geometry, ARRAY['LINESTRING(1 1,2 1,2 2,1 2)'::geometry])

query error
SELECT ST_MakePolygon('LINESTRING(0 0,4 0,4 4,0 0)'::geometry, ARRAY['LINESTRING Z (1 1 1,2 1 1,2 2 1,1 1 1)'::geometry])

# A column
query T rowsort
SELECT ST_AsText(ST_MakePolygon(g)) FROM (VALUES ('LINESTRING(0 0,4 0,4 4,0 0)'::geometry), (NULL::geometry), ('LINESTRING(0 0,1 0,0 1,0 0)'::geometry)) AS t(g)
----
NULL
POLYGON((0 0,1 0,0 1,0 0))
POLYGON((0 0,4 0,4 4,0 0))
