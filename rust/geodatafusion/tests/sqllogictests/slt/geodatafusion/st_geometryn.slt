# Edge cases for ST_GeometryN, not covered by the PostGIS docs examples.

# Each collection type
query T
SELECT ST_AsText(ST_GeometryN('MULTIPOINT((1 2),(3 4),(5 6))'::geometry, 2))
----
POINT(3 4)

query T
SELECT ST_AsText(ST_GeometryN('MULTILINESTRING((0 0,1 1),(2 2,3 3))'::geometry, 1))
----
LINESTRING(0 0,1 1)

query T
SELECT ST_AsText(ST_GeometryN('MULTIPOLYGON(((0 0,1 0,1 1,0 0)),((5 5,6 5,6 6,5 5)))'::geometry, 2))
----
POLYGON((5 5,6 5,6 6,5 5))

query T
SELECT ST_AsText(ST_GeometryN('GEOMETRYCOLLECTION(POINT(1 1),LINESTRING(0 0,1 1))'::geometry, 2))
----
LINESTRING(0 0,1 1)

# Single geometries: themselves for n = 1
query T
SELECT ST_AsText(ST_GeometryN('POINT(1 2)'::geometry, 1))
----
POINT(1 2)

query T
SELECT ST_AsText(ST_GeometryN('LINESTRING(0 0,1 1)'::geometry, 1))
----
LINESTRING(0 0,1 1)

query T
SELECT ST_AsText(ST_GeometryN('POLYGON((0 0,1 0,1 1,0 0))'::geometry, 2))
----
NULL

# Out of range
query T
SELECT ST_AsText(ST_GeometryN('MULTIPOINT((1 2),(3 4))'::geometry, 3))
----
NULL

query T
SELECT ST_AsText(ST_GeometryN('MULTIPOINT((1 2),(3 4))'::geometry, 0))
----
NULL

query T
SELECT ST_AsText(ST_GeometryN('MULTIPOINT((1 2),(3 4))'::geometry, -1))
----
NULL

# EMPTY
query T
SELECT ST_AsText(ST_GeometryN('POINT EMPTY'::geometry, 1))
----
NULL

query T
SELECT ST_AsText(ST_GeometryN('MULTIPOINT EMPTY'::geometry, 1))
----
NULL

query T
SELECT ST_AsText(ST_GeometryN('GEOMETRYCOLLECTION(POINT EMPTY)'::geometry, 1))
----
NULL

query T
SELECT ST_AsText(ST_GeometryN('MULTIPOINT(EMPTY,(1 1))'::geometry, 1))
----
POINT EMPTY

query T
SELECT ST_AsText(ST_GeometryN('MULTIPOLYGON(EMPTY,((0 0,1 0,1 1,0 0)))'::geometry, 1))
----
POLYGON EMPTY

# Z, M and the SRID are kept
query T
SELECT ST_AsEWKT(ST_GeometryN('SRID=4326;MULTIPOINT ZM ((1 2 3 4),(5 6 7 8))'::geometry, 2))
----
SRID=4326;POINT(5 6 7 8)

query T
SELECT ST_AsEWKT(ST_GeometryN('SRID=3857;GEOMETRYCOLLECTION M (POINT M (1 2 3),LINESTRING M (0 0 1,1 1 2))'::geometry, 2))
----
SRID=3857;LINESTRINGM(0 0 1,1 1 2)

query T
SELECT ST_AsEWKT(ST_GeometryN('MULTIPOLYGON Z (((0 0 1,1 0 2,1 1 3,0 0 1)))'::geometry, 1))
----
POLYGON((0 0 1,1 0 2,1 1 3,0 0 1))

# Nested collections return the member collection
query T
SELECT ST_AsText(ST_GeometryN('GEOMETRYCOLLECTION(POINT(1 1),MULTIPOINT((2 2),(3 3)))'::geometry, 2))
----
MULTIPOINT((2 2),(3 3))

# NULL
query T
SELECT ST_GeometryN(NULL::geometry, 1)
----
NULL

query T
SELECT ST_AsText(ST_GeometryN('MULTIPOINT((1 2))'::geometry, NULL))
----
NULL

# Columns for both arguments
query IT rowsort
SELECT n, ST_AsText(ST_GeometryN(g, n)) FROM (VALUES ('MULTIPOINT((1 1),(2 2))'::geometry, 1), ('MULTIPOINT((1 1),(2 2))'::geometry, 2), (NULL::geometry, 1), ('POINT(5 5)'::geometry, NULL)) AS t(g, n)
----
1 NULL
1 POINT(1 1)
2 POINT(2 2)
NULL NULL

# Nested collections
query T
SELECT ST_AsText(ST_GeometryN('GEOMETRYCOLLECTION(GEOMETRYCOLLECTION(POINT(1 2)),POINT(3 4))'::geometry, 1))
----
GEOMETRYCOLLECTION(POINT(1 2))
