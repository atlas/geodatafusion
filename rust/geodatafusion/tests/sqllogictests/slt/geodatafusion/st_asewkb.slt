# Edge cases for ST_AsEWKB, not covered by the PostGIS docs examples.

# Every type and dimension
query T
SELECT ST_AsEWKB('POINT(1 2)'::geometry)
----
\x0101000000000000000000f03f0000000000000040

query T
SELECT ST_AsEWKB('LINESTRING Z (0 0 1,1 1 2)'::geometry)
----
\x01020000800200000000000000000000000000000000000000000000000000f03f000000000000f03f000000000000f03f0000000000000040

query T
SELECT ST_AsEWKB('POLYGON M ((0 0 1,1 0 1,1 1 1,0 0 1))'::geometry)
----
\x0103000040010000000400000000000000000000000000000000000000000000000000f03f000000000000f03f0000000000000000000000000000f03f000000000000f03f000000000000f03f000000000000f03f00000000000000000000000000000000000000000000f03f

query T
SELECT ST_AsEWKB('MULTIPOINT ZM ((1 2 3 4),(5 6 7 8))'::geometry)
----
\x01040000c00200000001010000c0000000000000f03f00000000000000400000000000000840000000000000104001010000c0000000000000144000000000000018400000000000001c400000000000002040

query T
SELECT ST_AsEWKB('GEOMETRYCOLLECTION(POINT(1 2),LINESTRING EMPTY)'::geometry)
----
\x0107000000020000000101000000000000000000f03f0000000000000040010200000000000000

# SRID
query T
SELECT ST_AsEWKB('SRID=4326;POINT(1 2)'::geometry)
----
\x0101000020e6100000000000000000f03f0000000000000040

query T
SELECT ST_AsEWKB('SRID=3857;MULTILINESTRING((0 0,1 1))'::geometry)
----
\x0105000020110f00000100000001020000000200000000000000000000000000000000000000000000000000f03f000000000000f03f

# Byte order
query T
SELECT ST_AsEWKB('POINT(1 2)'::geometry, 'XDR')
----
\x00000000013ff00000000000004000000000000000

query T
SELECT ST_AsEWKB('POINT(1 2)'::geometry, 'xdr')
----
\x00000000013ff00000000000004000000000000000

query T
SELECT ST_AsEWKB('POINT(1 2)'::geometry, 'NDR')
----
\x0101000000000000000000f03f0000000000000040

query T
SELECT ST_AsEWKB('POINT(1 2)'::geometry, 'xDr')
----
\x0101000000000000000000f03f0000000000000040

query T
SELECT ST_AsEWKB('SRID=4326;POINT Z (1 2 3)'::geometry, 'XDR')
----
\x00a0000001000010e63ff000000000000040000000000000004008000000000000

query T
SELECT ST_AsEWKB('POINT(1 2)'::geometry, NULL)
----
NULL

# EMPTY and NULL
query T
SELECT ST_AsEWKB('POINT EMPTY'::geometry)
----
\x0101000000000000000000f87f000000000000f87f

query T
SELECT ST_AsEWKB('POLYGON Z EMPTY'::geometry)
----
\x010300008000000000

query T
SELECT ST_AsEWKB(NULL::geometry)
----
NULL

# A column, including NULL
query T rowsort
SELECT ST_AsEWKB(g) FROM (VALUES ('SRID=4326;POINT(1 2)'::geometry), (ST_SetSRID(NULL::geometry, 4326)), ('SRID=4326;POINT EMPTY'::geometry)) AS t(g)
----
NULL
\x0101000020e6100000000000000000f03f0000000000000040
\x0101000020e6100000000000000000f87f000000000000f87f
