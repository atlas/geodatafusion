# Edge cases for ST_GeomFromGeoHash, not covered by the PostGIS docs examples.

# Precision
query T
SELECT ST_AsText(ST_GeomFromGeoHash('9qqj7nmxncgyy4d0dbxqz0'))
----
POLYGON((-115.17281600000001 36.11464599999999,-115.17281600000001 36.114646,-115.172816 36.114646,-115.172816 36.11464599999999,-115.17281600000001 36.11464599999999))

query T
SELECT ST_AsText(ST_GeomFromGeoHash('9qqj7nmxncgyy4d0dbxqz0', 4))
----
POLYGON((-115.3125 36.03515625,-115.3125 36.2109375,-114.9609375 36.2109375,-114.9609375 36.03515625,-115.3125 36.03515625))

query T
SELECT ST_AsText(ST_GeomFromGeoHash('9qqj', 10))
----
POLYGON((-115.3125 36.03515625,-115.3125 36.2109375,-114.9609375 36.2109375,-114.9609375 36.03515625,-115.3125 36.03515625))

query T
SELECT ST_AsText(ST_GeomFromGeoHash('9qqj', 0))
----
POLYGON((-180 -90,-180 90,180 90,180 -90,-180 -90))

query T
SELECT ST_AsText(ST_GeomFromGeoHash('9qqj', -1))
----
POLYGON((-115.3125 36.03515625,-115.3125 36.2109375,-114.9609375 36.2109375,-114.9609375 36.03515625,-115.3125 36.03515625))

query T
SELECT ST_AsText(ST_GeomFromGeoHash('9qqj', NULL))
----
POLYGON((-115.3125 36.03515625,-115.3125 36.2109375,-114.9609375 36.2109375,-114.9609375 36.03515625,-115.3125 36.03515625))

# Uppercase, empty and very long GeoHashes
query T
SELECT ST_AsText(ST_GeomFromGeoHash('9QQJ'))
----
POLYGON((-115.3125 36.03515625,-115.3125 36.2109375,-114.9609375 36.2109375,-114.9609375 36.03515625,-115.3125 36.03515625))

query T
SELECT ST_AsText(ST_GeomFromGeoHash(''))
----
POLYGON((-180 -90,-180 90,180 90,180 -90,-180 -90))

query T
SELECT ST_AsText(ST_GeomFromGeoHash('umyxzxs9mkzz50g4zeqjpm'))
----
LINESTRING(20.72663048240998 78.7474946535387,20.726630482409988 78.7474946535387)

# Invalid characters are an error
statement error
SELECT ST_GeomFromGeoHash('9qqa')

# NULL
query T
SELECT ST_AsText(ST_GeomFromGeoHash(NULL))
----
NULL

# A column, including NULL
query T rowsort
SELECT ST_AsText(ST_GeomFromGeoHash(h)) FROM (VALUES ('9qqj'), (NULL), ('s000')) AS t(h)
----
NULL
POLYGON((-115.3125 36.03515625,-115.3125 36.2109375,-114.9609375 36.2109375,-114.9609375 36.03515625,-115.3125 36.03515625))
POLYGON((0 0,0 0.17578125,0.3515625 0.17578125,0.3515625 0,0 0))
