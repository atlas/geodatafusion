# Edge cases for ST_FlipCoordinates, not covered by the PostGIS docs examples.

# Every geometry type
query T
SELECT ST_AsText(ST_FlipCoordinates('POINT(1 2)'::geometry))
----
POINT(2 1)

query T
SELECT ST_AsText(ST_FlipCoordinates('LINESTRING(0 1,2 3)'::geometry))
----
LINESTRING(1 0,3 2)

query T
SELECT ST_AsText(ST_FlipCoordinates('POLYGON((0 0,4 0,4 4,0 0),(1 1,2 1,2 2,1 1))'::geometry))
----
POLYGON((0 0,0 4,4 4,0 0),(1 1,1 2,2 2,1 1))

query T
SELECT ST_AsText(ST_FlipCoordinates('MULTIPOINT((1 2),(3 4))'::geometry))
----
MULTIPOINT((2 1),(4 3))

query T
SELECT ST_AsText(ST_FlipCoordinates('GEOMETRYCOLLECTION(POINT(1 2),LINESTRING(0 1,2 3))'::geometry))
----
GEOMETRYCOLLECTION(POINT(2 1),LINESTRING(1 0,3 2))

# Z, M and the SRID are kept
query T
SELECT ST_AsEWKT(ST_FlipCoordinates('SRID=4326;POINT ZM (1 2 3 4)'::geometry))
----
SRID=4326;POINT(2 1 3 4)

query T
SELECT ST_AsEWKT(ST_FlipCoordinates('LINESTRING M (1 2 3,4 5 6)'::geometry))
----
LINESTRINGM(2 1 3,5 4 6)

# EMPTY and NULL
query T
SELECT ST_AsText(ST_FlipCoordinates('POINT EMPTY'::geometry))
----
POINT EMPTY

query T
SELECT ST_AsText(ST_FlipCoordinates('MULTIPOINT(EMPTY,(1 2))'::geometry))
----
MULTIPOINT(EMPTY,(2 1))

query T
SELECT ST_FlipCoordinates(NULL::geometry)
----
NULL

# A column, including NULL
query T rowsort
SELECT ST_AsText(ST_FlipCoordinates(g)) FROM (VALUES ('POINT(1 2)'::geometry), (NULL::geometry), ('LINESTRING(0 1,2 3)'::geometry)) AS t(g)
----
LINESTRING(1 0,3 2)
NULL
POINT(2 1)
