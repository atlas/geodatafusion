# Edge cases for ST_RotateX, not covered by the PostGIS docs examples.

# 3D, and 2D rotated with Z 0
query T
SELECT ST_AsEWKT(ST_RotateX('POINT Z (1 2 3)'::geometry, pi()/2))
----
POINT(1 -3 2)

query T
SELECT ST_AsEWKT(ST_RotateX('LINESTRING Z (1 2 3,4 5 6)'::geometry, 0.7))
----
LINESTRING(1 -0.402968687144096 3.582961936328847,4 -0.041095187003704 7.810141559895386)

query T
SELECT ST_AsEWKT(ST_RotateX('POINT(1 2)'::geometry, pi()/2))
----
POINT(1 1.224646799147353e-16)

query T
SELECT ST_AsEWKT(ST_RotateX('POINT M (1 2 3)'::geometry, pi()/2))
----
POINTM(1 1.224646799147353e-16 3)

query T
SELECT ST_AsEWKT(ST_RotateX('POINT ZM (1 2 3 4)'::geometry, pi()))
----
POINT(1 -2 -3 4)

query T
SELECT ST_AsText(ST_RotateX('POLYGON Z ((0 0 0,4 0 1,4 4 2,0 0 0))'::geometry, pi()/3))
----
POLYGON Z ((0 0 0,4 -0.866025403784439 0.5,4 0.267949192431123 4.464101615137754,0 0 0))

# EMPTY, the SRID and NULL
query T
SELECT ST_AsText(ST_RotateX('POINT EMPTY'::geometry, 1))
----
POINT EMPTY

query T
SELECT ST_AsEWKT(ST_RotateX('SRID=4326;POINT Z (1 2 3)'::geometry, 1))
----
SRID=4326;POINT(1 -1.44380834268741 3.303848887220212)

query T
SELECT ST_RotateX(NULL::geometry, 1)
----
NULL

query T
SELECT ST_AsText(ST_RotateX('POINT Z (1 2 3)'::geometry, NULL))
----
NULL
