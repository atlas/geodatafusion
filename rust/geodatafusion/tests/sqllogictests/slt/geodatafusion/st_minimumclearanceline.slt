# Edge cases for ST_MinimumClearanceLine, not covered by the PostGIS docs examples.

# Every type
query T
SELECT ST_MinimumClearanceLine('POLYGON((0 0,1 0,1 1,0.5 3.2e-4,0 0))'::geometry)
----
LINESTRING(0.5 0.00032,0.5 0)

query T
SELECT ST_MinimumClearanceLine('LINESTRING(0 0,1 0,1 1,0.5 0.1)'::geometry)
----
LINESTRING(0.5 0.1,0.5 0)

query T
SELECT ST_MinimumClearanceLine('MULTIPOINT((0 0),(1 0),(5 5))'::geometry)
----
LINESTRING(1 0,0 0)

query T
SELECT ST_MinimumClearanceLine('POINT(1 2)'::geometry)
----
LINESTRING EMPTY

query T
SELECT ST_MinimumClearanceLine('GEOMETRYCOLLECTION(POINT(0 0),POINT(3 4))'::geometry)
----
LINESTRING(3 4,0 0)

# Z and M
query T
SELECT ST_MinimumClearanceLine('LINESTRING Z (0 0 1,1 0 2,1 1 3,0.5 0.1 4)'::geometry)
----
LINESTRING(0.5 0.1,0.5 0)

query T
SELECT ST_MinimumClearanceLine('LINESTRING M (0 0 1,1 0 2,1 1 3,0.5 0.1 4)'::geometry)
----
LINESTRING(0.5 0.1,0.5 0)

# SRID
query T
SELECT ST_MinimumClearanceLine('SRID=4326;MULTIPOINT((0 0),(1 0),(5 5))'::geometry)
----
SRID=4326;LINESTRING(1 0,0 0)

# EMPTY and NULL
query T
SELECT ST_MinimumClearanceLine('POINT EMPTY'::geometry)
----
LINESTRING EMPTY

query T
SELECT ST_MinimumClearanceLine('POLYGON M EMPTY'::geometry)
----
LINESTRING EMPTY

query T
SELECT ST_MinimumClearanceLine(NULL::geometry)
----
NULL
