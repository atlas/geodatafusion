# Edge cases for ST_Rotate, not covered by the PostGIS docs examples.

# About the origin, a point given as numbers, or a POINT
query T
SELECT ST_AsText(ST_Rotate('POINT(1 0)'::geometry, pi()/2))
----
POINT(6.123233995736766e-17 1)

query T
SELECT ST_AsText(ST_Rotate('LINESTRING(1 1,2 2)'::geometry, pi(), 1, 1))
----
LINESTRING(1 1,-4.440892098500626e-16 2.220446049250313e-16)

query T
SELECT ST_AsText(ST_Rotate('LINESTRING(1 1,2 2)'::geometry, pi(), 'POINT(1 1)'::geometry))
----
LINESTRING(1 1,-4.440892098500626e-16 2.220446049250313e-16)

query T
SELECT ST_AsText(ST_Rotate('POLYGON((0 0,4 0,4 4,0 0),(1 1,2 1,2 2,1 1))'::geometry, 0.3, 2, 2))
----
POLYGON((0.680367435071467 -0.501713391573891,4.501713391573891 0.680367435071467,3.319632564928533 4.501713391573891,0.680367435071467 -0.501713391573891),(1.340183717535734 0.749143304213054,2.295520206661339 1.044663510874394,2 2,1.340183717535734 0.749143304213054))

query T
SELECT ST_AsText(ST_Rotate('GEOMETRYCOLLECTION(POINT(1 1),LINESTRING(0 0,1 2))'::geometry, -pi()/4))
----
GEOMETRYCOLLECTION(POINT(1.414213562373095 1.110223024625156e-16),LINESTRING(0 0,2.121320343559642 0.707106781186548))

# Z and M are unchanged
query T
SELECT ST_AsEWKT(ST_Rotate('POINT ZM (1 2 3 4)'::geometry, pi()/2))
----
POINT(-2 1 3 4)

query T
SELECT ST_AsEWKT(ST_Rotate('POINT M (1 2 3)'::geometry, pi()/2, 'POINT Z (1 1 9)'::geometry))
----
POINTM(0 1 3)

# An empty origin gives NULL; its SRID isn't checked
query T
SELECT ST_AsText(ST_Rotate('POINT(1 1)'::geometry, 1, 'POINT EMPTY'::geometry))
----
NULL

query T
SELECT ST_AsEWKT(ST_Rotate('SRID=4326;POINT(1 1)'::geometry, pi(), 'SRID=3857;POINT(2 2)'::geometry))
----
SRID=4326;POINT(3 3)

# EMPTY and NULL
query T
SELECT ST_AsText(ST_Rotate('POINT EMPTY'::geometry, 1))
----
POINT EMPTY

query T
SELECT ST_AsEWKT(ST_Rotate('SRID=4326;LINESTRING EMPTY'::geometry, 1, 2, 3))
----
SRID=4326;LINESTRING EMPTY

query T
SELECT ST_Rotate(NULL::geometry, 1)
----
NULL

query T
SELECT ST_AsText(ST_Rotate('POINT(1 1)'::geometry, NULL))
----
NULL

query T
SELECT ST_AsText(ST_Rotate('POINT(1 1)'::geometry, 1, NULL, 2))
----
NULL

query T
SELECT ST_AsText(ST_Rotate('POINT(1 1)'::geometry, 1, NULL::geometry))
----
NULL

# The origin must be a point
query error
SELECT ST_Rotate('POINT(1 1)'::geometry, 1, 'LINESTRING(0 0,1 1)'::geometry)

# Columns
query RT rowsort
SELECT a, ST_AsText(ST_Rotate(g, a)) FROM (VALUES ('POINT(1 1)'::geometry, 0.5), ('LINESTRING(0 0,1 2)'::geometry, 1.5), (NULL::geometry, 1), ('POINT(1 1)'::geometry, NULL)) AS t(g, a)
----
0.5 POINT(0.39815702328617 1.357008100494576)
1 NULL
1.5 LINESTRING(0 0,-1.924252771540406 1.13896938993946)
NULL NULL
