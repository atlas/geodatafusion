# Edge cases for ST_IsValidReason, not covered by the PostGIS docs examples.

# Valid and invalid
query T
SELECT ST_IsValidReason('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry)
----
Valid Geometry

query T
SELECT ST_IsValidReason('POLYGON((0 0,10 10,10 0,0 10,0 0))'::geometry)
----
Self-intersection[5 5]

query T
SELECT ST_IsValidReason('POLYGON((0 0,10 0,10 10,0 10,0 0),(5 5,15 5,15 15,5 15,5 5))'::geometry)
----
Self-intersection[5 10]

query T
SELECT ST_IsValidReason('LINESTRING(0 0,0 0)'::geometry)
----
Too few points in geometry component[0 0]

query T
SELECT ST_IsValidReason('MULTIPOLYGON(((0 0,2 0,2 2,0 2,0 0)),((1 1,3 1,3 3,1 3,1 1)))'::geometry)
----
Self-intersection[1 2]

query T
SELECT ST_IsValidReason('POINT(1 2)'::geometry)
----
Valid Geometry

query T
SELECT ST_IsValidReason('GEOMETRYCOLLECTION(POINT(1 1),POLYGON((0 0,10 10,10 0,0 10,0 0)))'::geometry)
----
Self-intersection[5 5]

query T
SELECT ST_IsValidReason('POLYGON Z ((0 0 1,10 10 2,10 0 3,0 10 4,0 0 1))'::geometry)
----
Self-intersection[5 5]

query T
SELECT ST_IsValidReason('POLYGON M ((0 0 1,10 10 2,10 0 3,0 10 4,0 0 1))'::geometry)
----
Self-intersection[5 5]

# EMPTY and NULL
query T
SELECT ST_IsValidReason('POINT EMPTY'::geometry)
----
Valid Geometry

query T
SELECT ST_IsValidReason('POLYGON EMPTY'::geometry)
----
Valid Geometry

query T
SELECT ST_IsValidReason(NULL::geometry)
----
NULL

# A column, including NULL
query T rowsort
SELECT ST_IsValidReason(g) FROM (VALUES ('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry), (NULL::geometry), ('POLYGON((0 0,10 10,10 0,0 10,0 0))'::geometry)) AS t(g)
----
NULL
Self-intersection[5 5]
Valid Geometry

# Flags: the reason without the location
query T
SELECT ST_IsValidReason('POLYGON((100 200,100 100,200 200,200 100,100 200))'::geometry, 0)
----
Self-intersection

query T
SELECT ST_IsValidReason('POLYGON((0 0,10 0,10 10,5 0,0 10,0 0))'::geometry, 0)
----
Ring Self-intersection

query T
SELECT ST_IsValidReason('POLYGON((0 0,10 0,10 10,5 0,0 10,0 0))'::geometry, 1)
----
Interior is disconnected

query T
SELECT ST_IsValidReason('LINESTRING(0 0,0 0)'::geometry, 0)
----
Too few points in geometry component

query T
SELECT ST_IsValidReason('POINT(1 2)'::geometry, 1)
----
Valid Geometry

query T
SELECT ST_IsValidReason('POLYGON EMPTY'::geometry, 0)
----
Valid Geometry

query T
SELECT ST_IsValidReason('POLYGON((0 0,10 0,10 10,5 0,0 10,0 0))'::geometry, NULL)
----
NULL
