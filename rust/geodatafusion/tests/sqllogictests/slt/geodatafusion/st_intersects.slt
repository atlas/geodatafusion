# ST_Intersects with constant and column arguments in both positions, NULL constants, and geography.

# Constant first argument, column second
query TT rowsort
SELECT ST_AsText(g), ST_Intersects('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, g)
FROM (VALUES ('POINT(5 5)'::geometry), ('POINT(20 20)'::geometry), ('POLYGON((0 0,20 0,20 20,0 20,0 0))'::geometry)) AS t(g)
----
POINT(20 20) false
POINT(5 5) true
POLYGON((0 0,20 0,20 20,0 20,0 0)) true

# Column first argument, constant second
query TT rowsort
SELECT ST_AsText(g), ST_Intersects(g, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry)
FROM (VALUES ('POINT(5 5)'::geometry), ('POINT(20 20)'::geometry), ('POLYGON((0 0,20 0,20 20,0 20,0 0))'::geometry)) AS t(g)
----
POINT(20 20) false
POINT(5 5) true
POLYGON((0 0,20 0,20 20,0 20,0 0)) true

# Column arguments on both sides
query TTT rowsort
SELECT ST_AsText(a), ST_AsText(b), ST_Intersects(a, b)
FROM (VALUES
  ('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 'POINT(5 5)'::geometry),
  ('POINT(5 5)'::geometry, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry)
) AS t(a, b)
----
POINT(5 5) POLYGON((0 0,10 0,10 10,0 10,0 0)) true
POLYGON((0 0,10 0,10 10,0 10,0 0)) POINT(5 5) true

# NULL constant first argument
query T rowsort
SELECT ST_Intersects(NULL::geometry, g)
FROM (VALUES ('POINT(5 5)'::geometry), ('POINT(20 20)'::geometry)) AS t(g)
----
NULL
NULL

# NULL constant second argument
query T rowsort
SELECT ST_Intersects(g, NULL::geometry)
FROM (VALUES ('POINT(5 5)'::geometry), ('POINT(20 20)'::geometry)) AS t(g)
----
NULL
NULL

# Point, line and polygon pairs
query T
SELECT ST_Intersects('POINT(5 5)'::geometry, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry)
----
true

query T
SELECT ST_Intersects('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 'POINT(5 5)'::geometry)
----
true

query T
SELECT ST_Intersects('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 'POINT(10 5)'::geometry)
----
true

query T
SELECT ST_Intersects('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 'LINESTRING(-5 5,15 5)'::geometry)
----
true

query T
SELECT ST_Intersects('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 'POLYGON((5 5,15 5,15 15,5 15,5 5))'::geometry)
----
true

query T
SELECT ST_Intersects('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 'POLYGON((10 0,20 0,20 10,10 10,10 0))'::geometry)
----
true

query T
SELECT ST_Intersects('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 'POLYGON((0 0,0 10,10 10,10 0,0 0))'::geometry)
----
true

query T
SELECT ST_Intersects('LINESTRING(0 0,10 10)'::geometry, 'LINESTRING(0 10,10 0)'::geometry)
----
true

query T
SELECT ST_Intersects('MULTIPOINT((1 1),(20 20))'::geometry, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry)
----
true

query T
SELECT ST_Intersects('GEOMETRYCOLLECTION(POINT(5 5),LINESTRING(1 1,2 2))'::geometry, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry)
----
true

query T
SELECT ST_Intersects('POINT Z (5 5 1)'::geometry, 'POLYGON M ((0 0 1,10 0 1,10 10 1,0 10 1,0 0 1))'::geometry)
----
true

# EMPTY inputs
query T
SELECT ST_Intersects('POINT EMPTY'::geometry, 'POINT(1 1)'::geometry)
----
false

query T
SELECT ST_Intersects('POINT(1 1)'::geometry, 'POLYGON EMPTY'::geometry)
----
false

query T
SELECT ST_Intersects('POINT EMPTY'::geometry, 'POINT EMPTY'::geometry)
----
false

query T
SELECT ST_Intersects('GEOMETRYCOLLECTION(POINT EMPTY,POINT(1 1))'::geometry, 'POINT(1 1)'::geometry)
----
true

query T
SELECT ST_Intersects('POLYGON EMPTY'::geometry, 'GEOMETRYCOLLECTION(LINESTRING EMPTY,POINT(1 1))'::geometry)
----
false

# SRID
query T
SELECT ST_Intersects('SRID=4326;POINT(1 1)'::geometry, 'SRID=4326;POINT(1 1)'::geometry)
----
true

statement error
SELECT ST_Intersects('SRID=4326;POINT(1 1)'::geometry, 'SRID=3857;POINT(1 1)'::geometry)

# NULL
query T
SELECT ST_Intersects(NULL::geometry, 'POINT(1 1)'::geometry)
----
NULL

# Columns on both sides
query T rowsort
SELECT ST_Intersects(a, b) FROM (VALUES ('POINT(5 5)'::geometry, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry), ('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 'POINT(5 5)'::geometry), ('POINT(1 1)'::geometry, NULL::geometry)) AS t(a, b)
----
NULL
true
true

# Geography: intersecting is distance zero on the sphere
query TTTTT
SELECT ST_Intersects('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geography, 'POINT(5 5)'::geography), ST_Intersects('LINESTRING(0 0, 10 10)'::geography, 'LINESTRING(0 10, 10 0)'::geography), ST_Intersects('LINESTRING(-10 60, 10 60)'::geography, 'POINT(0 60)'::geography), ST_Intersects('POINT EMPTY'::geography, 'POINT(0 0)'::geography), ST_Intersects('POINT(0 0)'::geography, 'POINT(0 0)'::geometry)
----
true true false false true

# Points within 5e-14 radians in longitude and latitude are the same
query TTT
SELECT ST_Intersects('POINT(0 0)'::geography, 'POINT(0 0.000000000001)'::geography), ST_Intersects('POINT(0 0)'::geography, 'POINT(0 0.00000000001)'::geography), ST_Intersects('LINESTRING(0 79, 0 81)'::geography, 'POINT(0.000000000002 80)'::geography)
----
true false true

query error
SELECT ST_Intersects('SRID=4269;POINT(0 0)'::geography, 'POINT(0 0)'::geography)
