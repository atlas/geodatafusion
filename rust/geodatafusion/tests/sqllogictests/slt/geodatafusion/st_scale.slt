# Edge cases for ST_Scale, not covered by the PostGIS docs examples.

# Float factors: Z only with a Z factor, M never
query T
SELECT ST_AsEWKT(ST_Scale('POINT ZM (1 2 3 4)'::geometry, 2, 3))
----
POINT(2 6 3 4)

query T
SELECT ST_AsEWKT(ST_Scale('POINT ZM (1 2 3 4)'::geometry, 2, 3, 4))
----
POINT(2 6 12 4)

query T
SELECT ST_AsEWKT(ST_Scale('POINT(1 2)'::geometry, 2, 3, 4))
----
POINT(2 6)

query T
SELECT ST_AsText(ST_Scale('POLYGON((0 0,4 0,4 4,0 0),(1 1,2 1,2 2,1 1))'::geometry, 0.5, -1))
----
POLYGON((0 0,2 0,2 -4,0 0),(0.5 -1,1 -1,1 -2,0.5 -1))

query T
SELECT ST_AsText(ST_Scale('POINT(0.1 0.2)'::geometry, 0.3, 0.7))
----
POINT(0.03 0.14)

# A factor point scales the ordinates it has, M included
query T
SELECT ST_AsEWKT(ST_Scale('POINT ZM (1 2 3 4)'::geometry, 'POINT ZM (2 3 4 5)'::geometry))
----
POINT(2 6 12 20)

query T
SELECT ST_AsEWKT(ST_Scale('POINT ZM (1 2 3 4)'::geometry, 'POINT(2 3)'::geometry))
----
POINT(2 6 3 4)

query T
SELECT ST_AsEWKT(ST_Scale('POINT ZM (1 2 3 4)'::geometry, 'POINT M (2 3 5)'::geometry))
----
POINT(2 6 3 20)

query T
SELECT ST_AsEWKT(ST_Scale('POINT(1 2)'::geometry, 'POINT ZM (2 3 4 5)'::geometry))
----
POINT(2 6)

query T
SELECT ST_AsText(ST_Scale('GEOMETRYCOLLECTION(POINT(1 1),LINESTRING(0 0,1 2))'::geometry, 'POINT(2 3)'::geometry))
----
GEOMETRYCOLLECTION(POINT(2 3),LINESTRING(0 0,2 6))

# About an origin; M is scaled about 0
query T
SELECT ST_AsEWKT(ST_Scale('LINESTRING(1 1,2 2)'::geometry, 'POINT(2 2)'::geometry, 'POINT(1 1)'::geometry))
----
LINESTRING(1 1,3 3)

query T
SELECT ST_AsEWKT(ST_Scale('LINESTRING Z (1 1 1,2 2 2)'::geometry, 'POINT Z (2 2 2)'::geometry, 'POINT Z (1 1 1)'::geometry))
----
LINESTRING(1 1 1,3 3 3)

query T
SELECT ST_AsEWKT(ST_Scale('LINESTRING Z (1 1 1,2 2 2)'::geometry, 'POINT Z (2 2 2)'::geometry, 'POINT (1 1)'::geometry))
----
LINESTRING(1 1 2,3 3 4)

query T
SELECT ST_AsEWKT(ST_Scale('LINESTRING M (1 1 1,2 2 2)'::geometry, 'POINT M (2 2 2)'::geometry, 'POINT M (1 1 1)'::geometry))
----
LINESTRINGM(1 1 2,3 3 4)

query T
SELECT ST_AsText(ST_Scale('POINT(0.1 0.2)'::geometry, 'POINT(3 3)'::geometry, 'POINT(0.3 0.7)'::geometry))
----
POINT(-0.3 -0.8)

query T
SELECT ST_AsText(ST_Scale('POINT(1 2)'::geometry, 'POINT(2 2)'::geometry, 'POINT EMPTY'::geometry))
----
POINT(2 4)

# The factor and origin SRIDs aren't checked
query T
SELECT ST_AsEWKT(ST_Scale('SRID=4326;POINT(1 2)'::geometry, 'SRID=3857;POINT(2 2)'::geometry))
----
SRID=4326;POINT(2 4)

query T
SELECT ST_AsEWKT(ST_Scale('SRID=4326;POINT(1 2)'::geometry, 'POINT(2 2)'::geometry, 'SRID=3857;POINT(1 1)'::geometry))
----
SRID=4326;POINT(1 3)

# EMPTY
query T
SELECT ST_AsText(ST_Scale('POINT EMPTY'::geometry, 2, 3))
----
POINT EMPTY

query T
SELECT ST_AsText(ST_Scale('LINESTRING EMPTY'::geometry, 'POINT(2 3)'::geometry))
----
LINESTRING EMPTY

# NULL
query T
SELECT ST_Scale(NULL::geometry, 2, 3)
----
NULL

query T
SELECT ST_AsText(ST_Scale('POINT(1 2)'::geometry, NULL, 3))
----
NULL

query T
SELECT ST_AsText(ST_Scale('POINT(1 2)'::geometry, NULL::geometry))
----
NULL

query T
SELECT ST_AsText(ST_Scale('POINT(1 2)'::geometry, 'POINT(2 2)'::geometry, NULL::geometry))
----
NULL

# The factor must be a point
query error
SELECT ST_Scale('POINT(1 2)'::geometry, 'LINESTRING(0 0,1 1)'::geometry)

# Columns
query TT rowsort
SELECT ST_AsText(f), ST_AsText(ST_Scale(g, f)) FROM (VALUES ('POINT(1 1)'::geometry, 'POINT(2 3)'::geometry), ('LINESTRING(0 0,1 2)'::geometry, 'POINT(-1 1)'::geometry), (NULL::geometry, 'POINT(2 3)'::geometry), ('POINT(1 1)'::geometry, NULL::geometry)) AS t(g, f)
----
NULL NULL
POINT(-1 1) LINESTRING(0 0,-1 2)
POINT(2 3) NULL
POINT(2 3) POINT(2 3)
