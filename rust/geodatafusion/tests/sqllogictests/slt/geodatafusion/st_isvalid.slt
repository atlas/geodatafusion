# Edge cases for ST_IsValid, not covered by the PostGIS docs examples.

# Valid geometries
query T
SELECT ST_IsValid('POINT(1 1)'::geometry)
----
true

query T
SELECT ST_IsValid('LINESTRING(0 0,1 1)'::geometry)
----
true

query T
SELECT ST_IsValid('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry)
----
true

query T
SELECT ST_IsValid('POLYGON((0 0,10 0,10 10,0 10,0 0),(1 1,2 1,2 2,1 2,1 1))'::geometry)
----
true

query T
SELECT ST_IsValid('MULTIPOLYGON(((0 0,1 0,1 1,0 0)),((5 5,6 5,6 6,5 5)))'::geometry)
----
true

# Invalid geometries
query T
SELECT ST_IsValid('POLYGON((0 0,2 0,0 2,2 2,0 0))'::geometry)
----
false

query T
SELECT ST_IsValid('POLYGON((0 0,10 0,10 10,0 10,0 0),(5 5,15 5,15 7,5 7,5 5))'::geometry)
----
false

query T
SELECT ST_IsValid('MULTIPOLYGON(((0 0,2 0,2 2,0 2,0 0)),((1 1,3 1,3 3,1 3,1 1)))'::geometry)
----
false

query T
SELECT ST_IsValid('LINESTRING(0 0,0 0)'::geometry)
----
false

query T
SELECT ST_IsValid('POLYGON((0 0,10 0,10 10,0 10,0 0),(20 20,21 20,21 21,20 20))'::geometry)
----
false

# A ring with zero area is invalid
query T
SELECT ST_IsValid('POLYGON((0 0,1 1,2 2,0 0))'::geometry)
----
false

query T
SELECT ST_IsValid('POLYGON((0 0,10 0,10 10,0 10,0 0),(1 1,2 2,3 3,1 1))'::geometry)
----
false

# EMPTY geometries and parts
query T
SELECT ST_IsValid('POINT EMPTY'::geometry)
----
true

query T
SELECT ST_IsValid('POLYGON EMPTY'::geometry)
----
true

query T
SELECT ST_IsValid('GEOMETRYCOLLECTION EMPTY'::geometry)
----
true

query T
SELECT ST_IsValid('MULTIPOINT(EMPTY,(1 1))'::geometry)
----
true

query T
SELECT ST_IsValid('GEOMETRYCOLLECTION(POINT EMPTY,POLYGON((0 0,1 0,1 1,0 0)))'::geometry)
----
true

query T
SELECT ST_IsValid('GEOMETRYCOLLECTION(POINT EMPTY,POLYGON((0 0,2 0,0 2,2 2,0 0)))'::geometry)
----
false

# Z and M are ignored
query T
SELECT ST_IsValid('POLYGON Z ((0 0 1,1 0 2,1 1 3,0 0 1))'::geometry)
----
true

query T
SELECT ST_IsValid('LINESTRING M (0 0 1,1 1 2)'::geometry)
----
true

# SRID and NULL
query T
SELECT ST_IsValid('SRID=4326;POLYGON((0 0,2 0,0 2,2 2,0 0))'::geometry)
----
false

query T
SELECT ST_IsValid(NULL::geometry)
----
NULL
