# Edge cases for ST_LineSubstring, not covered by the PostGIS docs examples.

# Fractions, vertices included
query T
SELECT ST_AsText(ST_LineSubstring('LINESTRING(0 0,10 0,10 10)'::geometry, 0, 1))
----
LINESTRING(0 0,10 0,10 10)

query T
SELECT ST_AsText(ST_LineSubstring('LINESTRING(0 0,10 0,10 10)'::geometry, 0.25, 0.75))
----
LINESTRING(5 0,10 0,10 5)

query T
SELECT ST_AsText(ST_LineSubstring('LINESTRING(0 0,10 0,10 10)'::geometry, 0, 0.5))
----
LINESTRING(0 0,10 0)

query T
SELECT ST_AsText(ST_LineSubstring('LINESTRING(0 0,10 0,10 10)'::geometry, 0.5, 1))
----
LINESTRING(10 0,10 10)

query T
SELECT ST_AsText(ST_LineSubstring('LINESTRING(0 0,10 0,10 10)'::geometry, 0.1, 0.2))
----
LINESTRING(2 0,4 0)

query T
SELECT ST_AsText(ST_LineSubstring('LINESTRING(0 0,10 0,10 10)'::geometry, 0.5, 0.5))
----
POINT(10 0)

query T
SELECT ST_AsText(ST_LineSubstring('LINESTRING(0 0,10 0,10 10)'::geometry, 0.3, 0.3))
----
POINT(6 0)

query T
SELECT ST_AsText(ST_LineSubstring('LINESTRING(0 0,3 1,7 -2)'::geometry, 0.13, 0.71))
----
LINESTRING(1.006644143732834 0.335548047910945,3 1,5.106351582840936 -0.579763687130702)

query T
SELECT ST_AsText(ST_LineSubstring('LINESTRING(0 0,1 0,1 0,2 0)'::geometry, 0.25, 0.75))
----
LINESTRING(0.5 0,1 0,1.5 0)

query T
SELECT ST_AsText(ST_LineSubstring('LINESTRING(0 0,0 0)'::geometry, 0.25, 0.75))
----
POINT(0 0)

# Several lines
query T
SELECT ST_AsText(ST_LineSubstring('MULTILINESTRING((0 0,10 0),(20 0,30 0))'::geometry, 0.25, 0.75))
----
MULTILINESTRING((5 0,10 0),(20 0,25 0))

query T
SELECT ST_AsText(ST_LineSubstring('MULTILINESTRING((0 0,10 0),(20 0,30 0))'::geometry, 0.1, 0.4))
----
MULTILINESTRING((2 0,8 0))

query T
SELECT ST_AsText(ST_LineSubstring('MULTILINESTRING((0 0,10 0),(20 0,30 0))'::geometry, 0.25, 0.5))
----
GEOMETRYCOLLECTION(LINESTRING(5 0,10 0),POINT(20 0))

query T
SELECT ST_AsText(ST_LineSubstring('MULTILINESTRING((0 0,10 0),(20 0,30 0))'::geometry, 0.5, 0.75))
----
GEOMETRYCOLLECTION(POINT(10 0),LINESTRING(20 0,25 0))

query T
SELECT ST_AsText(ST_LineSubstring('MULTILINESTRING((0 0,10 0),(20 0,30 0))'::geometry, 0.5, 0.5))
----
GEOMETRYCOLLECTION(POINT(10 0),POINT(20 0))

query T
SELECT ST_AsText(ST_LineSubstring('MULTILINESTRING((0 0,10 0),(20 0,30 0))'::geometry, 0, 1))
----
MULTILINESTRING((0 0,10 0),(20 0,30 0))

query T
SELECT ST_AsText(ST_LineSubstring('MULTILINESTRING((0 0,10 0),(20 0,30 0),(40 0,50 0))'::geometry, 0.4, 0.6))
----
MULTILINESTRING((22 0,28 0))

# Z, M, the SRID, EMPTY and NULL
query T
SELECT ST_AsEWKT(ST_LineSubstring('SRID=4326;LINESTRING ZM (0 0 0 0,10 0 10 20)'::geometry, 0.3, 0.6))
----
SRID=4326;LINESTRING(3 0 3 6,6 0 6 12)

query T
SELECT ST_AsText(ST_LineSubstring('LINESTRING EMPTY'::geometry, 0.1, 0.4))
----
NULL

query T
SELECT ST_LineSubstring(NULL::geometry, 0.1, 0.4)
----
NULL

query T
SELECT ST_AsText(ST_LineSubstring('LINESTRING(0 0,10 0,10 10)'::geometry, NULL, 0.4))
----
NULL

# Errors
query error
SELECT ST_LineSubstring('LINESTRING(0 0,10 0,10 10)'::geometry, 0.75, 0.25)

query error
SELECT ST_LineSubstring('LINESTRING(0 0,10 0,10 10)'::geometry, -0.1, 0.5)

query error
SELECT ST_LineSubstring('LINESTRING(0 0,10 0,10 10)'::geometry, 0, 1.1)

query error
SELECT ST_LineSubstring('POINT(0 0)'::geometry, 0.1, 0.4)
