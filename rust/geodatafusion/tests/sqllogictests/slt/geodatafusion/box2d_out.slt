# Edge cases for box2d_out and the cast of box2d to text, not covered by the PostGIS docs examples.

# Boxes and geometries
query T
SELECT box2d_out('BOX(1 2,5 6)'::box2d)
----
BOX(1 2,5 6)

query T
SELECT box2d_out('POINT(1 2)'::geometry)
----
BOX(1 2,1 2)

query T
SELECT box2d_out('LINESTRING Z (1 2 3,4 5 -6)'::geometry)
----
BOX(1 2,4 5)

query T
SELECT box2d_out('BOX3D(1 2 3,4 5 6)'::box3d)
----
BOX(1 2,4 5)

# Numbers as in WKT: 15 decimals, exponents beyond 1e15 and below 1e-8, no negative zero
query T
SELECT box2d_out('BOX(1.123456789012345 2e-20,5e20 -0.0)'::box2d)
----
BOX(1.123456789012345 0,5e+20 2e-20)

query T
SELECT box2d_out('BOX(-0.0 1e-9,1.00000000000000000001 123456789012345678)'::box2d)
----
BOX(0 1e-9,1 1.234567890123457e+17)

query T
SELECT box2d_out('BOX(0.1 0.2,1.0000001 3)'::box2d)
----
BOX(0.1 0.2,1.0000001 3)

# EMPTY and NULL
query T
SELECT box2d_out('POINT EMPTY'::geometry)
----
NULL

query T
SELECT box2d_out(NULL::box2d)
----
NULL

# Casts
query T
SELECT 'BOX(1 2,5 6)'::box2d::text
----
BOX(1 2,5 6)

query T
SELECT ST_MakeBox2D('POINT(1 2)'::geometry,'POINT(3 4)'::geometry)::varchar
----
BOX(1 2,3 4)

query T
SELECT Box2D('LINESTRING(0 0,3 4)'::geometry)::text
----
BOX(0 0,3 4)

query T
SELECT Box2D('POINT EMPTY'::geometry)::text
----
NULL

query error
SELECT 'BOX(1 2,5 6)'::box2d::bytea

query error
SELECT 'BOX(1 2,5 6)'::box2d::integer

query error
SELECT box2d_out('POINT(1 2)'::geography)
