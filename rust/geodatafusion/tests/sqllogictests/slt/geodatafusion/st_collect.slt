# Edge cases for ST_Collect, not covered by the PostGIS docs examples.

# Points, lines or polygons give a multi-geometry, anything else a collection
query T
SELECT ST_Collect('POINT(1 2)'::geometry, 'POINT(3 4)'::geometry)
----
MULTIPOINT((1 2),(3 4))

query T
SELECT ST_Collect('LINESTRING(0 0,1 1)'::geometry, 'LINESTRING(2 2,3 3)'::geometry)
----
MULTILINESTRING((0 0,1 1),(2 2,3 3))

query T
SELECT ST_Collect('POLYGON((0 0,1 0,1 1,0 0))'::geometry, 'POLYGON((0 0,1 0,1 1,0 0))'::geometry)
----
MULTIPOLYGON(((0 0,1 0,1 1,0 0)),((0 0,1 0,1 1,0 0)))

query T
SELECT ST_Collect('POINT(1 2)'::geometry, 'LINESTRING(0 0,1 1)'::geometry)
----
GEOMETRYCOLLECTION(POINT(1 2),LINESTRING(0 0,1 1))

query T
SELECT ST_Collect('MULTIPOINT((1 2))'::geometry, 'POINT(3 4)'::geometry)
----
GEOMETRYCOLLECTION(MULTIPOINT((1 2)),POINT(3 4))

query T
SELECT ST_Collect('GEOMETRYCOLLECTION(POINT(1 1))'::geometry, 'POINT(3 4)'::geometry)
----
GEOMETRYCOLLECTION(GEOMETRYCOLLECTION(POINT(1 1)),POINT(3 4))

# EMPTY members are kept
query T
SELECT ST_Collect('POINT EMPTY'::geometry, 'POINT(3 4)'::geometry)
----
MULTIPOINT(EMPTY,(3 4))

query T
SELECT ST_Collect('LINESTRING EMPTY'::geometry, 'LINESTRING(0 0,1 1)'::geometry)
----
MULTILINESTRING((),(0 0,1 1))

query T
SELECT ST_Collect('POINT EMPTY'::geometry, 'POINT EMPTY'::geometry)
----
MULTIPOINT(EMPTY,EMPTY)

query T
SELECT ST_Collect('POLYGON EMPTY'::geometry, 'POINT(1 1)'::geometry)
----
GEOMETRYCOLLECTION(POLYGON EMPTY,POINT(1 1))

# Z and M are kept
query T
SELECT ST_Collect('POINT Z (1 2 3)'::geometry, 'POINT Z (3 4 5)'::geometry)
----
MULTIPOINT Z ((1 2 3),(3 4 5))

query T
SELECT ST_Collect('POINT M (1 2 3)'::geometry, 'LINESTRING M (0 0 1,1 1 2)'::geometry)
----
GEOMETRYCOLLECTION M (POINT M (1 2 3),LINESTRING M (0 0 1,1 1 2))

query T
SELECT ST_Collect('POINT ZM (1 2 3 4)'::geometry, 'POINT ZM (5 6 7 8)'::geometry)
----
MULTIPOINT ZM ((1 2 3 4),(5 6 7 8))

# SRID
query T
SELECT ST_Collect('SRID=4326;POINT(1 2)'::geometry, 'SRID=4326;POINT(3 4)'::geometry)
----
SRID=4326;MULTIPOINT((1 2),(3 4))

# One NULL input returns the other unchanged
query T
SELECT ST_Collect('POINT(1 2)'::geometry, NULL::geometry)
----
POINT(1 2)

query T
SELECT ST_Collect(NULL::geometry, 'LINESTRING(0 0,1 1)'::geometry)
----
LINESTRING(0 0,1 1)

query T
SELECT ST_Collect(NULL::geometry, NULL::geometry)
----
NULL

# Mixed dimensions and SRIDs are errors
statement error
SELECT ST_Collect('POINT Z (1 2 3)'::geometry, 'POINT(3 4)'::geometry)

statement error
SELECT ST_Collect('POINT M (1 2 3)'::geometry, 'POINT Z (3 4 5)'::geometry)

statement error
SELECT ST_Collect('SRID=4326;POINT(1 2)'::geometry, 'SRID=3857;POINT(3 4)'::geometry)

# A column, including NULL
query T rowsort
SELECT ST_Collect(g, 'POINT(9 9)'::geometry) FROM (VALUES ('POINT(1 2)'::geometry), (NULL::geometry), ('LINESTRING(0 0,1 1)'::geometry)) AS t(g)
----
GEOMETRYCOLLECTION(LINESTRING(0 0,1 1),POINT(9 9))
MULTIPOINT((1 2),(9 9))
POINT(9 9)
