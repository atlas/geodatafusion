# Edge cases for ST_AsHEXEWKB, not covered by the PostGIS docs examples.

# Every type and dimension
query T
SELECT ST_AsHEXEWKB('POINT(1 2)'::geometry)
----
0101000000000000000000F03F0000000000000040

query T
SELECT ST_AsHEXEWKB('LINESTRING Z (0 0 1,1 1 2)'::geometry)
----
01020000800200000000000000000000000000000000000000000000000000F03F000000000000F03F000000000000F03F0000000000000040

query T
SELECT ST_AsHEXEWKB('POLYGON M ((0 0 1,1 0 1,1 1 1,0 0 1))'::geometry)
----
0103000040010000000400000000000000000000000000000000000000000000000000F03F000000000000F03F0000000000000000000000000000F03F000000000000F03F000000000000F03F000000000000F03F00000000000000000000000000000000000000000000F03F

query T
SELECT ST_AsHEXEWKB('MULTIPOINT ZM ((1 2 3 4),(5 6 7 8))'::geometry)
----
01040000C00200000001010000C0000000000000F03F00000000000000400000000000000840000000000000104001010000C0000000000000144000000000000018400000000000001C400000000000002040

query T
SELECT ST_AsHEXEWKB('GEOMETRYCOLLECTION(POINT(1 2),LINESTRING EMPTY)'::geometry)
----
0107000000020000000101000000000000000000F03F0000000000000040010200000000000000

# SRID
query T
SELECT ST_AsHEXEWKB('SRID=4326;POINT(1 2)'::geometry)
----
0101000020E6100000000000000000F03F0000000000000040

query T
SELECT ST_AsHEXEWKB('SRID=3857;MULTILINESTRING((0 0,1 1))'::geometry)
----
0105000020110F00000100000001020000000200000000000000000000000000000000000000000000000000F03F000000000000F03F

# Byte order
query T
SELECT ST_AsHEXEWKB('POINT(1 2)'::geometry, 'XDR')
----
00000000013FF00000000000004000000000000000

query T
SELECT ST_AsHEXEWKB('POINT(1 2)'::geometry, 'xdr')
----
00000000013FF00000000000004000000000000000

query T
SELECT ST_AsHEXEWKB('POINT(1 2)'::geometry, 'NDR')
----
0101000000000000000000F03F0000000000000040

query T
SELECT ST_AsHEXEWKB('POINT(1 2)'::geometry, 'xDr')
----
0101000000000000000000F03F0000000000000040

query T
SELECT ST_AsHEXEWKB('SRID=4326;POINT Z (1 2 3)'::geometry, 'XDR')
----
00A0000001000010E63FF000000000000040000000000000004008000000000000

query T
SELECT ST_AsHEXEWKB('POINT(1 2)'::geometry, NULL)
----
NULL

# EMPTY and NULL
query T
SELECT ST_AsHEXEWKB('POINT EMPTY'::geometry)
----
0101000000000000000000F87F000000000000F87F

query T
SELECT ST_AsHEXEWKB('POLYGON Z EMPTY'::geometry)
----
010300008000000000

query T
SELECT ST_AsHEXEWKB(NULL::geometry)
----
NULL

# A column, including NULL
query T rowsort
SELECT ST_AsHEXEWKB(g) FROM (VALUES ('SRID=4326;POINT(1 2)'::geometry), (ST_SetSRID(NULL::geometry, 4326)), ('SRID=4326;POINT EMPTY'::geometry)) AS t(g)
----
0101000020E6100000000000000000F03F0000000000000040
0101000020E6100000000000000000F87F000000000000F87F
NULL
