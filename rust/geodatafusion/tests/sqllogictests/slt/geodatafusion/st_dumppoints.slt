# Edge cases for ST_DumpPoints, not covered by the PostGIS docs examples. The table function form takes
# a constant, and DataFusion only finds it by its lowercase name.

# Points, lines and polygons
query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dumppoints('POINT(1 1)'::geometry)
----
{1} POINT(1 1)

query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dumppoints('LINESTRING(0 0, 1 1, 2 2)'::geometry)
----
{1} POINT(0 0)
{2} POINT(1 1)
{3} POINT(2 2)

query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dumppoints('POLYGON((0 0, 1 0, 1 1, 0 0), (0.2 0.1, 0.3 0.1, 0.3 0.2, 0.2 0.1))'::geometry)
----
{1,1} POINT(0 0)
{1,2} POINT(1 0)
{1,3} POINT(1 1)
{1,4} POINT(0 0)
{2,1} POINT(0.2 0.1)
{2,2} POINT(0.3 0.1)
{2,3} POINT(0.3 0.2)
{2,4} POINT(0.2 0.1)

# MULTI geometries and collections
query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dumppoints('MULTIPOINT(0 0, 1 1)'::geometry)
----
{1,1} POINT(0 0)
{2,1} POINT(1 1)

query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dumppoints('MULTILINESTRING((0 0, 1 1), (2 2, 3 3))'::geometry)
----
{1,1} POINT(0 0)
{1,2} POINT(1 1)
{2,1} POINT(2 2)
{2,2} POINT(3 3)

query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dumppoints('MULTIPOLYGON(((0 0, 1 0, 1 1, 0 0)), ((5 5, 6 5, 6 6, 5 5)))'::geometry)
----
{1,1,1} POINT(0 0)
{1,1,2} POINT(1 0)
{1,1,3} POINT(1 1)
{1,1,4} POINT(0 0)
{2,1,1} POINT(5 5)
{2,1,2} POINT(6 5)
{2,1,3} POINT(6 6)
{2,1,4} POINT(5 5)

query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dumppoints('GEOMETRYCOLLECTION(POINT(0 1), LINESTRING(0 3, 3 4), MULTIPOINT(7 7, 8 8), GEOMETRYCOLLECTION(POINT(9 9)))'::geometry)
----
{1,1} POINT(0 1)
{2,1} POINT(0 3)
{2,2} POINT(3 4)
{3,1,1} POINT(7 7)
{3,2,1} POINT(8 8)
{4,1,1} POINT(9 9)

# Empty geometries and parts have no points, but count in paths
query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dumppoints('POINT EMPTY'::geometry)
----

query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dumppoints('LINESTRING EMPTY'::geometry)
----

query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dumppoints('MULTIPOINT(0 0, EMPTY, 1 1)'::geometry)
----
{1,1} POINT(0 0)
{3,1} POINT(1 1)

query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dumppoints('GEOMETRYCOLLECTION(POINT EMPTY, POINT(1 1))'::geometry)
----
{2,1} POINT(1 1)

# Z, M and the SRID are kept
query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dumppoints('SRID=3857;LINESTRING ZM (0 0 1 2, 1 1 3 4)'::geometry)
----
{1} SRID=3857;POINT(0 0 1 2)
{2} SRID=3857;POINT(1 1 3 4)

query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dumppoints('SRID=4326;POLYGON M ((0 0 1, 1 0 2, 1 1 3, 0 0 4))'::geometry)
----
{1,1} SRID=4326;POINTM(0 0 1)
{1,2} SRID=4326;POINTM(1 0 2)
{1,3} SRID=4326;POINTM(1 1 3)
{1,4} SRID=4326;POINTM(0 0 4)

# NULL gives no rows
query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dumppoints(NULL::geometry)
----

# The result's columns can be used like any table's
query I
SELECT count(*) FROM st_dumppoints('MULTIPOLYGON(((0 0, 1 0, 1 1, 0 0)), ((5 5, 6 5, 6 6, 5 5), (5.2 5.1, 5.8 5.1, 5.8 5.7, 5.2 5.1)))'::geometry) AS d WHERE d.path[1] = 2
----
8
