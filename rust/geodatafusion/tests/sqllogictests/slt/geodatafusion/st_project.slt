# Edge cases for ST_Project on geometry, not covered by the PostGIS docs examples.

# By distance and azimuth
query T
SELECT ST_AsEWKT(ST_Project('SRID=3857;POINT(1 2)'::geometry, 10, pi()/2))
----
SRID=3857;POINT(11 1.999999999999998)

query T
SELECT ST_AsText(ST_Project('POINT(0 0)'::geometry, 1, pi()/4))
----
POINT(0.707106781186548 0.707106781186548)

query T
SELECT ST_AsText(ST_Project('POINT(0 0)'::geometry, 1, 0))
----
POINT(6.123233995736766e-17 1)

query T
SELECT ST_AsText(ST_Project('POINT(0 0)'::geometry, 1, pi()))
----
POINT(-1.83697019872103e-16 -1)

query T
SELECT ST_AsText(ST_Project('POINT(0 0)'::geometry, 1, 3*pi()/2))
----
POINT(-1 1.224646799147353e-16)

query T
SELECT ST_AsText(ST_Project('POINT(0 0)'::geometry, -1, 0))
----
POINT(-6.123233995736766e-17 -1)

query T
SELECT ST_AsText(ST_Project('POINT(0 0)'::geometry, 1, 10))
----
POINT(-0.54402111088937 -0.839071529076452)

query T
SELECT ST_AsText(ST_Project('POINT(0 0)'::geometry, 1, -1))
----
POINT(-0.841470984807896 0.54030230586814)

query T
SELECT ST_AsText(ST_Project('POINT(5 5)'::geometry, 0, 1))
----
POINT(5 5)

# Z and M are kept
query T
SELECT ST_AsEWKT(ST_Project('POINT Z (0 0 5)'::geometry, 1, 0))
----
POINT(6.123233995736766e-17 1 5)

query T
SELECT ST_AsEWKT(ST_Project('POINT ZM (0 0 5 6)'::geometry, 2, pi()/2))
----
POINT(2 -4.898587196589413e-16 5 6)

# Through a second point
query T
SELECT ST_AsText(ST_Project('POINT(0 0)'::geometry, 'POINT(3 4)'::geometry, 10))
----
POINT(9 12)

query T
SELECT ST_AsText(ST_Project('POINT(1 1)'::geometry, 'POINT(1 3)'::geometry, -1))
----
POINT(1 2)

query T
SELECT ST_AsText(ST_Project('POINT(0 0)'::geometry, 'POINT(0 0)'::geometry, 10))
----
POINT(0 0)

query T
SELECT ST_AsEWKT(ST_Project('POINT Z (0 0 1)'::geometry, 'POINT Z (3 4 9)'::geometry, 10))
----
POINT(9 12 25)

query T
SELECT ST_AsEWKT(ST_Project('POINT M (0 0 1)'::geometry, 'POINT M (3 4 9)'::geometry, 10))
----
POINTM(9 12 25)

query T
SELECT ST_AsEWKT(ST_Project('POINT ZM (0 0 1 2)'::geometry, 'POINT(3 4)'::geometry, 10))
----
POINT(9 12 -2 -4)

query T
SELECT ST_AsEWKT(ST_Project('POINT(0 0)'::geometry, 'POINT Z (3 4 5)'::geometry, 10))
----
POINT(9 12)

query T
SELECT ST_AsEWKT(ST_Project('SRID=4326;POINT(0 0)'::geometry, 'SRID=3857;POINT(1 1)'::geometry, 1))
----
SRID=4326;POINT(1.707106781186548 1.707106781186548)

# EMPTY and NULL
query T
SELECT ST_AsText(ST_Project('POINT EMPTY'::geometry, 1, 0))
----
NULL

query T
SELECT ST_AsText(ST_Project('POINT(0 0)'::geometry, 'POINT EMPTY'::geometry, 1))
----
NULL

query T
SELECT ST_Project(NULL::geometry, 1, 0)
----
NULL

query T
SELECT ST_AsText(ST_Project('POINT(0 0)'::geometry, NULL::float8, 0))
----
NULL

query T
SELECT ST_AsText(ST_Project('POINT(0 0)'::geometry, 1, NULL))
----
NULL

query T
SELECT ST_AsText(ST_Project('POINT(0 0)'::geometry, NULL::geometry, 1))
----
NULL

# Only points
query error
SELECT ST_Project('LINESTRING(0 0,1 1)'::geometry, 1, 0)

query error
SELECT ST_Project('POINT(0 0)'::geometry, 'LINESTRING(0 0,1 1)'::geometry, 1)

# Columns
query IT rowsort
SELECT d, ST_AsText(ST_Project(g, d, 0)) FROM (VALUES ('POINT(1 1)'::geometry, 1), ('POINT(2 2)'::geometry, 2), (NULL::geometry, 1), ('POINT(1 1)'::geometry, NULL)) AS t(g, d)
----
1 NULL
1 POINT(1 2)
2 POINT(2 4)
NULL NULL
