# Edge cases for ST_UnaryUnion, not covered by the PostGIS docs examples.

# Dissolving overlaps
query T
SELECT ST_UnaryUnion('MULTIPOLYGON(((0 0,2 0,2 2,0 2,0 0)),((1 1,3 1,3 3,1 3,1 1)))'::geometry)
----
POLYGON((2 0,0 0,0 2,1 2,1 3,3 3,3 1,2 1,2 0))

query T
SELECT ST_UnaryUnion('GEOMETRYCOLLECTION(POINT(1 1),LINESTRING(0 0,2 2),POLYGON((0 0,3 0,3 3,0 0)))'::geometry)
----
POLYGON((2 2,3 3,3 0,0 0,2 2))

query T
SELECT ST_UnaryUnion('MULTILINESTRING((0 0,2 2),(0 2,2 0))'::geometry)
----
MULTILINESTRING((0 0,1 1),(1 1,2 2),(0 2,1 1),(1 1,2 0))

query T
SELECT ST_UnaryUnion('MULTIPOINT((1 1),(1 1),(2 2))'::geometry)
----
MULTIPOINT((1 1),(2 2))

query T
SELECT ST_UnaryUnion('POINT(1 2)'::geometry)
----
POINT(1 2)

# gridSize
query T
SELECT ST_UnaryUnion('MULTIPOINT((1 1),(1.2 1.2))'::geometry, 0.5)
----
POINT(1 1)

query T
SELECT ST_UnaryUnion('MULTIPOINT((1 1),(2 2))'::geometry, NULL)
----
NULL

# Z kept, M dropped
query T
SELECT ST_UnaryUnion('MULTILINESTRING Z ((0 0 1,2 2 2),(0 2 3,2 0 4))'::geometry)
----
MULTILINESTRING Z ((0 0 1,1 1 2.5),(1 1 2.5,2 2 2),(0 2 3,1 1 2.5),(1 1 2.5,2 0 4))

query T
SELECT ST_UnaryUnion('MULTIPOINT M ((1 1 5),(2 2 6))'::geometry)
----
MULTIPOINT((1 1),(2 2))

# SRID
query T
SELECT ST_UnaryUnion('SRID=4326;MULTIPOINT((1 1),(1 1))'::geometry)
----
SRID=4326;POINT(1 1)

# EMPTY and NULL
query T
SELECT ST_UnaryUnion('POINT M EMPTY'::geometry)
----
POINT M EMPTY

query T
SELECT ST_UnaryUnion('MULTIPOLYGON EMPTY'::geometry)
----
MULTIPOLYGON EMPTY

query T
SELECT ST_UnaryUnion(NULL::geometry)
----
NULL

# A column, including NULL
query T rowsort
SELECT ST_UnaryUnion(g) FROM (VALUES ('MULTIPOINT((1 1),(1 1))'::geometry), (NULL::geometry), ('POINT(3 3)'::geometry)) AS t(g)
----
NULL
POINT(1 1)
POINT(3 3)
