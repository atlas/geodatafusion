# Edge cases for ST_GeomFromText, not covered by the PostGIS docs examples.

# Every geometry type
query T
SELECT ST_GeomFromText('POINT(1 2)')
----
POINT(1 2)

query T
SELECT ST_GeomFromText('LINESTRING(0 0,1 1)')
----
LINESTRING(0 0,1 1)

query T
SELECT ST_GeomFromText('POLYGON((0 0,4 0,4 4,0 0),(1 1,2 1,2 2,1 1))')
----
POLYGON((0 0,4 0,4 4,0 0),(1 1,2 1,2 2,1 1))

query T
SELECT ST_GeomFromText('MULTIPOINT((1 2),(3 4))')
----
MULTIPOINT((1 2),(3 4))

query T
SELECT ST_GeomFromText('MULTILINESTRING((0 0,1 1),(2 2,3 3))')
----
MULTILINESTRING((0 0,1 1),(2 2,3 3))

query T
SELECT ST_GeomFromText('MULTIPOLYGON(((0 0,1 0,1 1,0 0)),((2 2,3 2,3 3,2 2)))')
----
MULTIPOLYGON(((0 0,1 0,1 1,0 0)),((2 2,3 2,3 3,2 2)))

query T
SELECT ST_GeomFromText('GEOMETRYCOLLECTION(POINT(1 2),LINESTRING(0 0,1 1))')
----
GEOMETRYCOLLECTION(POINT(1 2),LINESTRING(0 0,1 1))

# Dimensions, explicit and implicit
query T
SELECT ST_GeomFromText('POINT Z (1 2 3)')
----
POINT Z (1 2 3)

query T
SELECT ST_GeomFromText('POINTZ(1 2 3)')
----
POINT Z (1 2 3)

query T
SELECT ST_GeomFromText('POINT M (1 2 3)')
----
POINT M (1 2 3)

query T
SELECT ST_GeomFromText('POINTM(1 2 3)')
----
POINT M (1 2 3)

query T
SELECT ST_GeomFromText('POINT ZM (1 2 3 4)')
----
POINT ZM (1 2 3 4)

query T
SELECT ST_GeomFromText('POINT(1 2 3)')
----
POINT Z (1 2 3)

query T
SELECT ST_GeomFromText('POINT(1 2 3 4)')
----
POINT ZM (1 2 3 4)

query T
SELECT ST_GeomFromText('LINESTRING(0 0 1,1 1 2)')
----
LINESTRING Z (0 0 1,1 1 2)

query T
SELECT ST_GeomFromText('MULTIPOINT M ((1 2 3))')
----
MULTIPOINT M ((1 2 3))

query T
SELECT ST_GeomFromText('GEOMETRYCOLLECTION(POINT(1 2 3))')
----
GEOMETRYCOLLECTION Z (POINT Z (1 2 3))

# Case and whitespace
query T
SELECT ST_GeomFromText('point(1 2)')
----
POINT(1 2)

query T
SELECT ST_GeomFromText('  POINT ( 1   2 )  ')
----
POINT(1 2)

query T
SELECT ST_GeomFromText('LineString(0 0 , 1 1)')
----
LINESTRING(0 0,1 1)

query T
SELECT ST_GeomFromText('POINT' || chr(10) || '(1 2)')
----
POINT(1 2)

# Multipoint forms
query T
SELECT ST_GeomFromText('MULTIPOINT(1 2,3 4)')
----
MULTIPOINT((1 2),(3 4))

query T
SELECT ST_GeomFromText('MULTIPOINT((1 2),EMPTY)')
----
MULTIPOINT((1 2),EMPTY)

query T
SELECT ST_GeomFromText('MULTIPOINT(1 2,(3 4))')
----
MULTIPOINT((1 2),(3 4))

# EMPTY
query T
SELECT ST_GeomFromText('POINT EMPTY')
----
POINT EMPTY

query T
SELECT ST_GeomFromText('POINT Z EMPTY')
----
POINT Z EMPTY

query T
SELECT ST_GeomFromText('LINESTRING EMPTY')
----
LINESTRING EMPTY

query T
SELECT ST_GeomFromText('POLYGON EMPTY')
----
POLYGON EMPTY

query T
SELECT ST_GeomFromText('MULTIPOLYGON EMPTY')
----
MULTIPOLYGON EMPTY

query T
SELECT ST_GeomFromText('GEOMETRYCOLLECTION EMPTY')
----
GEOMETRYCOLLECTION EMPTY

query T
SELECT ST_GeomFromText('GEOMETRYCOLLECTION(POINT EMPTY)')
----
GEOMETRYCOLLECTION(POINT EMPTY)

query T
SELECT ST_GeomFromText('MULTILINESTRING((0 0,1 1),EMPTY)')
----
MULTILINESTRING((0 0,1 1),())

query error
SELECT ST_GeomFromText('POLYGON((0 0,1 0,1 1,0 0),EMPTY)')

# Numbers
query T
SELECT ST_GeomFromText('POINT(1e2 -3.5E-1)')
----
POINT(100 -0.35)

query error
SELECT ST_GeomFromText('POINT(.5 +1)')

query T
SELECT ST_GeomFromText('POINT(-0 1.)')
----
POINT(0 1)

query T
SELECT ST_GeomFromText('POINT(1.5e+2 2)')
----
POINT(150 2)

# Invalid input is an error
statement error
SELECT ST_GeomFromText('LINESTRING(1 2)')

statement error
SELECT ST_GeomFromText('POLYGON((0 0,1 0,1 1,0 1))')

statement error
SELECT ST_GeomFromText('POLYGON((0 0,1 1,0 0))')

statement error
SELECT ST_GeomFromText('POINT(1 2,3 4)')

statement error
SELECT ST_GeomFromText('POINT(1)')

statement error
SELECT ST_GeomFromText('LINESTRING(0 0,1 1 1)')

statement error
SELECT ST_GeomFromText('POINT(1 2) garbage')

statement error
SELECT ST_GeomFromText('POINT(1 2')

statement error
SELECT ST_GeomFromText('POINT()')

statement error
SELECT ST_GeomFromText('FOO(1 2)')

statement error
SELECT ST_GeomFromText('POINT(a b)')

statement error
SELECT ST_GeomFromText('')

statement error
SELECT ST_GeomFromText('MULTIPOINT((1 2),(3 4 5))')

statement error
SELECT ST_GeomFromText('GEOMETRYCOLLECTION(POINT(1 2),POINT(1 2 3))')

# SRIDs
query T
SELECT ST_GeomFromText('POINT(1 2)', 4326)
----
SRID=4326;POINT(1 2)

query I
SELECT ST_SRID(ST_GeomFromText('POINT(1 2)', 3857))
----
3857

query T
SELECT ST_GeomFromText('SRID=4326;POINT(1 2)')
----
SRID=4326;POINT(1 2)

query T
SELECT ST_GeomFromText('POINT(1 2)', NULL)
----
NULL

# NULL
query T
SELECT ST_GeomFromText(NULL)
----
NULL

# A column of text, including NULL
query T rowsort
SELECT ST_GeomFromText(t) FROM (VALUES ('POINT(1 2)'), (NULL), ('LINESTRING(0 0,1 1)'), ('POINT EMPTY')) AS v(t)
----
LINESTRING(0 0,1 1)
NULL
POINT EMPTY
POINT(1 2)

# Per-row SRIDs in a column must match the column's
statement error
SELECT ST_GeomFromText(t) FROM (VALUES ('POINT(1 2)'), ('SRID=4326;POINT(1 2)')) AS v(t)

# The srid argument overrides an embedded SRID
query I
SELECT ST_SRID(ST_GeomFromText('SRID=4326;POINT(1 2)', 3857))
----
3857

# Nested collections
query T
SELECT ST_AsText(ST_GeomFromText('GEOMETRYCOLLECTION(GEOMETRYCOLLECTION(POINT(1 2)),POINT(3 4))'))
----
GEOMETRYCOLLECTION(GEOMETRYCOLLECTION(POINT(1 2)),POINT(3 4))

query T
SELECT ST_AsEWKT(ST_GeomFromEWKT('SRID=4326;GEOMETRYCOLLECTION Z (GEOMETRYCOLLECTION Z (POINT Z (1 2 3)),GEOMETRYCOLLECTION Z EMPTY)'))
----
SRID=4326;GEOMETRYCOLLECTION(GEOMETRYCOLLECTION(POINT(1 2 3)),GEOMETRYCOLLECTION EMPTY)

query T
SELECT ST_AsText(ST_GeomFromText('GEOMETRYCOLLECTION(GEOMETRYCOLLECTION(GEOMETRYCOLLECTION EMPTY))'))
----
GEOMETRYCOLLECTION(GEOMETRYCOLLECTION(GEOMETRYCOLLECTION EMPTY))

query error
SELECT ST_GeomFromText('GEOMETRYCOLLECTION(GEOMETRYCOLLECTION(POINT(1 2)),POINT Z (3 4 5))')
