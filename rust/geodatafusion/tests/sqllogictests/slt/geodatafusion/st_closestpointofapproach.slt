# Edge cases for ST_ClosestPointOfApproach, not covered by the PostGIS docs examples.

# Crossing tracks meet
query R
SELECT ST_ClosestPointOfApproach('LINESTRING M (0 0 0, 10 0 10)'::geometry, 'LINESTRING M (0 5 0, 10 -5 10)'::geometry)
----
5

query R
SELECT ST_ClosestPointOfApproach('LINESTRING M (0 0 0, 10 0 10)'::geometry, 'LINESTRING M (10 0 0, 0 0 10)'::geometry)
----
5

# Several segments
query R
SELECT ST_ClosestPointOfApproach('LINESTRING M (0 0 0, 2 0 2, 4 1 4, 9 9 10)'::geometry, 'LINESTRING M (5 5 1, 3 2 3, 1 1 5, 0 7 9)'::geometry)
----
3.3

query R
SELECT ST_ClosestPointOfApproach('LINESTRING M (0 0 0, 10 0 10, 10 10 20)'::geometry, 'LINESTRING M (20 0 5, 12 3 15, 5 5 25)'::geometry)
----
15

# Only the shared M range counts; ties go to the earliest time
query R
SELECT ST_ClosestPointOfApproach('LINESTRING M (0 0 0, 10 0 10)'::geometry, 'LINESTRING M (0 3 0, 10 3 10)'::geometry)
----
0

query R
SELECT ST_ClosestPointOfApproach('LINESTRING M (0 0 0, 10 0 10)'::geometry, 'LINESTRING M (0 3 5, 10 3 10)'::geometry)
----
10

query R
SELECT ST_ClosestPointOfApproach('LINESTRING M (0 0 0, 10 0 10)'::geometry, 'LINESTRING M (0 5 10, 10 -5 30)'::geometry)
----
10

# Ranges that don't overlap
query R
SELECT ST_ClosestPointOfApproach('LINESTRING M (0 0 0, 10 0 10)'::geometry, 'LINESTRING M (0 5 20, 10 -5 30)'::geometry)
----
NULL

# 3D if either track has Z
query R
SELECT ST_ClosestPointOfApproach('LINESTRING ZM (0 0 0 0, 10 0 0 10)'::geometry, 'LINESTRING ZM (0 5 3 0, 10 -5 3 10)'::geometry)
----
5

query R
SELECT ST_ClosestPointOfApproach('LINESTRING ZM (0 0 4 0, 10 0 4 10)'::geometry, 'LINESTRING M (0 5 0, 10 -5 10)'::geometry)
----
5

query R
SELECT ST_ClosestPointOfApproach('LINESTRING M (0 5 0, 10 -5 10)'::geometry, 'LINESTRING ZM (0 0 4 0, 10 0 4 10)'::geometry)
----
5

# Tracks must be linestrings with M and at least two points
query error
SELECT ST_ClosestPointOfApproach('LINESTRING(0 0, 10 0)'::geometry, 'LINESTRING M (0 0 0, 10 0 10)'::geometry)

query error
SELECT ST_ClosestPointOfApproach('POINT M (0 0 0)'::geometry, 'LINESTRING M (0 0 0, 10 0 10)'::geometry)

query error
SELECT ST_ClosestPointOfApproach('LINESTRING M EMPTY'::geometry, 'LINESTRING M (0 0 0, 10 0 10)'::geometry)

query error
SELECT ST_ClosestPointOfApproach('LINESTRING M (0 0 0, 10 0 10)'::geometry, 'POLYGON M ((0 0 0, 1 0 1, 1 1 2, 0 0 0))'::geometry)

# NULL
query R
SELECT ST_ClosestPointOfApproach(NULL::geometry, 'LINESTRING M (0 0 0, 10 0 10)'::geometry)
----
NULL
