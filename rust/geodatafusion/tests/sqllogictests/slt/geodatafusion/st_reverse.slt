# Edge cases for ST_Reverse, not covered by the PostGIS docs examples.

# Lines and rings are reversed
query T
SELECT ST_AsText(ST_Reverse('LINESTRING(0 0,1 1,2 0)'::geometry))
----
LINESTRING(2 0,1 1,0 0)

query T
SELECT ST_AsText(ST_Reverse('POLYGON((0 0,4 0,4 4,0 0),(1 1,2 1,2 2,1 1))'::geometry))
----
POLYGON((0 0,4 4,4 0,0 0),(1 1,2 2,2 1,1 1))

query T
SELECT ST_AsText(ST_Reverse('MULTILINESTRING((0 0,1 1),(2 2,3 3))'::geometry))
----
MULTILINESTRING((1 1,0 0),(3 3,2 2))

query T
SELECT ST_AsText(ST_Reverse('MULTIPOLYGON(((0 0,4 0,4 4,0 0)),((5 5,6 5,6 6,5 5)))'::geometry))
----
MULTIPOLYGON(((0 0,4 4,4 0,0 0)),((5 5,6 6,6 5,5 5)))

query T
SELECT ST_AsText(ST_Reverse('GEOMETRYCOLLECTION(POINT(1 1),LINESTRING(0 0,1 1),MULTIPOINT((1 2),(3 4)))'::geometry))
----
GEOMETRYCOLLECTION(POINT(1 1),LINESTRING(1 1,0 0),MULTIPOINT((1 2),(3 4)))

# Points and member order are unchanged
query T
SELECT ST_AsText(ST_Reverse('POINT(1 2)'::geometry))
----
POINT(1 2)

query T
SELECT ST_AsText(ST_Reverse('MULTIPOINT((1 1),(2 2))'::geometry))
----
MULTIPOINT((1 1),(2 2))

# Z, M and the SRID are kept
query T
SELECT ST_AsEWKT(ST_Reverse('SRID=4326;LINESTRING ZM (0 0 1 2,1 1 3 4)'::geometry))
----
SRID=4326;LINESTRING(1 1 3 4,0 0 1 2)

query T
SELECT ST_AsEWKT(ST_Reverse('POLYGON M ((0 0 1,4 0 2,4 4 3,0 0 1))'::geometry))
----
POLYGONM((0 0 1,4 4 3,4 0 2,0 0 1))

# EMPTY and NULL
query T
SELECT ST_AsText(ST_Reverse('LINESTRING EMPTY'::geometry))
----
LINESTRING EMPTY

query T
SELECT ST_AsText(ST_Reverse('POLYGON EMPTY'::geometry))
----
POLYGON EMPTY

query T
SELECT ST_AsText(ST_Reverse('GEOMETRYCOLLECTION EMPTY'::geometry))
----
GEOMETRYCOLLECTION EMPTY

query T
SELECT ST_Reverse(NULL::geometry)
----
NULL

# A column, including NULL
query T rowsort
SELECT ST_AsText(ST_Reverse(g)) FROM (VALUES ('LINESTRING(0 0,1 1)'::geometry), (NULL::geometry), ('POINT(1 2)'::geometry)) AS t(g)
----
LINESTRING(1 1,0 0)
NULL
POINT(1 2)
