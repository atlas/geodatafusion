# Edge cases for ST_VoronoiPolygons, not covered by the PostGIS docs examples.

query T
SELECT ST_VoronoiPolygons('MULTIPOINT((0 0),(10 0),(5 8),(5 3))'::geometry)
----
GEOMETRYCOLLECTION(POLYGON((-10 -10,-10 11.8125,0.1 5.5,5 -2.66666666667,5 -10,-10 -10)),POLYGON((-10 18,20 18,20 11.8125,9.9 5.5,0.1 5.5,-10 11.8125,-10 18)),POLYGON((5 -2.66666666667,0.1 5.5,9.9 5.5,5 -2.66666666667)),POLYGON((20 -10,5 -10,5 -2.66666666667,9.9 5.5,20 11.8125,20 -10)))

query T
SELECT ST_VoronoiPolygons('MULTIPOINT((0 0),(10 0),(5 8),(5 3))'::geometry, 0)
----
GEOMETRYCOLLECTION(POLYGON((-10 -10,-10 11.8125,0.1 5.5,5 -2.66666666667,5 -10,-10 -10)),POLYGON((-10 18,20 18,20 11.8125,9.9 5.5,0.1 5.5,-10 11.8125,-10 18)),POLYGON((5 -2.66666666667,0.1 5.5,9.9 5.5,5 -2.66666666667)),POLYGON((20 -10,5 -10,5 -2.66666666667,9.9 5.5,20 11.8125,20 -10)))

query error
SELECT ST_VoronoiPolygons('MULTIPOINT((0 0),(10 0),(5 8),(5 3))'::geometry, 3)

query T
SELECT ST_VoronoiPolygons('MULTIPOINT((0 0),(10 0),(5 8),(5 3))'::geometry, 0, 'POLYGON((-50 -50,50 -50,50 50,-50 50,-50 -50))'::geometry)
----
GEOMETRYCOLLECTION(POLYGON((-50 -50,-50 36.8125,0.1 5.5,5 -2.66666666667,5 -50,-50 -50)),POLYGON((-50 50,50 50,50 30.5625,9.9 5.5,0.1 5.5,-50 36.8125,-50 50)),POLYGON((5 -2.66666666667,0.1 5.5,9.9 5.5,5 -2.66666666667)),POLYGON((50 -50,5 -50,5 -2.66666666667,9.9 5.5,50 30.5625,50 -50)))

query T
SELECT ST_VoronoiPolygons('MULTIPOINT((0 0),(10 0),(5 8),(5 3))'::geometry, 0, NULL::geometry)
----
GEOMETRYCOLLECTION(POLYGON((-10 -10,-10 11.8125,0.1 5.5,5 -2.66666666667,5 -10,-10 -10)),POLYGON((-10 18,20 18,20 11.8125,9.9 5.5,0.1 5.5,-10 11.8125,-10 18)),POLYGON((5 -2.66666666667,0.1 5.5,9.9 5.5,5 -2.66666666667)),POLYGON((20 -10,5 -10,5 -2.66666666667,9.9 5.5,20 11.8125,20 -10)))

query T
SELECT ST_VoronoiPolygons('MULTIPOINT Z ((0 0 1),(10 0 2),(5 8 3))'::geometry)
----
GEOMETRYCOLLECTION(POLYGON((-10 -10,-10 11.8125,5 2.4375,5 -10,-10 -10)),POLYGON((-10 18,20 18,20 11.8125,5 2.4375,-10 11.8125,-10 18)),POLYGON((20 -10,5 -10,5 2.4375,20 11.8125,20 -10)))

query T
SELECT ST_VoronoiPolygons('POINT(1 1)'::geometry)
----
GEOMETRYCOLLECTION EMPTY

query T
SELECT ST_VoronoiPolygons('MULTIPOINT((1 1),(1 1))'::geometry)
----
GEOMETRYCOLLECTION EMPTY

query T
SELECT ST_VoronoiPolygons('MULTIPOINT EMPTY'::geometry)
----
GEOMETRYCOLLECTION EMPTY

query T
SELECT ST_VoronoiPolygons('SRID=3857;MULTIPOINT((0 0),(10 0),(5 8))'::geometry)
----
SRID=3857;GEOMETRYCOLLECTION(POLYGON((-10 -10,-10 11.8125,5 2.4375,5 -10,-10 -10)),POLYGON((-10 18,20 18,20 11.8125,5 2.4375,-10 11.8125,-10 18)),POLYGON((20 -10,5 -10,5 2.4375,20 11.8125,20 -10)))

query T
SELECT ST_VoronoiPolygons(NULL::geometry)
----
NULL

# A NULL or negative tolerance is an error
statement error
SELECT ST_VoronoiPolygons('MULTIPOINT((0 0),(10 0),(5 8),(5 3))'::geometry, NULL)

statement error
SELECT ST_VoronoiPolygons('MULTIPOINT((0 0),(10 0),(5 8),(5 3))'::geometry, -1)
