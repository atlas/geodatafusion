# Edge cases for ST_Centroid, not covered by the PostGIS docs examples.

# Every type
query T
SELECT ST_Centroid('POINT(1 2)'::geometry)
----
POINT(1 2)

query T
SELECT ST_Centroid('MULTIPOINT((2 7),(4 2))'::geometry)
----
POINT(3 4.5)

query T
SELECT ST_Centroid('MULTIPOINT((0 0),(10 0),(5 8),(5 3))'::geometry)
----
POINT(5 2.75)

query T
SELECT ST_Centroid('LINESTRING(3 7,10 20,5 10)'::geometry)
----
POINT(6.93092193755 14.1463829063)

query T
SELECT ST_Centroid('POLYGON((0 0,10 0,10 10,0 10,0 0),(2 2,4 2,4 4,2 4,2 2))'::geometry)
----
POINT(5.08333333333 5.08333333333)

query T
SELECT ST_Centroid('MULTIPOLYGON(((0 0,1 0,1 1,0 0)),((5 5,6 5,6 6,5 5)))'::geometry)
----
POINT(3.16666666667 2.83333333333)

query T
SELECT ST_Centroid('GEOMETRYCOLLECTION(POINT(1 1),LINESTRING(2 2,5 2))'::geometry)
----
POINT(3.5 2)

query T
SELECT ST_Centroid('LINESTRING(0 0,1 1,2 2)'::geometry)
----
POINT(1 1)

# Z and M
query T
SELECT ST_Centroid('MULTIPOINT Z ((0 0 1),(10 0 2),(5 8 3))'::geometry)
----
POINT(5 2.66666666667)

query T
SELECT ST_Centroid('MULTIPOINT M ((0 0 1),(10 0 2),(5 8 3))'::geometry)
----
POINT(5 2.66666666667)

query T
SELECT ST_Centroid('LINESTRING ZM (0 0 1 5,10 0 2 6)'::geometry)
----
POINT(5 0)

# SRID
query T
SELECT ST_Centroid('SRID=4326;MULTIPOINT((0 0),(10 0),(5 8))'::geometry)
----
SRID=4326;POINT(5 2.66666666667)

# EMPTY and NULL
query T
SELECT ST_Centroid('POINT EMPTY'::geometry)
----
POINT EMPTY

query T
SELECT ST_Centroid('POLYGON M EMPTY'::geometry)
----
POINT M EMPTY

query T
SELECT ST_Centroid('GEOMETRYCOLLECTION EMPTY'::geometry)
----
POINT EMPTY

query T
SELECT ST_Centroid('MULTIPOINT(EMPTY,(1 1))'::geometry)
----
POINT(1 1)

query T
SELECT ST_Centroid(NULL::geometry)
----
NULL

# A column, including NULL
query T rowsort
SELECT ST_Centroid(g) FROM (VALUES ('MULTIPOINT((0 0),(10 0),(5 8))'::geometry), (NULL::geometry), ('POINT(1 2)'::geometry)) AS t(g)
----
NULL
POINT(1 2)
POINT(5 2.66666666667)
