# Edge cases for ST_SimplifyVW, not covered by the PostGIS docs examples.

# Vertices with an area below the tolerance are removed, smallest first
query T
SELECT ST_SimplifyVW('LINESTRING(5 2,3 8,6 20,7 25,10 10)'::geometry, 30)
----
LINESTRING(5 2,7 25,10 10)

query T
SELECT ST_SimplifyVW('LINESTRING(0 0,1 1,2 0)'::geometry, 1)
----
LINESTRING(0 0,1 1,2 0)

query T
SELECT ST_SimplifyVW('LINESTRING(0 0,1 1,2 0)'::geometry, 1.000001)
----
LINESTRING(0 0,2 0)

query T
SELECT ST_SimplifyVW('LINESTRING(0 0,1 1,2 0,3 1,4 0)'::geometry, 1)
----
LINESTRING(0 0,1 1,2 0,3 1,4 0)

query T
SELECT ST_SimplifyVW('LINESTRING(0 0,1 1,2 0,3 1,4 0)'::geometry, 1.0001)
----
LINESTRING(0 0,3 1,4 0)

query T
SELECT ST_SimplifyVW('LINESTRING(0 0,3 0,1 0,2 0)'::geometry, 1)
----
LINESTRING(0 0,2 0)

# An area that grows after a removal counts as at least the area removed
query T
SELECT ST_SimplifyVW('LINESTRING(8 5,9 6,9 7,6 7,7 9,3 10,3 8,2 6,1 4,1 3,3 1,5 2,6 3,7 3,8 4,8 5)'::geometry, 1.62)
----
LINESTRING(8 5,9 7,6 7,7 9,3 10,3 8,1 4,3 1,8 4,8 5)

# A tolerance of 0 or less removes nothing
query T
SELECT ST_SimplifyVW('LINESTRING(0 0,1 0,2 0)'::geometry, 0)
----
LINESTRING(0 0,1 0,2 0)

query T
SELECT ST_SimplifyVW('LINESTRING(0 0,0 0,1 1)'::geometry, 0)
----
LINESTRING(0 0,0 0,1 1)

query T
SELECT ST_SimplifyVW('LINESTRING(0 0,1 0.01,2 0)'::geometry, -1)
----
LINESTRING(0 0,1 0.01,2 0)

# Lines keep their ends, even if they collapse
query T
SELECT ST_SimplifyVW('LINESTRING(0 0,5 0,0 0)'::geometry, 100)
----
LINESTRING(0 0,0 0)

query T
SELECT ST_SimplifyVW('LINESTRING(0 0,1 1)'::geometry, 5)
----
LINESTRING(0 0,1 1)

query T
SELECT ST_SimplifyVW('MULTILINESTRING((0 0,1 0.01,2 0),(5 5,5 5))'::geometry, 1)
----
MULTILINESTRING((0 0,2 0),(5 5,5 5))

# Shells keep four points; holes left with fewer are removed
query T
SELECT ST_SimplifyVW('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 50)
----
POLYGON((0 0,10 0,10 10,0 10,0 0))

query T
SELECT ST_SimplifyVW('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 51)
----
POLYGON((0 0,10 10,0 10,0 0))

query T
SELECT ST_SimplifyVW('POLYGON((0 0,10 0,10 10,5 11,0 10,0 0))'::geometry, 1000)
----
POLYGON((0 0,10 0,10 10,0 0))

query T
SELECT ST_SimplifyVW('POLYGON((3 2,4 8,5 7,8 5,3 2))'::geometry, 1000)
----
POLYGON((3 2,4 8,8 5,3 2))

query T
SELECT ST_SimplifyVW('POLYGON((0 0,10 0,10 10,0 10,0 0),(1 1,3 1,3 3,1 3,1 1))'::geometry, 1.9)
----
POLYGON((0 0,10 0,10 10,0 10,0 0),(1 1,3 1,3 3,1 3,1 1))

query T
SELECT ST_SimplifyVW('POLYGON((0 0,10 0,10 10,0 10,0 0),(1 1,3 1,3 3,1 3,1 1))'::geometry, 2.1)
----
POLYGON((0 0,10 0,10 10,0 10,0 0))

query T
SELECT ST_SimplifyVW('MULTIPOLYGON(((0 0,10 0,10 10,0 0)),((20 20,21 20,21 21,20 21,20 20)))'::geometry, 5)
----
MULTIPOLYGON(((0 0,10 0,10 10,0 0)),((20 20,21 21,20 21,20 20)))

# Points and EMPTY parts are kept
query T
SELECT ST_SimplifyVW('MULTIPOINT((4 2),(5 5))'::geometry, 1)
----
MULTIPOINT((4 2),(5 5))

query T
SELECT ST_SimplifyVW('LINESTRING EMPTY'::geometry, 1)
----
LINESTRING EMPTY

query T
SELECT ST_SimplifyVW('MULTILINESTRING((0 0,1 0.01,2 0),EMPTY)'::geometry, 1)
----
MULTILINESTRING((0 0,2 0),())

query T
SELECT ST_SimplifyVW('GEOMETRYCOLLECTION(POINT EMPTY,LINESTRING(0 0,1 0.01,2 0))'::geometry, 1)
----
GEOMETRYCOLLECTION(POINT EMPTY,LINESTRING(0 0,2 0))

query T
SELECT ST_SimplifyVW('GEOMETRYCOLLECTION(POLYGON((0 0,1 0,1 1,0 1,0 0)),POINT(5 5))'::geometry, 5)
----
GEOMETRYCOLLECTION(POLYGON((0 0,1 1,0 1,0 0)),POINT(5 5))

# Z, M and SRID are kept
query T
SELECT ST_SimplifyVW('LINESTRING Z (0 0 1,1 0.01 2,2 0 3)'::geometry, 1)
----
LINESTRING Z (0 0 1,2 0 3)

query T
SELECT ST_SimplifyVW('LINESTRING M (0 0 1,1 0.01 2,2 0 3)'::geometry, 1)
----
LINESTRING M (0 0 1,2 0 3)

query T
SELECT ST_SimplifyVW('SRID=4326;LINESTRING(0 0,1 0.01,2 0)'::geometry, 1)
----
SRID=4326;LINESTRING(0 0,2 0)

# NULL
query T
SELECT ST_SimplifyVW(NULL::geometry, 1)
----
NULL

query T
SELECT ST_SimplifyVW('LINESTRING(0 0,1 0.01,2 0)'::geometry, NULL)
----
NULL

# A column of tolerances, including NULL
query T rowsort
SELECT ST_SimplifyVW('LINESTRING(0 0,1 0.01,2 0)'::geometry, t) FROM (VALUES (0.001), (NULL), (1)) AS v(t)
----
LINESTRING(0 0,1 0.01,2 0)
LINESTRING(0 0,2 0)
NULL
