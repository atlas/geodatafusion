# Edge cases for ST_Polygon, not covered by the PostGIS docs examples.

# A shell and an SRID
query T
SELECT ST_AsEWKT(ST_Polygon('LINESTRING(0 0,4 0,4 4,0 0)'::geometry, 4326))
----
SRID=4326;POLYGON((0 0,4 0,4 4,0 0))

query T
SELECT ST_AsEWKT(ST_Polygon('SRID=3857;LINESTRING Z (0 0 1,1 0 2,1 1 3,0 0 1)'::geometry, 4326))
----
SRID=4326;POLYGON((0 0 1,1 0 2,1 1 3,0 0 1))

query T
SELECT ST_AsEWKT(ST_Polygon('LINESTRING M (0 0 1,1 0 2,1 1 3,0 0 5)'::geometry, 0))
----
POLYGONM((0 0 1,1 0 2,1 1 3,0 0 5))

# NULL
query T
SELECT ST_Polygon(NULL::geometry, 4326)
----
NULL

query T
SELECT ST_AsText(ST_Polygon('LINESTRING(0 0,4 0,4 4,0 0)'::geometry, NULL))
----
NULL

# Invalid rings
query error
SELECT ST_Polygon('LINESTRING(0 0,1 0,1 1)'::geometry, 4326)

query error
SELECT ST_Polygon('LINESTRING(0 0,1 0,1 1,0 1)'::geometry, 4326)

query error
SELECT ST_Polygon('POINT(1 1)'::geometry, 4326)
