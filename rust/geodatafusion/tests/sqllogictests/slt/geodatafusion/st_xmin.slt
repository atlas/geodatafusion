# Edge cases for ST_XMin, not covered by the PostGIS docs examples.

# Every type
query R
SELECT ST_XMin('POINT(1 2)'::geometry)
----
1

query R
SELECT ST_XMin('LINESTRING(0 0,3 4)'::geometry)
----
0

query R
SELECT ST_XMin('POLYGON((0 0,10 0,10 10,0 0),(1 1,2 1,2 2,1 1))'::geometry)
----
0

query R
SELECT ST_XMin('MULTIPOINT(1 2,-3 4)'::geometry)
----
-3

query R
SELECT ST_XMin('GEOMETRYCOLLECTION(POINT(5 6),LINESTRING(0 0,1 -1))'::geometry)
----
0

# Every dimension
query R
SELECT ST_XMin('LINESTRING Z (1 2 3,4 5 -6)'::geometry)
----
1

query R
SELECT ST_XMin('LINESTRING M (1 2 3,4 5 6)'::geometry)
----
1

query R
SELECT ST_XMin('LINESTRING ZM (1 2 3 4,4 5 6 7)'::geometry)
----
1

query R
SELECT ST_XMin('SRID=4326;POINT(1 2)'::geometry)
----
1

# EMPTY and NULL
query R
SELECT ST_XMin('POINT EMPTY'::geometry)
----
NULL

query R
SELECT ST_XMin('LINESTRING Z EMPTY'::geometry)
----
NULL

query R
SELECT ST_XMin('GEOMETRYCOLLECTION EMPTY'::geometry)
----
NULL

query R
SELECT ST_XMin('MULTIPOINT(EMPTY,(1 1))'::geometry)
----
1

query R
SELECT ST_XMin('GEOMETRYCOLLECTION(POINT EMPTY,POINT(3 4))'::geometry)
----
3

query R
SELECT ST_XMin(NULL::geometry)
----
NULL

# A column, including NULL
query R rowsort
SELECT ST_XMin(g) FROM (VALUES ('LINESTRING Z (1 2 3,4 5 6)'::geometry), (NULL::geometry), ('POINT EMPTY'::geometry)) AS t(g)
----
1
NULL
NULL
