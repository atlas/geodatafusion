# The bounding box operators and <->, <#>, <<->>: EMPTY, NULL, boxes, single-precision boxes, Z and M,
# SRIDs, the geography forms of && and <->, and the same operators on other types.

# Each operator on overlapping and separate boxes
query TTTT
SELECT 'LINESTRING(0 0,2 2)'::geometry && 'POINT(1 1)'::geometry, 'LINESTRING(0 0,2 2)'::geometry && 'POINT(3 3)'::geometry, 'POINT(2 2)'::geometry && 'LINESTRING(0 0,2 2)'::geometry, geometry_overlaps('POINT(1 1)'::geometry, 'POINT(1 1)'::geometry)
----
true false true true

query TTT
SELECT 'LINESTRING(0 0,2 2)'::geometry ~ 'POINT(1 1)'::geometry, 'POINT(1 1)'::geometry ~ 'LINESTRING(0 0,2 2)'::geometry, 'LINESTRING(0 0,2 2)'::geometry ~ 'LINESTRING(0 0,2 2)'::geometry
----
true false true

query TTT
SELECT 'POINT(1 1)'::geometry @ 'LINESTRING(0 0,2 2)'::geometry, 'LINESTRING(0 0,2 2)'::geometry @ 'POINT(1 1)'::geometry, geometry_within('POINT(1 1)'::geometry, 'POINT(1 1)'::geometry)
----
true false true

query TT
SELECT 'LINESTRING(0 0,1 1)'::geometry ~= 'LINESTRING(0 1,1 0)'::geometry, 'LINESTRING(0 0,1 1)'::geometry ~= 'LINESTRING(0 0,1 2)'::geometry
----
true false

query TTTT
SELECT 'POINT(0 0)'::geometry << 'POINT(1 0)'::geometry, 'POINT(1 0)'::geometry << 'POINT(1 0)'::geometry, 'LINESTRING(0 0,2 0)'::geometry &< 'LINESTRING(1 0,2 0)'::geometry, 'LINESTRING(0 0,3 0)'::geometry &< 'LINESTRING(1 0,2 0)'::geometry
----
true false true false

query TTTT
SELECT 'POINT(1 0)'::geometry >> 'POINT(0 0)'::geometry, 'POINT(1 0)'::geometry >> 'POINT(1 0)'::geometry, 'LINESTRING(1 0,3 0)'::geometry &> 'LINESTRING(1 0,2 0)'::geometry, 'LINESTRING(0 0,3 0)'::geometry &> 'LINESTRING(1 0,2 0)'::geometry
----
true false true false

query TTTT
SELECT 'POINT(0 0)'::geometry <<| 'POINT(0 1)'::geometry, 'POINT(0 1)'::geometry <<| 'POINT(0 1)'::geometry, 'LINESTRING(0 0,0 2)'::geometry &<| 'LINESTRING(0 1,0 2)'::geometry, 'LINESTRING(0 0,0 3)'::geometry &<| 'LINESTRING(0 1,0 2)'::geometry
----
true false true false

query TTTT
SELECT 'POINT(0 1)'::geometry |>> 'POINT(0 0)'::geometry, 'POINT(0 1)'::geometry |>> 'POINT(0 1)'::geometry, 'LINESTRING(0 1,0 3)'::geometry |&> 'LINESTRING(0 1,0 2)'::geometry, 'LINESTRING(0 0,0 3)'::geometry |&> 'LINESTRING(0 1,0 2)'::geometry
----
true false true false

# Collections and polygons use the box of all their parts
query TT
SELECT 'GEOMETRYCOLLECTION(POINT(0 0),POINT(4 4))'::geometry ~ 'POINT(2 2)'::geometry, 'POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 1))'::geometry && 'POINT(3 3)'::geometry
----
true true

# EMPTY: the overlap and position operators are false, the containment operators true
query TTTTT
SELECT 'POINT EMPTY'::geometry && 'POINT(1 1)'::geometry, 'POINT EMPTY'::geometry && 'POINT EMPTY'::geometry, 'POINT EMPTY'::geometry &&& 'POINT(1 1)'::geometry, 'POINT EMPTY'::geometry << 'POINT(1 1)'::geometry, 'POINT(1 1)'::geometry |&> 'LINESTRING EMPTY'::geometry
----
false false false false false

query TTTT
SELECT 'POINT EMPTY'::geometry ~ 'POINT(1 1)'::geometry, 'POINT(1 1)'::geometry ~ 'POINT EMPTY'::geometry, 'POINT EMPTY'::geometry @ 'POINT(1 1)'::geometry, 'POINT(1 1)'::geometry @ 'GEOMETRYCOLLECTION EMPTY'::geometry
----
true true true true

query TTT
SELECT 'POINT EMPTY'::geometry ~= 'POINT EMPTY'::geometry, 'POINT EMPTY'::geometry ~= 'POINT(1 1)'::geometry, 'POLYGON EMPTY'::geometry ~= 'LINESTRING EMPTY'::geometry
----
true false true

# NULL
query TTTR
SELECT NULL::geometry && 'POINT(1 1)'::geometry, 'POINT(1 1)'::geometry ~ NULL::geometry, NULL::geometry ~= NULL::geometry, NULL::geometry <#> 'POINT(1 1)'::geometry
----
NULL NULL NULL NULL

# PostGIS compares single-precision boxes, rounded outward
query TTTT
SELECT 'POINT(1 1)'::geometry ~= 'POINT(1.00000001 1)'::geometry, 'POINT(1 1)'::geometry ~= 'POINT(1 1)'::geometry, 'POINT(0.1 0)'::geometry << 'POINT(0.10000000001 0)'::geometry, 'POINT(0.1 0)'::geometry && 'POINT(0.10000001 0)'::geometry
----
false true false false

query TT
SELECT 'POINT(0.1 0)'::geometry && 'POINT(0.1000000001 0)'::geometry, 'POINT(1e30 0)'::geometry && 'POINT(1.0000001e30 0)'::geometry
----
true false

# &&& compares Z when both have Z, and M when both have M
query TTTT
SELECT 'POINT Z(0 0 0)'::geometry &&& 'POINT Z(0 0 5)'::geometry, 'POINT Z(0 0 0)'::geometry &&& 'POINT(0 0)'::geometry, 'POINT Z(0 0 0)'::geometry &&& 'POINT M(0 0 5)'::geometry, 'POINT M(0 0 0)'::geometry &&& 'POINT M(0 0 5)'::geometry
----
false true true false

query TTT
SELECT 'POINT ZM(0 0 0 0)'::geometry &&& 'POINT M(0 0 5)'::geometry, 'POINT ZM(0 0 0 0)'::geometry &&& 'POINT ZM(0 0 0 5)'::geometry, 'LINESTRING Z(0 0 0,1 1 2)'::geometry &&& 'POINT Z(1 1 1)'::geometry
----
false false true

query TT
SELECT 'POINT Z(0 0 0)'::geometry && 'POINT Z(0 0 5)'::geometry, 'POINT Z(0 0 0)'::geometry ~= 'POINT Z(0 0 5)'::geometry
----
true true

# Boxes as operands
query TTT
SELECT ST_MakeBox2D(ST_Point(0, 0), ST_Point(2, 2)) && ST_MakeBox2D(ST_Point(1, 1), ST_Point(3, 3)), ST_MakeBox2D(ST_Point(0, 0), ST_Point(2, 2)) ~ 'POINT(1 1)'::geometry, 'POINT(5 5)'::geometry @ ST_MakeBox2D(ST_Point(0, 0), ST_Point(2, 2))
----
true true false

query TT
SELECT ST_3DMakeBox(ST_MakePoint(0, 0, 0), ST_MakePoint(2, 2, 2)) &&& ST_3DMakeBox(ST_MakePoint(1, 1, 3), ST_MakePoint(3, 3, 4)), ST_3DMakeBox(ST_MakePoint(0, 0, 0), ST_MakePoint(2, 2, 2)) &&& 'POINT Z(1 1 1)'::geometry
----
false true

# SRIDs aren't compared by the box operators
query TR
SELECT 'SRID=3857;POINT(1 1)'::geometry && 'SRID=4326;POINT(1 1)'::geometry, 'SRID=3857;POINT(1 1)'::geometry <#> 'SRID=4326;POINT(4 5)'::geometry
----
true 5

# Columns
query IIT rowsort
SELECT a.id, b.id, a.g && b.g FROM (VALUES (1, 'LINESTRING(0 0,2 2)'::geometry), (2, 'POINT EMPTY'::geometry), (3, NULL::geometry)) AS a(id, g), (VALUES (4, 'POINT(1 1)'::geometry), (5, 'POINT(9 9)'::geometry)) AS b(id, g)
----
1 4 true
1 5 false
2 4 false
2 5 false
3 4 NULL
3 5 NULL

# <-> is ST_Distance
query RRRR
SELECT 'POINT(0 0)'::geometry <-> 'POINT(3 4)'::geometry, 'POLYGON((0 0,4 0,4 4,0 4,0 0))'::geometry <-> 'POINT(1 1)'::geometry, 'POINT Z(0 0 0)'::geometry <-> 'POINT Z(3 4 12)'::geometry, geometry_distance_centroid('LINESTRING(0 0,10 0)'::geometry, 'POINT(5 2)'::geometry)
----
5 0 5 2

query R
SELECT 'POINT EMPTY'::geometry <-> 'POINT(3 4)'::geometry
----
NULL

query error
SELECT 'SRID=3857;POINT(0 0)'::geometry <-> 'SRID=4326;POINT(3 4)'::geometry

query I rowsort
SELECT id FROM (VALUES (1, 'POINT(5 5)'::geometry), (2, 'POINT(1 1)'::geometry), (3, 'POINT(3 3)'::geometry)) AS t(id, g) ORDER BY g <-> 'POINT(0 0)'::geometry LIMIT 2
----
2
3

# <#> is the distance between the boxes
query RRRR
SELECT 'LINESTRING(0 0,10 0)'::geometry <#> 'POINT(13 4)'::geometry, 'LINESTRING(0 0,10 10)'::geometry <#> 'POINT(5 1)'::geometry, 'POINT(0 0)'::geometry <#> ST_MakeBox2D(ST_Point(3, 4), ST_Point(5, 5)), 'POINT(0.1 0)'::geometry <#> 'POINT(0.3 0)'::geometry
----
5 0 5 0.199999980628

query RR
SELECT 'POINT EMPTY'::geometry <#> 'POINT(3 4)'::geometry, 'POINT EMPTY'::geometry <#> 'POINT EMPTY'::geometry
----
340282346639000000000000000000000000000 340282346639000000000000000000000000000

# <<->> is the distance between the nearest points, in 3D if both have Z, measured in 2D otherwise
query R
SELECT ('POINT(0 0)'::geometry <<->> 'POINT(3 4)'::geometry)
----
5

query R
SELECT ('POINT Z (0 0 0)'::geometry <<->> 'POINT Z (3 4 12)'::geometry)
----
13

query R
SELECT ('POINT Z (0 0 12)'::geometry <<->> 'POINT(3 4)'::geometry)
----
5

query R
SELECT ('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry <<->> 'POINT(5 5)'::geometry)
----
0

query T
SELECT ('MULTIPOINT((-4.870611 -8),(1 3.695335),(-6.0 1.351))'::geometry <<->> 'LINESTRING(5.475784 6, -8.3 -5.5)'::geometry)::text
----
1.0990790343921544

query R
SELECT ('LINESTRING(-10 1, 7.856061 -1.180629, 6 8.474917, 0 -8.4)'::geometry <<->> 'LINESTRING(-6 2, 3.453702 1.9, -7.7 -7)'::geometry)
----
0

# With M on both sides, M counts: interpolated for points and lines, at the nearest points located in 2D
query R
SELECT ('POINT M (0 0 0)'::geometry <<->> 'POINT M (3 4 12)'::geometry)
----
13

query T
SELECT ('POINT ZM (0 0 0 0)'::geometry <<->> 'POINT ZM (1 1 1 1)'::geometry)::text
----
1.9999999999999998

query T
SELECT ('LINESTRING M (0 0 0,10 0 10)'::geometry <<->> 'POINT M (5 3 0)'::geometry)::text
----
5.830951894845301

query T
SELECT ('LINESTRING ZM (0 0 0 0,10 0 0 10)'::geometry <<->> 'POINT ZM (5 3 4 0)'::geometry)::text
----
7.0710678118654755

query R
SELECT ('LINESTRING M (0 0 0,10 0 10)'::geometry <<->> 'LINESTRING M (5 -1 100,5 1 0)'::geometry)
----
45

query T
SELECT ('LINESTRING M (0 0 0,10 0 10)'::geometry <<->> 'LINESTRING M (2 2 50,8 2 50)'::geometry)::text
----
48.041648597857254

query T
SELECT ('LINESTRING ZM(-9.2 -4 -5.148784 14.5588, 1.1 -1.979 -4.9 -17.447)'::geometry <<->> 'POINT ZM(5 0.984 7.5 -5)'::geometry)::text
----
18.239440177812476

query R
SELECT ('LINESTRING M (0 0 0,10 0 10)'::geometry <<->> 'POINT(5 3)'::geometry)
----
3

# and for other geometries the gap between the M ranges of their single-precision boxes
query R
SELECT ('MULTIPOINT M ((0 0 0),(10 0 10))'::geometry <<->> 'POINT M (6 0 0)'::geometry)
----
4

query T
SELECT ('MULTIPOINT M ((0 0 0.1))'::geometry <<->> 'POINT M (0 0 0)'::geometry)::text
----
0.09999999403953552

query T
SELECT ('POLYGON M ((0 0 10,10 0 10,10 10 10,0 10 10,0 0 10))'::geometry <<->> 'POINT M (5 -5 0)'::geometry)::text
----
11.180339887498949

query T
SELECT ('MULTILINESTRING M ((0 0 0,10 0 10))'::geometry <<->> 'POINT M (5 3 -20)'::geometry)::text
----
20.223748416156685

query R
SELECT ('GEOMETRYCOLLECTION M (POINT M (0 0 1))'::geometry <<->> 'POINT M (3 4 13)'::geometry)
----
13

# Boxes, EMPTY and NULL
query TT
SELECT ('BOX(0 0,1 1)'::box2d <<->> 'BOX(3 4,5 6)'::box2d)::text, ('BOX3D(0 0 0,1 1 1)'::box3d <<->> 'POINT Z (0.5 0.5 0.5)'::geometry)::text
----
3.605551275463989 0.5

query RR
SELECT ('POINT EMPTY'::geometry <<->> 'POINT(5 5)'::geometry), ('LINESTRING EMPTY'::geometry <<->> 'LINESTRING EMPTY'::geometry)
----
0 0

query T
SELECT (NULL::geometry <<->> 'POINT(5 5)'::geometry)::text
----
NULL

# <<->> doesn't take geography
query error
SELECT 'POINT(0 0)'::geography <<->> 'POINT(1 1)'::geography

# && on geography compares geocentric boxes: an edge bulges toward the pole between its ends
query TTTT
SELECT 'LINESTRING(-10 60, 10 60)'::geography && 'POINT(0 60.378348)'::geography, 'LINESTRING(-10 60, 10 60)'::geometry && 'POINT(0 60.378348)'::geometry, 'LINESTRING(-10 60, 10 60)'::geography && 'POINT(0 60)'::geography, geography_overlaps('POINT(1 2)'::geography, 'POINT(1 2)'::geography)
----
true false false true

# A polygon's box reaches the pole its rings go around, even one it doesn't enclose; a line's doesn't
query TTTT
SELECT 'POLYGON((0 80,90 80,180 80,-90 80,0 80))'::geography && 'POINT(0 90)'::geography, 'POLYGON((0 70,90 70,180 70,-90 70,0 70),(0 85,-90 85,180 85,90 85,0 85))'::geography && 'POINT(0 90)'::geography, 'LINESTRING(0 80,90 80,180 80,-90 80,0 80)'::geography && 'POINT(0 90)'::geography, 'POLYGON((0 80,90 80,180 80,-90 80,0 80))'::geography && 'POINT(0 -90)'::geography
----
true true false false

# The same for the other axes, per polygon
query TTT
SELECT 'POLYGON((-10 -10,10 -10,10 10,-10 10,-10 -10))'::geography && 'POINT(0 0)'::geography, 'POLYGON((-100 -50,100 -50,100 50,-100 50,-100 -50))'::geography && 'POINT(180 0)'::geography, 'MULTIPOLYGON(((85 -5,95 -5,95 5,85 5,85 -5)),((-95 -5,-85 -5,-85 5,-95 5,-95 -5)))'::geography && 'POINT(0 0)'::geography
----
true true false

# Single-precision boxes, EMPTY, NULL, geometry cast to geography, and SRIDs not checked
query TTTTTT
SELECT 'POINT(0 0)'::geography && 'POINT(0 0.0000001)'::geography, 'POINT EMPTY'::geography && 'POINT(0 0)'::geography, NULL::geography && 'POINT(0 0)'::geography, 'POLYGON((-100 -50,100 -50,100 50,-100 50,-100 -50))'::geography && 'POINT(0 0)'::geometry, 'POINT(0 0)'::geometry && 'POINT(0 0)'::geography, 'SRID=4269;POINT(0 0)'::geography && 'POINT(0 0)'::geography
----
false false NULL false true true

# <-> on geography is the distance on the sphere, not rounded
query RRRR
SELECT 'POINT(0 0)'::geography <-> 'POINT(1 1)'::geography, 'LINESTRING(0 0, 10 0)'::geography <-> 'POINT(5 1)'::geography, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geography <-> 'POINT(5 5)'::geography, geography_distance_knn('POINT(0 0)'::geography, 'POINT(1 0)'::geography)
----
157249.597769 111195.079735 0 111195.079735

query RRR
SELECT 'SRID=4269;POINT(0 0)'::geography <-> 'SRID=4269;POINT(1 1)'::geography, 'POINT EMPTY'::geography <-> 'POINT(1 1)'::geography, 'POINT(0 0)'::geometry <-> 'POINT(1 1)'::geography
----
157249.597768 NULL 157249.597769

query error
SELECT 'SRID=4269;POINT(0 0)'::geography <-> 'POINT(1 1)'::geography

# Points within 5e-14 radians in longitude and latitude are the same
query RRRR
SELECT 'POINT(0 0)'::geography <-> 'POINT(0 0.000000000002)'::geography, 'POINT(0 0)'::geography <-> 'POINT(0 0.000000000003)'::geography, 'LINESTRING(0 79, 0 81)'::geography <-> 'POINT(0.000000000002 80)'::geography, 'LINESTRING(0 79, 0 81)'::geography <-> 'POINT(0.000000000003 80)'::geography
----
0 0.000000333585239204 0 0.0000000579871655561

query RR
SELECT ST_Distance('POINT(0 0)'::geography, 'POINT(0 0.000000000002)'::geography), ST_Distance('POINT(0 0)'::geography, 'POINT(0 0.000000000004)'::geography)
----
0 0.00000044

query I rowsort
SELECT id FROM (VALUES (1, 'POINT(50 50)'::geography), (2, 'POINT(1 1)'::geography), (3, 'POINT(10 10)'::geography)) AS t(id, g) ORDER BY g <-> 'POINT(0 0)'::geography LIMIT 2
----
2
3

# The other operators don't take geography
query error
SELECT 'POINT(0 0)'::geography << 'POINT(1 1)'::geography

query error
SELECT 'POINT(0 0)'::geography ~= 'POINT(0 0)'::geometry

# The operators keep their meaning for other types
query IIT
SELECT 1 << 2, 16 >> 2, 'abc' ~ 'b'
----
4 4 true
