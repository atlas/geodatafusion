# The bounding box operators and <->, <#>: EMPTY, NULL, boxes, single-precision boxes, Z and M,
# SRIDs, and the same operators on other types.

# Each operator on overlapping and separate boxes
query TTTT
SELECT 'LINESTRING(0 0,2 2)'::geometry && 'POINT(1 1)'::geometry, 'LINESTRING(0 0,2 2)'::geometry && 'POINT(3 3)'::geometry, 'POINT(2 2)'::geometry && 'LINESTRING(0 0,2 2)'::geometry, geometry_overlaps('POINT(1 1)'::geometry, 'POINT(1 1)'::geometry)
----
true false true true

query TTT
SELECT 'LINESTRING(0 0,2 2)'::geometry ~ 'POINT(1 1)'::geometry, 'POINT(1 1)'::geometry ~ 'LINESTRING(0 0,2 2)'::geometry, 'LINESTRING(0 0,2 2)'::geometry ~ 'LINESTRING(0 0,2 2)'::geometry
----
true false true

query TTT
SELECT 'POINT(1 1)'::geometry @ 'LINESTRING(0 0,2 2)'::geometry, 'LINESTRING(0 0,2 2)'::geometry @ 'POINT(1 1)'::geometry, geometry_within('POINT(1 1)'::geometry, 'POINT(1 1)'::geometry)
----
true false true

query TT
SELECT 'LINESTRING(0 0,1 1)'::geometry ~= 'LINESTRING(0 1,1 0)'::geometry, 'LINESTRING(0 0,1 1)'::geometry ~= 'LINESTRING(0 0,1 2)'::geometry
----
true false

query TTTT
SELECT 'POINT(0 0)'::geometry << 'POINT(1 0)'::geometry, 'POINT(1 0)'::geometry << 'POINT(1 0)'::geometry, 'LINESTRING(0 0,2 0)'::geometry &< 'LINESTRING(1 0,2 0)'::geometry, 'LINESTRING(0 0,3 0)'::geometry &< 'LINESTRING(1 0,2 0)'::geometry
----
true false true false

query TTTT
SELECT 'POINT(1 0)'::geometry >> 'POINT(0 0)'::geometry, 'POINT(1 0)'::geometry >> 'POINT(1 0)'::geometry, 'LINESTRING(1 0,3 0)'::geometry &> 'LINESTRING(1 0,2 0)'::geometry, 'LINESTRING(0 0,3 0)'::geometry &> 'LINESTRING(1 0,2 0)'::geometry
----
true false true false

query TTTT
SELECT 'POINT(0 0)'::geometry <<| 'POINT(0 1)'::geometry, 'POINT(0 1)'::geometry <<| 'POINT(0 1)'::geometry, 'LINESTRING(0 0,0 2)'::geometry &<| 'LINESTRING(0 1,0 2)'::geometry, 'LINESTRING(0 0,0 3)'::geometry &<| 'LINESTRING(0 1,0 2)'::geometry
----
true false true false

query TTTT
SELECT 'POINT(0 1)'::geometry |>> 'POINT(0 0)'::geometry, 'POINT(0 1)'::geometry |>> 'POINT(0 1)'::geometry, 'LINESTRING(0 1,0 3)'::geometry |&> 'LINESTRING(0 1,0 2)'::geometry, 'LINESTRING(0 0,0 3)'::geometry |&> 'LINESTRING(0 1,0 2)'::geometry
----
true false true false

# Collections and polygons use the box of all their parts
query TT
SELECT 'GEOMETRYCOLLECTION(POINT(0 0),POINT(4 4))'::geometry ~ 'POINT(2 2)'::geometry, 'POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 1))'::geometry && 'POINT(3 3)'::geometry
----
true true

# EMPTY: the overlap and position operators are false, the containment operators true
query TTTTT
SELECT 'POINT EMPTY'::geometry && 'POINT(1 1)'::geometry, 'POINT EMPTY'::geometry && 'POINT EMPTY'::geometry, 'POINT EMPTY'::geometry &&& 'POINT(1 1)'::geometry, 'POINT EMPTY'::geometry << 'POINT(1 1)'::geometry, 'POINT(1 1)'::geometry |&> 'LINESTRING EMPTY'::geometry
----
false false false false false

query TTTT
SELECT 'POINT EMPTY'::geometry ~ 'POINT(1 1)'::geometry, 'POINT(1 1)'::geometry ~ 'POINT EMPTY'::geometry, 'POINT EMPTY'::geometry @ 'POINT(1 1)'::geometry, 'POINT(1 1)'::geometry @ 'GEOMETRYCOLLECTION EMPTY'::geometry
----
true true true true

query TTT
SELECT 'POINT EMPTY'::geometry ~= 'POINT EMPTY'::geometry, 'POINT EMPTY'::geometry ~= 'POINT(1 1)'::geometry, 'POLYGON EMPTY'::geometry ~= 'LINESTRING EMPTY'::geometry
----
true false true

# NULL
query TTTR
SELECT NULL::geometry && 'POINT(1 1)'::geometry, 'POINT(1 1)'::geometry ~ NULL::geometry, NULL::geometry ~= NULL::geometry, NULL::geometry <#> 'POINT(1 1)'::geometry
----
NULL NULL NULL NULL

# PostGIS compares single-precision boxes, rounded outward
query TTTT
SELECT 'POINT(1 1)'::geometry ~= 'POINT(1.00000001 1)'::geometry, 'POINT(1 1)'::geometry ~= 'POINT(1 1)'::geometry, 'POINT(0.1 0)'::geometry << 'POINT(0.10000000001 0)'::geometry, 'POINT(0.1 0)'::geometry && 'POINT(0.10000001 0)'::geometry
----
false true false false

query TT
SELECT 'POINT(0.1 0)'::geometry && 'POINT(0.1000000001 0)'::geometry, 'POINT(1e30 0)'::geometry && 'POINT(1.0000001e30 0)'::geometry
----
true false

# &&& compares Z when both have Z, and M when both have M
query TTTT
SELECT 'POINT Z(0 0 0)'::geometry &&& 'POINT Z(0 0 5)'::geometry, 'POINT Z(0 0 0)'::geometry &&& 'POINT(0 0)'::geometry, 'POINT Z(0 0 0)'::geometry &&& 'POINT M(0 0 5)'::geometry, 'POINT M(0 0 0)'::geometry &&& 'POINT M(0 0 5)'::geometry
----
false true true false

query TTT
SELECT 'POINT ZM(0 0 0 0)'::geometry &&& 'POINT M(0 0 5)'::geometry, 'POINT ZM(0 0 0 0)'::geometry &&& 'POINT ZM(0 0 0 5)'::geometry, 'LINESTRING Z(0 0 0,1 1 2)'::geometry &&& 'POINT Z(1 1 1)'::geometry
----
false false true

query TT
SELECT 'POINT Z(0 0 0)'::geometry && 'POINT Z(0 0 5)'::geometry, 'POINT Z(0 0 0)'::geometry ~= 'POINT Z(0 0 5)'::geometry
----
true true

# Boxes as operands
query TTT
SELECT ST_MakeBox2D(ST_Point(0, 0), ST_Point(2, 2)) && ST_MakeBox2D(ST_Point(1, 1), ST_Point(3, 3)), ST_MakeBox2D(ST_Point(0, 0), ST_Point(2, 2)) ~ 'POINT(1 1)'::geometry, 'POINT(5 5)'::geometry @ ST_MakeBox2D(ST_Point(0, 0), ST_Point(2, 2))
----
true true false

query TT
SELECT ST_3DMakeBox(ST_MakePoint(0, 0, 0), ST_MakePoint(2, 2, 2)) &&& ST_3DMakeBox(ST_MakePoint(1, 1, 3), ST_MakePoint(3, 3, 4)), ST_3DMakeBox(ST_MakePoint(0, 0, 0), ST_MakePoint(2, 2, 2)) &&& 'POINT Z(1 1 1)'::geometry
----
false true

# SRIDs aren't compared by the box operators
query TR
SELECT 'SRID=3857;POINT(1 1)'::geometry && 'SRID=4326;POINT(1 1)'::geometry, 'SRID=3857;POINT(1 1)'::geometry <#> 'SRID=4326;POINT(4 5)'::geometry
----
true 5

# Columns
query IIT rowsort
SELECT a.id, b.id, a.g && b.g FROM (VALUES (1, 'LINESTRING(0 0,2 2)'::geometry), (2, 'POINT EMPTY'::geometry), (3, NULL::geometry)) AS a(id, g), (VALUES (4, 'POINT(1 1)'::geometry), (5, 'POINT(9 9)'::geometry)) AS b(id, g)
----
1 4 true
1 5 false
2 4 false
2 5 false
3 4 NULL
3 5 NULL

# <-> is ST_Distance
query RRRR
SELECT 'POINT(0 0)'::geometry <-> 'POINT(3 4)'::geometry, 'POLYGON((0 0,4 0,4 4,0 4,0 0))'::geometry <-> 'POINT(1 1)'::geometry, 'POINT Z(0 0 0)'::geometry <-> 'POINT Z(3 4 12)'::geometry, geometry_distance_centroid('LINESTRING(0 0,10 0)'::geometry, 'POINT(5 2)'::geometry)
----
5 0 5 2

query R
SELECT 'POINT EMPTY'::geometry <-> 'POINT(3 4)'::geometry
----
NULL

query error
SELECT 'SRID=3857;POINT(0 0)'::geometry <-> 'SRID=4326;POINT(3 4)'::geometry

query I rowsort
SELECT id FROM (VALUES (1, 'POINT(5 5)'::geometry), (2, 'POINT(1 1)'::geometry), (3, 'POINT(3 3)'::geometry)) AS t(id, g) ORDER BY g <-> 'POINT(0 0)'::geometry LIMIT 2
----
2
3

# <#> is the distance between the boxes
query RRRR
SELECT 'LINESTRING(0 0,10 0)'::geometry <#> 'POINT(13 4)'::geometry, 'LINESTRING(0 0,10 10)'::geometry <#> 'POINT(5 1)'::geometry, 'POINT(0 0)'::geometry <#> ST_MakeBox2D(ST_Point(3, 4), ST_Point(5, 5)), 'POINT(0.1 0)'::geometry <#> 'POINT(0.3 0)'::geometry
----
5 0 5 0.199999980628

query RR
SELECT 'POINT EMPTY'::geometry <#> 'POINT(3 4)'::geometry, 'POINT EMPTY'::geometry <#> 'POINT EMPTY'::geometry
----
340282346639000000000000000000000000000 340282346639000000000000000000000000000

# The operators keep their meaning for other types
query IIT
SELECT 1 << 2, 16 >> 2, 'abc' ~ 'b'
----
4 4 true
