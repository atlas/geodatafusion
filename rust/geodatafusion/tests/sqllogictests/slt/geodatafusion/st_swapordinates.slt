# Edge cases for ST_SwapOrdinates, not covered by the PostGIS docs examples.

# Every pair, in either case
query T
SELECT ST_AsEWKT(ST_SwapOrdinates('POINT ZM (1 2 3 4)'::geometry, 'xy'))
----
POINT(2 1 3 4)

query T
SELECT ST_AsEWKT(ST_SwapOrdinates('POINT ZM (1 2 3 4)'::geometry, 'xz'))
----
POINT(3 2 1 4)

query T
SELECT ST_AsEWKT(ST_SwapOrdinates('POINT ZM (1 2 3 4)'::geometry, 'zm'))
----
POINT(1 2 4 3)

query T
SELECT ST_AsEWKT(ST_SwapOrdinates('POINT ZM (1 2 3 4)'::geometry, 'MY'))
----
POINT(1 4 3 2)

query T
SELECT ST_AsEWKT(ST_SwapOrdinates('POINT ZM (1 2 3 4)'::geometry, 'xx'))
----
POINT(1 2 3 4)

query T
SELECT ST_AsEWKT(ST_SwapOrdinates('POINT M (1 2 3)'::geometry, 'ym'))
----
POINTM(1 3 2)

query T
SELECT ST_AsEWKT(ST_SwapOrdinates('SRID=4326;LINESTRING Z (1 2 3,4 5 6)'::geometry, 'zx'))
----
SRID=4326;LINESTRING(3 2 1,6 5 4)

query T
SELECT ST_AsText(ST_SwapOrdinates('GEOMETRYCOLLECTION(POINT(1 2),POLYGON((0 0,4 0,4 1,0 0)))'::geometry, 'yx'))
----
GEOMETRYCOLLECTION(POINT(2 1),POLYGON((0 0,0 4,1 4,0 0)))

# EMPTY and NULL
query T
SELECT ST_AsText(ST_SwapOrdinates('POINT EMPTY'::geometry, 'xy'))
----
POINT EMPTY

query T
SELECT ST_AsEWKT(ST_SwapOrdinates('LINESTRING ZM EMPTY'::geometry, 'zm'))
----
LINESTRING EMPTY

query T
SELECT ST_SwapOrdinates(NULL::geometry, 'xy')
----
NULL

query T
SELECT ST_AsText(ST_SwapOrdinates('POINT(1 2)'::geometry, NULL))
----
NULL

# Invalid ordinates, or ones the geometry lacks
query error
SELECT ST_SwapOrdinates('POINT(1 2)'::geometry, 'xz')

query error
SELECT ST_SwapOrdinates('POINT Z (1 2 3)'::geometry, 'xm')

query error
SELECT ST_SwapOrdinates('POINT EMPTY'::geometry, 'xz')

query error
SELECT ST_SwapOrdinates('POINT(1 2)'::geometry, 'x')

query error
SELECT ST_SwapOrdinates('POINT(1 2)'::geometry, 'xyz')

query error
SELECT ST_SwapOrdinates('POINT(1 2)'::geometry, 'xq')
