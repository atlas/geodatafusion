# Edge cases for ST_FilterByM, not covered by the PostGIS docs examples.

# Ranges
query T
SELECT ST_AsText(ST_FilterByM('LINESTRING M (0 0 0,1 1 5,2 2 10,3 3 15)'::geometry, 4))
----
LINESTRING(1 1,2 2,3 3)

query T
SELECT ST_AsText(ST_FilterByM('LINESTRING M (0 0 0,1 1 5,2 2 10,3 3 15)'::geometry, 4, 11))
----
LINESTRING(1 1,2 2)

query T
SELECT ST_AsText(ST_FilterByM('LINESTRING M (0 0 0,1 1 5,2 2 10,3 3 15)'::geometry, 4, 11, true))
----
LINESTRING M (1 1 5,2 2 10)

query T
SELECT ST_AsText(ST_FilterByM('LINESTRING M (0 0 0,1 1 5,2 2 10,3 3 15)'::geometry, 5, 10))
----
LINESTRING(1 1,2 2)

query T
SELECT ST_AsText(ST_FilterByM('LINESTRING M (0 0 0,1 1 5,2 2 10,3 3 15)'::geometry, 20))
----
LINESTRING EMPTY

query T
SELECT ST_AsText(ST_FilterByM('LINESTRING M (0 0 0,1 1 5,2 2 10,3 3 15)'::geometry, 0, 5))
----
LINESTRING(0 0,1 1)

query T
SELECT ST_AsText(ST_FilterByM('LINESTRING M (0 0 0,1 1 5,2 2 10,3 3 15)'::geometry, 4, NULL, true))
----
LINESTRING M (1 1 5,2 2 10,3 3 15)

query T
SELECT ST_AsText(ST_FilterByM('LINESTRING ZM (0 0 1 0,1 1 2 5,2 2 3 10)'::geometry, 4))
----
LINESTRING Z (1 1 2,2 2 3)

query T
SELECT ST_AsText(ST_FilterByM('LINESTRING ZM (0 0 1 0,1 1 2 5,2 2 3 10)'::geometry, 4, NULL, true))
----
LINESTRING ZM (1 1 2 5,2 2 3 10)

query T
SELECT ST_AsText(ST_FilterByM('LINESTRING M (0 0 0,1 1 5,2 2 0)'::geometry, 4))
----
LINESTRING EMPTY

# Other types
query T
SELECT ST_AsText(ST_FilterByM('POLYGON M ((0 0 0,10 0 5,10 10 10,0 10 15,0 0 0))'::geometry, 4))
----
POLYGON EMPTY

query T
SELECT ST_AsText(ST_FilterByM('POLYGON M ((0 0 0,10 0 5,10 10 10,0 10 15,5 5 7,0 0 0))'::geometry, 4))
----
POLYGON((10 0,10 10,0 10,5 5))

query T
SELECT ST_AsText(ST_FilterByM('POLYGON M ((0 0 5,10 0 5,10 10 5,0 0 5),(1 1 0,2 1 0,2 2 0,1 1 0))'::geometry, 4))
----
POLYGON((0 0,10 0,10 10,0 0))

query T
SELECT ST_AsText(ST_FilterByM('MULTIPOINT M ((0 0 0),(1 1 5))'::geometry, 4))
----
MULTIPOINT((1 1))

query T
SELECT ST_AsText(ST_FilterByM('POINT M (1 1 5)'::geometry, 6))
----
POINT EMPTY

query T
SELECT ST_AsText(ST_FilterByM('POINT M (1 1 5)'::geometry, 4))
----
POINT(1 1)

query T
SELECT ST_AsText(ST_FilterByM('MULTILINESTRING M ((0 0 0,1 1 5),(2 2 10,3 3 15))'::geometry, 4, 11))
----
MULTILINESTRING EMPTY

query T
SELECT ST_AsText(ST_FilterByM('MULTIPOLYGON M (((0 0 0,10 0 5,10 10 10,0 0 0)),((0 0 5,10 0 5,10 10 5,0 0 5)))'::geometry, 4))
----
MULTIPOLYGON(((0 0,10 0,10 10,0 0)))

query T
SELECT ST_AsText(ST_FilterByM('GEOMETRYCOLLECTION M (LINESTRING M (0 0 0,1 1 5,2 2 10),POINT M (1 1 1))'::geometry, 4))
----
GEOMETRYCOLLECTION(LINESTRING(1 1,2 2))

# Without M, unchanged
query T
SELECT ST_AsText(ST_FilterByM('LINESTRING(0 0,1 1)'::geometry, 4))
----
LINESTRING(0 0,1 1)

query T
SELECT ST_AsText(ST_FilterByM('LINESTRING Z (0 0 0,1 1 9)'::geometry, 4))
----
LINESTRING Z (0 0 0,1 1 9)

# NULL; min and returnM aren't STRICT
query T
SELECT ST_AsText(ST_FilterByM('LINESTRING M (0 0 -5,1 1 1e-310,2 2 3e-308,3 3 15)'::geometry, NULL))
----
LINESTRING(2 2,3 3)

query T
SELECT ST_AsText(ST_FilterByM('LINESTRING M (0 0 0,1 1 5,2 2 10,3 3 15)'::geometry, 4, 11, NULL))
----
LINESTRING(1 1,2 2)

query T
SELECT ST_FilterByM(NULL::geometry, 4)
----
NULL

query T
SELECT ST_AsText(ST_FilterByM('LINESTRING M (0 0 0,1 1 5,2 2 10,3 3 15)'::geometry, NULL))
----
LINESTRING(1 1,2 2,3 3)

# min above max
query error
SELECT ST_FilterByM('LINESTRING M (0 0 0,1 1 5,2 2 10,3 3 15)', 11, 4)
