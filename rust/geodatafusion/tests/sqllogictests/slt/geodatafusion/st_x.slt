# Edge cases for ST_X, not covered by the PostGIS docs examples.

# Every dimension
query R
SELECT ST_X('POINT(1 2)'::geometry)
----
1

query R
SELECT ST_X('POINT Z (1 2 3)'::geometry)
----
1

query R
SELECT ST_X('POINT M (1 2 3)'::geometry)
----
1

query R
SELECT ST_X('POINT ZM (1 2 3 4)'::geometry)
----
1

# WKB input
query R
SELECT ST_X(ST_GeomFromEWKT('SRID=4326;POINT ZM (1 2 3 4)'))
----
1

# EMPTY and NULL
query R
SELECT ST_X('POINT EMPTY'::geometry)
----
NULL

query R
SELECT ST_X(NULL::geometry)
----
NULL

# Other geometry types are an error
statement error
SELECT ST_X('LINESTRING(0 0,1 1)'::geometry)

statement error
SELECT ST_X('MULTIPOINT(1 2)'::geometry)

# A column, including NULL
query R rowsort
SELECT ST_X(g) FROM (VALUES ('POINT ZM (1 2 3 4)'::geometry), (NULL::geometry), ('POINT(5 6)'::geometry)) AS t(g)
----
1
5
NULL
