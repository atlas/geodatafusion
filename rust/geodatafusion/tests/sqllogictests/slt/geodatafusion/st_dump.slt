# Edge cases for ST_Dump, not covered by the PostGIS docs examples. The table function form takes
# a constant, and DataFusion only finds it by its lowercase name.

# Atomic geometries are returned whole, with an empty path
query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dump('POINT(1 1)'::geometry)
----
{} POINT(1 1)

query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dump('LINESTRING(0 0, 1 1)'::geometry)
----
{} LINESTRING(0 0,1 1)

query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dump('POLYGON((0 0, 1 0, 1 1, 0 0), (0.2 0.1, 0.3 0.1, 0.3 0.2, 0.2 0.1))'::geometry)
----
{} POLYGON((0 0,1 0,1 1,0 0),(0.2 0.1,0.3 0.1,0.3 0.2,0.2 0.1))

# MULTI geometries and collections are split recursively
query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dump('MULTIPOINT(0 0, 1 1)'::geometry)
----
{1} POINT(0 0)
{2} POINT(1 1)

query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dump('MULTILINESTRING((0 0, 1 1), (2 2, 3 3))'::geometry)
----
{1} LINESTRING(0 0,1 1)
{2} LINESTRING(2 2,3 3)

query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dump('MULTIPOLYGON(((0 0, 1 0, 1 1, 0 0)), ((5 5, 6 5, 6 6, 5 5)))'::geometry)
----
{1} POLYGON((0 0,1 0,1 1,0 0))
{2} POLYGON((5 5,6 5,6 6,5 5))

query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dump('GEOMETRYCOLLECTION(POINT(0 0), LINESTRING(1 1, 2 2), MULTIPOINT(3 3, 4 4), GEOMETRYCOLLECTION(POINT(5 5)))'::geometry)
----
{1} POINT(0 0)
{2} LINESTRING(1 1,2 2)
{3,1} POINT(3 3)
{3,2} POINT(4 4)
{4,1} POINT(5 5)

# Empty geometries have no parts, but empty parts of non-empty ones are parts
query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dump('POINT EMPTY'::geometry)
----

query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dump('GEOMETRYCOLLECTION EMPTY'::geometry)
----

query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dump('GEOMETRYCOLLECTION(POINT EMPTY, LINESTRING EMPTY)'::geometry)
----

query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dump('GEOMETRYCOLLECTION(POINT(0 0), POLYGON EMPTY)'::geometry)
----
{1} POINT(0 0)
{2} POLYGON EMPTY

query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dump('MULTIPOINT(0 0, EMPTY, 1 1)'::geometry)
----
{1} POINT(0 0)
{2} POINT EMPTY
{3} POINT(1 1)

# Z, M and the SRID are kept
query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dump('SRID=4326;MULTIPOINT Z (0 0 1, 1 1 2)'::geometry)
----
{1} SRID=4326;POINT(0 0 1)
{2} SRID=4326;POINT(1 1 2)

query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dump('SRID=3857;POINT M (1 2 3)'::geometry)
----
{} SRID=3857;POINTM(1 2 3)

# NULL gives no rows
query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dump(NULL::geometry)
----

# The result's columns can be used like any table's
query I
SELECT count(*) FROM st_dump('MULTIPOLYGON(((0 0, 1 0, 1 1, 0 0)), ((5 5, 6 5, 6 6, 5 5), (5.2 5.1, 5.8 5.1, 5.8 5.7, 5.2 5.1)))'::geometry) AS d WHERE d.path[1] = 2
----
1

# Other ways to pass the geometry: a cast with a type modifier, or a function
query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dump('MULTIPOINT(0 0, 1 1)'::geometry(MultiPoint, 4326))
----
{1} SRID=4326;POINT(0 0)
{2} SRID=4326;POINT(1 1)

query TT rowsort
SELECT path, ST_AsEWKT(geom) FROM st_dump(ST_GeomFromEWKT('SRID=3857;MULTILINESTRING((0 0, 1 1), (2 2, 3 3))'))
----
{1} SRID=3857;LINESTRING(0 0,1 1)
{2} SRID=3857;LINESTRING(2 2,3 3)
