# Edge cases for ST_LineFromWKB, not covered by the PostGIS docs examples.

# The right type, with and without SRID
query T
SELECT ST_LineFromWKB(ST_AsBinary('LINESTRING(0 0,1 1)'::geometry))
----
LINESTRING(0 0,1 1)

query T
SELECT ST_LineFromWKB(ST_AsBinary('LINESTRING(0 0,1 1)'::geometry), 4326)
----
SRID=4326;LINESTRING(0 0,1 1)

query T
SELECT ST_LineFromWKB(ST_AsEWKB('SRID=3857;LINESTRING(0 0,1 1)'::geometry))
----
SRID=3857;LINESTRING(0 0,1 1)

query T
SELECT ST_LineFromWKB(ST_AsBinary('LINESTRING EMPTY'::geometry))
----
LINESTRING EMPTY

# Another type is NULL
query T
SELECT ST_LineFromWKB(ST_AsBinary('POINT(1 2)'::geometry))
----
NULL

# Truncated input is an error
statement error
SELECT ST_LineFromWKB(decode('0101', 'hex'))

# NULL
query T
SELECT ST_LineFromWKB(NULL)
----
NULL

query T
SELECT ST_LineFromWKB(ST_AsBinary('LINESTRING(0 0,1 1)'::geometry), NULL)
----
NULL
