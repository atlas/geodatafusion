# Edge cases for ST_Collect_Agg, PostGIS's aggregate ST_Collect(geometry), not covered by the
# PostGIS docs examples. The PostGIS engine defines st_collect_agg from PostGIS's own ST_Collect.

# Points, lines or polygons give a multi-geometry, even for one row
query T
SELECT ST_Collect_Agg(g) FROM (VALUES ('POINT(1 2)'::geometry), ('POINT(3 4)'::geometry)) AS t(g)
----
MULTIPOINT((1 2),(3 4))

query T
SELECT ST_Collect_Agg(g) FROM (VALUES ('POINT(1 2)'::geometry)) AS t(g)
----
MULTIPOINT((1 2))

query T
SELECT ST_Collect_Agg(g) FROM (VALUES ('LINESTRING(0 0,1 1)'::geometry), ('LINESTRING(2 2,3 3)'::geometry)) AS t(g)
----
MULTILINESTRING((0 0,1 1),(2 2,3 3))

query T
SELECT ST_Collect_Agg(g) FROM (VALUES ('POLYGON((0 0,1 0,1 1,0 0))'::geometry)) AS t(g)
----
MULTIPOLYGON(((0 0,1 0,1 1,0 0)))

# Anything else gives a collection
query T
SELECT ST_Collect_Agg(g) FROM (VALUES ('POINT(1 2)'::geometry), ('LINESTRING(0 0,1 1)'::geometry)) AS t(g)
----
GEOMETRYCOLLECTION(POINT(1 2),LINESTRING(0 0,1 1))

query T
SELECT ST_Collect_Agg(g) FROM (VALUES ('MULTIPOINT((1 2))'::geometry), ('POINT(3 4)'::geometry)) AS t(g)
----
GEOMETRYCOLLECTION(MULTIPOINT((1 2)),POINT(3 4))

query T
SELECT ST_Collect_Agg(g) FROM (VALUES ('POINT(1 2)'::geometry), ('POINT EMPTY'::geometry), ('LINESTRING(0 0,1 1)'::geometry)) AS t(g)
----
GEOMETRYCOLLECTION(POINT(1 2),POINT EMPTY,LINESTRING(0 0,1 1))

# NULLs are skipped
query T
SELECT ST_Collect_Agg(g) FROM (VALUES ('POINT(1 2)'::geometry), (NULL::geometry), ('POINT(3 4)'::geometry)) AS t(g)
----
MULTIPOINT((1 2),(3 4))

query T
SELECT ST_Collect_Agg(g) FROM (VALUES (NULL::geometry)) AS t(g)
----
NULL

# Z, M and SRID are kept
query T
SELECT ST_Collect_Agg(g) FROM (VALUES ('POINT Z (1 2 3)'::geometry), ('POINT Z (3 4 5)'::geometry)) AS t(g)
----
MULTIPOINT Z ((1 2 3),(3 4 5))

query T
SELECT ST_Collect_Agg(g) FROM (VALUES ('POINT M (1 2 3)'::geometry), ('POINT M (3 4 5)'::geometry)) AS t(g)
----
MULTIPOINT M ((1 2 3),(3 4 5))

query T
SELECT ST_Collect_Agg(g) FROM (VALUES ('SRID=4326;POINT(1 2)'::geometry), ('SRID=4326;POINT(3 4)'::geometry)) AS t(g)
----
SRID=4326;MULTIPOINT((1 2),(3 4))

# No rows give NULL
query T
SELECT ST_Collect_Agg(g) FROM (SELECT 'POINT(1 1)'::geometry AS g WHERE false) AS t
----
NULL

# ORDER BY inside the call
query T
SELECT ST_Collect_Agg(g ORDER BY i DESC) FROM (VALUES (1, 'POINT(1 2)'::geometry), (2, 'POINT(3 4)'::geometry), (3, 'POINT(5 6)'::geometry)) AS t(i, g)
----
MULTIPOINT((5 6),(3 4),(1 2))

# GROUP BY
query IT rowsort
SELECT k, ST_Collect_Agg(g ORDER BY i) FROM (VALUES (1, 1, 'POINT(1 2)'::geometry), (1, 2, 'POINT(3 4)'::geometry), (2, 3, 'LINESTRING(0 0,1 1)'::geometry), (3, 4, NULL::geometry)) AS t(k, i, g) GROUP BY k
----
1 MULTIPOINT((1 2),(3 4))
2 MULTILINESTRING((0 0,1 1))
3 NULL

# Mixed dimensions are an error
statement error
SELECT ST_Collect_Agg(g) FROM (VALUES ('POINT Z (1 2 3)'::geometry), ('POINT(3 4)'::geometry)) AS t(g)
