# Edge cases for ST_Polygonize (the aggregate), not covered by the PostGIS docs examples.

# Polygons from noded linework
query T
SELECT ST_Polygonize(g) FROM (VALUES ('LINESTRING(0 0,1 0)'::geometry), ('LINESTRING(1 0,1 1)'::geometry), ('LINESTRING(1 1,0 0)'::geometry)) AS t(g)
----
GEOMETRYCOLLECTION(POLYGON((1 0,0 0,1 1,1 0)))

query T
SELECT ST_Polygonize(g) FROM (VALUES ('LINESTRING(0 0,1 0,1 1,0 0)'::geometry)) AS t(g)
----
GEOMETRYCOLLECTION(POLYGON((0 0,1 1,1 0,0 0)))

query T
SELECT ST_Polygonize(g) FROM (VALUES ('POLYGON((0 0,1 0,1 1,0 0))'::geometry)) AS t(g)
----
GEOMETRYCOLLECTION(POLYGON((0 0,1 1,1 0,0 0)))

query T
SELECT ST_Polygonize(g) FROM (VALUES ('MULTILINESTRING((0 0,2 0,2 2,0 2,0 0),(1 -1,1 3))'::geometry)) AS t(g)
----
GEOMETRYCOLLECTION(POLYGON((0 0,0 2,2 2,2 0,0 0)))

query T
SELECT ST_Polygonize(g) FROM (VALUES ('LINESTRING(0 0,1 0,1 1,0 0)'::geometry), ('LINESTRING(5 5,6 5,6 6,5 5)'::geometry)) AS t(g)
----
GEOMETRYCOLLECTION(POLYGON((0 0,1 1,1 0,0 0)),POLYGON((5 5,6 6,6 5,5 5)))

# No polygons give an empty collection
query T
SELECT ST_Polygonize(g) FROM (VALUES ('LINESTRING(0 0,1 0)'::geometry)) AS t(g)
----
GEOMETRYCOLLECTION EMPTY

query T
SELECT ST_Polygonize(g) FROM (VALUES ('POINT(1 1)'::geometry)) AS t(g)
----
GEOMETRYCOLLECTION EMPTY

query T
SELECT ST_Polygonize(g) FROM (VALUES ('LINESTRING EMPTY'::geometry)) AS t(g)
----
GEOMETRYCOLLECTION EMPTY

# NULLs are skipped
query T
SELECT ST_Polygonize(g) FROM (VALUES ('LINESTRING(0 0,1 0)'::geometry), (NULL::geometry), ('LINESTRING(1 0,1 1,0 0)'::geometry)) AS t(g)
----
GEOMETRYCOLLECTION(POLYGON((1 0,0 0,1 1,1 0)))

query T
SELECT ST_Polygonize(g) FROM (VALUES (NULL::geometry)) AS t(g)
----
NULL

# Z is kept, M dropped; SRID
query T
SELECT ST_Polygonize(g) FROM (VALUES ('LINESTRING Z (0 0 1,1 0 2,1 1 3,0 0 1)'::geometry)) AS t(g)
----
GEOMETRYCOLLECTION Z (POLYGON Z ((0 0 1,1 1 3,1 0 2,0 0 1)))

query T
SELECT ST_Polygonize(g) FROM (VALUES ('LINESTRING M (0 0 1,1 0 2,1 1 3,0 0 1)'::geometry)) AS t(g)
----
GEOMETRYCOLLECTION(POLYGON((0 0,1 1,1 0,0 0)))

query T
SELECT ST_Polygonize(g) FROM (VALUES ('SRID=4326;LINESTRING(0 0,1 0,1 1,0 0)'::geometry)) AS t(g)
----
SRID=4326;GEOMETRYCOLLECTION(POLYGON((0 0,1 1,1 0,0 0)))

# No rows give NULL
query T
SELECT ST_Polygonize(g) FROM (SELECT 'POINT(1 1)'::geometry AS g WHERE false) AS t
----
NULL

# GROUP BY
query IT rowsort
SELECT k, ST_Polygonize(g) FROM (VALUES (1, 'LINESTRING(0 0,1 0,1 1,0 0)'::geometry), (1, 'LINESTRING(5 5,6 5,6 6,5 5)'::geometry), (2, 'LINESTRING(0 0,1 1)'::geometry), (3, NULL::geometry)) AS t(k, g) GROUP BY k
----
1 GEOMETRYCOLLECTION(POLYGON((0 0,1 1,1 0,0 0)),POLYGON((5 5,6 6,6 5,5 5)))
2 GEOMETRYCOLLECTION EMPTY
3 NULL
