# Edge cases for ST_TileEnvelope, not covered by the PostGIS docs examples.

# Web Mercator tiles
query T
SELECT ST_AsEWKT(ST_TileEnvelope(0, 0, 0))
----
SRID=3857;POLYGON((-20037508.342789244 -20037508.342789244,-20037508.342789244 20037508.342789244,20037508.342789244 20037508.342789244,20037508.342789244 -20037508.342789244,-20037508.342789244 -20037508.342789244))

query T
SELECT ST_AsEWKT(ST_TileEnvelope(2, 1, 1))
----
SRID=3857;POLYGON((-10018754.171394622 0,-10018754.171394622 10018754.171394622,0 10018754.171394622,0 0,-10018754.171394622 0))

query T
SELECT ST_AsEWKT(ST_TileEnvelope(2, 3, 0))
----
SRID=3857;POLYGON((10018754.17139462 10018754.171394622,10018754.17139462 20037508.342789244,20037508.342789244 20037508.342789244,20037508.342789244 10018754.171394622,10018754.17139462 10018754.171394622))

query T
SELECT ST_AsEWKT(ST_TileEnvelope(30, 1, 1))
----
SRID=3857;POLYGON((-20037508.305466477 20037508.26814371,-20037508.305466477 20037508.305466477,-20037508.26814371 20037508.305466477,-20037508.26814371 20037508.26814371,-20037508.305466477 20037508.26814371))

query T
SELECT ST_AsEWKT(ST_TileEnvelope(31, 0, 0))
----
SRID=3857;POLYGON((-20037508.342789244 20037508.32412786,-20037508.342789244 20037508.342789244,-20037508.32412786 20037508.342789244,-20037508.32412786 20037508.32412786,-20037508.342789244 20037508.32412786))

query T
SELECT ST_AsEWKT(ST_TileEnvelope(12, 2048, 1361))
----
SRID=3857;POLYGON((0 6711782.579664756,0 6721566.51928526,9783.939620502293 6721566.51928526,9783.939620502293 6711782.579664756,0 6711782.579664756))

# Other bounds, which give the SRID
query T
SELECT ST_AsEWKT(ST_TileEnvelope(2, 1, 1, ST_MakeEnvelope(-180, -90, 180, 90, 4326)))
----
SRID=4326;POLYGON((-90 0,-90 45,0 45,0 0,-90 0))

query T
SELECT ST_AsText(ST_TileEnvelope(1, 0, 0, ST_MakeEnvelope(0, 0, 10, 10)))
----
POLYGON((0 5,0 10,5 10,5 5,0 5))

query T
SELECT ST_AsText(ST_TileEnvelope(1, 0, 0, ST_MakeEnvelope(10, 10, 0, 0)))
----
POLYGON((0 5,0 10,5 10,5 5,0 5))

query T
SELECT ST_AsEWKT(ST_TileEnvelope(1, 0, 0, 'SRID=4326;POLYGON((0 0,10 0,10 20,0 0))'::geometry))
----
SRID=4326;POLYGON((0 10,0 20,5 20,5 10,0 10))

query T
SELECT ST_AsText(ST_TileEnvelope(1, 0, 0, 'LINESTRING Z (0 0 0,10 10 10)'::geometry))
----
POLYGON((0 5,0 10,5 10,5 5,0 5))

query T
SELECT ST_AsText(ST_TileEnvelope(3, 5, 2, ST_MakeEnvelope(0.1, 0.2, 0.7, 1.3)))
----
POLYGON((0.475 0.8875,0.475 1.025,0.55 1.025,0.55 0.8875,0.475 0.8875))

# Margins, clipped to the bounds
query T
SELECT ST_AsText(ST_TileEnvelope(1, 0, 0, ST_MakeEnvelope(0, 0, 10, 10), 0.5))
----
POLYGON((0 2.5,0 10,7.5 10,7.5 2.5,0 2.5))

query T
SELECT ST_AsText(ST_TileEnvelope(1, 1, 1, ST_MakeEnvelope(0, 0, 10, 10), 0.5))
----
POLYGON((2.5 0,2.5 7.5,10 7.5,10 0,2.5 0))

query T
SELECT ST_AsText(ST_TileEnvelope(2, 1, 1, ST_MakeEnvelope(0, 0, 10, 10), 0.5))
----
POLYGON((1.25 3.75,1.25 8.75,6.25 8.75,6.25 3.75,1.25 3.75))

query T
SELECT ST_AsText(ST_TileEnvelope(1, 0, 0, ST_MakeEnvelope(0, 0, 10, 10), -0.25))
----
POLYGON((1.25 6.25,1.25 8.75,3.75 8.75,3.75 6.25,1.25 6.25))

query T
SELECT ST_AsText(ST_TileEnvelope(1, 0, 0, ST_MakeEnvelope(0, 0, 10, 10), -0.5))
----
POLYGON((2.5 7.5,2.5 7.5,2.5 7.5,2.5 7.5,2.5 7.5))

query T
SELECT ST_AsEWKT(ST_TileEnvelope(0, 0, 0, ST_MakeEnvelope(-20037508.342789244, -20037508.342789244, 20037508.342789244, 20037508.342789244, 3857), 1))
----
SRID=3857;POLYGON((-20037508.342789244 -20037508.342789244,-20037508.342789244 20037508.342789244,20037508.342789244 20037508.342789244,20037508.342789244 -20037508.342789244,-20037508.342789244 -20037508.342789244))

query T
SELECT ST_AsEWKT(ST_TileEnvelope(3, 1, 1, ST_MakeEnvelope(-20037508.342789244, -20037508.342789244, 20037508.342789244, 20037508.342789244, 3857), 0.5))
----
SRID=3857;POLYGON((-17532819.79994059 7514065.628545966,-17532819.79994059 17532819.79994059,-7514065.628545966 17532819.79994059,-7514065.628545966 7514065.628545966,-17532819.79994059 7514065.628545966))

# NULL
query T
SELECT ST_TileEnvelope(1, 0, NULL)
----
NULL

query T
SELECT ST_TileEnvelope(1, 0, 0, NULL::geometry)
----
NULL

query T
SELECT ST_TileEnvelope(1, 0, 0, ST_MakeEnvelope(0, 0, 10, 10), NULL)
----
NULL

# Errors
query error
SELECT ST_TileEnvelope(1, 2, 0)

query error
SELECT ST_TileEnvelope(1, 0, 2)

query error
SELECT ST_TileEnvelope(1, -1, 0)

query error
SELECT ST_TileEnvelope(-1, 0, 0)

query error
SELECT ST_TileEnvelope(32, 0, 0)

query error
SELECT ST_TileEnvelope(1, 0, 0, ST_MakeEnvelope(0, 0, 10, 10), -0.6)

query error
SELECT ST_TileEnvelope(1, 0, 0, 'POINT(1 1)'::geometry)

query error
SELECT ST_TileEnvelope(1, 0, 0, 'POINT EMPTY'::geometry)

# Columns
query IIIT rowsort
SELECT z, x, y, ST_AsText(ST_TileEnvelope(z, x, y, ST_MakeEnvelope(0, 0, 10, 10))) FROM (VALUES (0, 0, 0), (1, 1, 0), (2, 3, 3)) AS t(z, x, y)
----
0 0 0 POLYGON((0 0,0 10,10 10,10 0,0 0))
1 1 0 POLYGON((5 5,5 10,10 10,10 5,5 5))
2 3 3 POLYGON((7.5 0,7.5 2.5,10 2.5,10 0,7.5 0))
