# Edge cases for ST_MemUnion, not covered by the PostGIS docs examples.

# Unions
query T
SELECT ST_MemUnion(g) FROM (VALUES ('POLYGON((0 0,2 0,2 2,0 2,0 0))'::geometry), ('POLYGON((1 1,3 1,3 3,1 3,1 1))'::geometry)) AS t(g)
----
POLYGON((2 0,0 0,0 2,1 2,1 3,3 3,3 1,2 1,2 0))

query T
SELECT ST_MemUnion(g) FROM (VALUES ('POINT(1 2)'::geometry)) AS t(g)
----
POINT(1 2)

query T
SELECT ST_MemUnion(g) FROM (VALUES ('POINT(1 2)'::geometry), ('POINT(1 2)'::geometry)) AS t(g)
----
POINT(1 2)

query T
SELECT ST_MemUnion(g) FROM (VALUES ('LINESTRING(0 0,2 0)'::geometry), ('LINESTRING(1 0,3 0)'::geometry)) AS t(g)
----
MULTILINESTRING((0 0,1 0),(1 0,2 0),(2 0,3 0))

query T
SELECT ST_MemUnion(g) FROM (VALUES ('POLYGON((0 0,1 0,1 1,0 0))'::geometry), ('POINT(5 5)'::geometry), ('LINESTRING(3 3,4 4)'::geometry)) AS t(g)
----
GEOMETRYCOLLECTION(POINT(5 5),LINESTRING(3 3,4 4),POLYGON((1 1,1 0,0 0,1 1)))

query T
SELECT ST_MemUnion(g) FROM (VALUES ('GEOMETRYCOLLECTION(POINT(1 1),POINT(1 1))'::geometry)) AS t(g)
----
GEOMETRYCOLLECTION(POINT(1 1),POINT(1 1))

# NULLs are skipped, EMPTY geometries left out
query T
SELECT ST_MemUnion(g) FROM (VALUES ('POINT(1 2)'::geometry), (NULL::geometry), ('POINT(3 4)'::geometry)) AS t(g)
----
MULTIPOINT((1 2),(3 4))

query T
SELECT ST_MemUnion(g) FROM (VALUES ('POINT EMPTY'::geometry), ('POINT(1 1)'::geometry)) AS t(g)
----
POINT(1 1)

query T
SELECT ST_MemUnion(g) FROM (VALUES ('POINT(1 1)'::geometry), ('POINT EMPTY'::geometry), ('POINT(1 1)'::geometry)) AS t(g)
----
POINT(1 1)

query T
SELECT ST_MemUnion(g) FROM (VALUES (NULL::geometry)) AS t(g)
----
NULL

# All EMPTY
query T
SELECT ST_MemUnion(g) FROM (VALUES ('POINT EMPTY'::geometry)) AS t(g)
----
POINT EMPTY

query T
SELECT ST_MemUnion(g) FROM (VALUES ('POLYGON EMPTY'::geometry), ('LINESTRING EMPTY'::geometry)) AS t(g)
----
LINESTRING EMPTY

query T
SELECT ST_MemUnion(g) FROM (VALUES ('MULTIPOLYGON EMPTY'::geometry), ('POINT EMPTY'::geometry)) AS t(g)
----
POINT EMPTY

query T
SELECT ST_MemUnion(g) FROM (VALUES ('POINT EMPTY'::geometry), ('MULTIPOLYGON EMPTY'::geometry)) AS t(g)
----
MULTIPOLYGON EMPTY

query T
SELECT ST_MemUnion(g) FROM (VALUES ('LINESTRING EMPTY'::geometry), ('GEOMETRYCOLLECTION EMPTY'::geometry)) AS t(g)
----
GEOMETRYCOLLECTION EMPTY

query T
SELECT ST_MemUnion(g) FROM (VALUES ('POINT EMPTY'::geometry), ('LINESTRING EMPTY'::geometry), ('MULTIPOINT EMPTY'::geometry)) AS t(g)
----
MULTIPOINT EMPTY

query T
SELECT ST_MemUnion(g) FROM (VALUES ('MULTILINESTRING EMPTY'::geometry), ('POINT Z EMPTY'::geometry)) AS t(g)
----
POINT Z EMPTY

query T
SELECT ST_MemUnion(g) FROM (VALUES ('POINT M EMPTY'::geometry)) AS t(g)
----
POINT M EMPTY

query T
SELECT ST_MemUnion(g) FROM (VALUES ('GEOMETRYCOLLECTION EMPTY'::geometry)) AS t(g)
----
GEOMETRYCOLLECTION EMPTY

# Z is kept, M dropped
query T
SELECT ST_MemUnion(g) FROM (VALUES ('POINT M (1 2 3)'::geometry)) AS t(g)
----
POINT M (1 2 3)

query T
SELECT ST_MemUnion(g) FROM (VALUES ('POINT M (1 2 3)'::geometry), ('POINT M (3 4 5)'::geometry)) AS t(g)
----
MULTIPOINT((1 2),(3 4))

query T
SELECT ST_MemUnion(g) FROM (VALUES ('POINT Z (1 2 3)'::geometry), ('POINT Z (1 2 5)'::geometry)) AS t(g)
----
POINT Z (1 2 3)

query T
SELECT ST_MemUnion(g) FROM (VALUES ('POINT EMPTY'::geometry), ('POINT Z (1 2 3)'::geometry)) AS t(g)
----
POINT Z (1 2 3)

# SRID
query T
SELECT ST_MemUnion(g) FROM (VALUES ('SRID=4326;POINT(1 2)'::geometry), ('SRID=4326;POINT(3 4)'::geometry)) AS t(g)
----
SRID=4326;MULTIPOINT((1 2),(3 4))

# No rows give NULL
query T
SELECT ST_MemUnion(g) FROM (SELECT 'POINT(1 1)'::geometry AS g WHERE false) AS t
----
NULL

# GROUP BY
query IT rowsort
SELECT k, ST_MemUnion(g) FROM (VALUES (1, 'POINT(1 2)'::geometry), (1, 'POINT(3 4)'::geometry), (2, 'LINESTRING(0 0,1 1)'::geometry), (3, NULL::geometry)) AS t(k, g) GROUP BY k
----
1 MULTIPOINT((1 2),(3 4))
2 LINESTRING(0 0,1 1)
3 NULL

# Mixed dimensions are an error
statement error
SELECT ST_MemUnion(g) FROM (VALUES ('POINT Z (1 2 3)'::geometry), ('POINT(3 4)'::geometry)) AS t(g)
