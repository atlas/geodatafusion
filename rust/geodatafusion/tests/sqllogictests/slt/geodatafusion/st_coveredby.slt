# ST_CoveredBy with constant and column arguments in both positions, and NULL constants.

# Constant first argument, column second
query TT rowsort
SELECT ST_AsText(g), ST_CoveredBy('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, g)
FROM (VALUES ('POINT(5 5)'::geometry), ('POINT(20 20)'::geometry), ('POLYGON((0 0,20 0,20 20,0 20,0 0))'::geometry)) AS t(g)
----
POINT(20 20) false
POINT(5 5) false
POLYGON((0 0,20 0,20 20,0 20,0 0)) true

# Column first argument, constant second
query TT rowsort
SELECT ST_AsText(g), ST_CoveredBy(g, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry)
FROM (VALUES ('POINT(5 5)'::geometry), ('POINT(20 20)'::geometry), ('POLYGON((0 0,20 0,20 20,0 20,0 0))'::geometry)) AS t(g)
----
POINT(20 20) false
POINT(5 5) true
POLYGON((0 0,20 0,20 20,0 20,0 0)) false

# Column arguments on both sides
query TTT rowsort
SELECT ST_AsText(a), ST_AsText(b), ST_CoveredBy(a, b)
FROM (VALUES
  ('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 'POINT(5 5)'::geometry),
  ('POINT(5 5)'::geometry, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry)
) AS t(a, b)
----
POINT(5 5) POLYGON((0 0,10 0,10 10,0 10,0 0)) true
POLYGON((0 0,10 0,10 10,0 10,0 0)) POINT(5 5) false

# NULL constant first argument
query T rowsort
SELECT ST_CoveredBy(NULL::geometry, g)
FROM (VALUES ('POINT(5 5)'::geometry), ('POINT(20 20)'::geometry)) AS t(g)
----
NULL
NULL

# NULL constant second argument
query T rowsort
SELECT ST_CoveredBy(g, NULL::geometry)
FROM (VALUES ('POINT(5 5)'::geometry), ('POINT(20 20)'::geometry)) AS t(g)
----
NULL
NULL

# Point, line and polygon pairs
query T
SELECT ST_CoveredBy('POINT(5 5)'::geometry, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry)
----
true

query T
SELECT ST_CoveredBy('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 'POINT(5 5)'::geometry)
----
false

query T
SELECT ST_CoveredBy('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 'POINT(10 5)'::geometry)
----
false

query T
SELECT ST_CoveredBy('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 'LINESTRING(-5 5,15 5)'::geometry)
----
false

query T
SELECT ST_CoveredBy('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 'POLYGON((5 5,15 5,15 15,5 15,5 5))'::geometry)
----
false

query T
SELECT ST_CoveredBy('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 'POLYGON((10 0,20 0,20 10,10 10,10 0))'::geometry)
----
false

query T
SELECT ST_CoveredBy('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 'POLYGON((0 0,0 10,10 10,10 0,0 0))'::geometry)
----
true

query T
SELECT ST_CoveredBy('LINESTRING(0 0,10 10)'::geometry, 'LINESTRING(0 10,10 0)'::geometry)
----
false

query T
SELECT ST_CoveredBy('MULTIPOINT((1 1),(20 20))'::geometry, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry)
----
false

query T
SELECT ST_CoveredBy('GEOMETRYCOLLECTION(POINT(5 5),LINESTRING(1 1,2 2))'::geometry, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry)
----
true

query T
SELECT ST_CoveredBy('POINT Z (5 5 1)'::geometry, 'POLYGON M ((0 0 1,10 0 1,10 10 1,0 10 1,0 0 1))'::geometry)
----
true

# EMPTY inputs
query T
SELECT ST_CoveredBy('POINT EMPTY'::geometry, 'POINT(1 1)'::geometry)
----
false

query T
SELECT ST_CoveredBy('POINT(1 1)'::geometry, 'POLYGON EMPTY'::geometry)
----
false

query T
SELECT ST_CoveredBy('POINT EMPTY'::geometry, 'POINT EMPTY'::geometry)
----
false

query T
SELECT ST_CoveredBy('GEOMETRYCOLLECTION(POINT EMPTY,POINT(1 1))'::geometry, 'POINT(1 1)'::geometry)
----
true

query T
SELECT ST_CoveredBy('POLYGON EMPTY'::geometry, 'GEOMETRYCOLLECTION(LINESTRING EMPTY,POINT(1 1))'::geometry)
----
false

# SRID
query T
SELECT ST_CoveredBy('SRID=4326;POINT(1 1)'::geometry, 'SRID=4326;POINT(1 1)'::geometry)
----
true

statement error
SELECT ST_CoveredBy('SRID=4326;POINT(1 1)'::geometry, 'SRID=3857;POINT(1 1)'::geometry)

# NULL
query T
SELECT ST_CoveredBy(NULL::geometry, 'POINT(1 1)'::geometry)
----
NULL

# Columns on both sides
query T rowsort
SELECT ST_CoveredBy(a, b) FROM (VALUES ('POINT(5 5)'::geometry, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry), ('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 'POINT(5 5)'::geometry), ('POINT(1 1)'::geometry, NULL::geometry)) AS t(a, b)
----
NULL
false
true
