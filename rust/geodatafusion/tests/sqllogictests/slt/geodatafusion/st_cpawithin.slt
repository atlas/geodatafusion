# Edge cases for ST_CPAWithin, not covered by the PostGIS docs examples.

# Crossing tracks meet
query T
SELECT ST_CPAWithin('LINESTRING M (0 0 0, 10 0 10)'::geometry, 'LINESTRING M (0 5 0, 10 -5 10)'::geometry, 2)
----
true

query T
SELECT ST_CPAWithin('LINESTRING M (0 0 0, 10 0 10)'::geometry, 'LINESTRING M (10 0 0, 0 0 10)'::geometry, 2)
----
true

# Several segments
query T
SELECT ST_CPAWithin('LINESTRING M (0 0 0, 2 0 2, 4 1 4, 9 9 10)'::geometry, 'LINESTRING M (5 5 1, 3 2 3, 1 1 5, 0 7 9)'::geometry, 2)
----
true

query T
SELECT ST_CPAWithin('LINESTRING M (0 0 0, 10 0 10, 10 10 20)'::geometry, 'LINESTRING M (20 0 5, 12 3 15, 5 5 25)'::geometry, 2)
----
false

# Only the shared M range counts; ties go to the earliest time
query T
SELECT ST_CPAWithin('LINESTRING M (0 0 0, 10 0 10)'::geometry, 'LINESTRING M (0 3 0, 10 3 10)'::geometry, 3)
----
true

query T
SELECT ST_CPAWithin('LINESTRING M (0 0 0, 10 0 10)'::geometry, 'LINESTRING M (0 3 0, 10 3 10)'::geometry, 2.999)
----
false

query T
SELECT ST_CPAWithin('LINESTRING M (0 0 0, 10 0 10)'::geometry, 'LINESTRING M (0 3 5, 10 3 10)'::geometry, 2)
----
false

query T
SELECT ST_CPAWithin('LINESTRING M (0 0 0, 10 0 10)'::geometry, 'LINESTRING M (0 5 10, 10 -5 30)'::geometry, 2)
----
false

# Ranges that don't overlap
query T
SELECT ST_CPAWithin('LINESTRING M (0 0 0, 10 0 10)'::geometry, 'LINESTRING M (0 5 20, 10 -5 30)'::geometry, 2)
----
false

# 3D if either track has Z
query T
SELECT ST_CPAWithin('LINESTRING ZM (0 0 0 0, 10 0 0 10)'::geometry, 'LINESTRING ZM (0 5 3 0, 10 -5 3 10)'::geometry, 2)
----
false

query T
SELECT ST_CPAWithin('LINESTRING ZM (0 0 4 0, 10 0 4 10)'::geometry, 'LINESTRING M (0 5 0, 10 -5 10)'::geometry, 2)
----
false

query T
SELECT ST_CPAWithin('LINESTRING M (0 5 0, 10 -5 10)'::geometry, 'LINESTRING ZM (0 0 4 0, 10 0 4 10)'::geometry, 2)
----
false

# Tracks must be linestrings with M and at least two points
query error
SELECT ST_CPAWithin('LINESTRING(0 0, 10 0)'::geometry, 'LINESTRING M (0 0 0, 10 0 10)'::geometry, 1)

query error
SELECT ST_CPAWithin('POINT M (0 0 0)'::geometry, 'LINESTRING M (0 0 0, 10 0 10)'::geometry, 1)

query error
SELECT ST_CPAWithin('LINESTRING M EMPTY'::geometry, 'LINESTRING M (0 0 0, 10 0 10)'::geometry, 1)

query error
SELECT ST_CPAWithin('LINESTRING M (0 0 0, 10 0 10)'::geometry, 'POLYGON M ((0 0 0, 1 0 1, 1 1 2, 0 0 0))'::geometry, 1)

# NULL
query T
SELECT ST_CPAWithin(NULL::geometry, 'LINESTRING M (0 0 0, 10 0 10)'::geometry, 1)
----
NULL

query T
SELECT ST_CPAWithin('LINESTRING M (0 0 0, 10 0 10)'::geometry, 'LINESTRING M (0 3 0, 10 3 10)'::geometry, NULL)
----
NULL

query T
SELECT ST_CPAWithin('LINESTRING M (0 0 0, 10 0 10)'::geometry, 'LINESTRING M (0 3 0, 10 3 10)'::geometry, -1)
----
false
