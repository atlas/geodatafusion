# Edge cases for ST_RemoveSmallParts, not covered by the PostGIS docs examples.

# Parts narrower or lower than the minimum are removed
query T
SELECT ST_AsText(ST_RemoveSmallParts('MULTIPOLYGON(((0 0,10 0,10 10,0 0)),((20 20,21 20,21 21,20 20)))'::geometry, 5, 5))
----
MULTIPOLYGON(((0 0,10 0,10 10,0 0)))

query T
SELECT ST_AsText(ST_RemoveSmallParts('MULTILINESTRING((0 0,10 0),(20 20,21 21))'::geometry, 5, 5))
----
MULTILINESTRING EMPTY

query T
SELECT ST_AsText(ST_RemoveSmallParts('MULTILINESTRING((0 0,10 0),(20 20,21 21))'::geometry, 5, 0))
----
MULTILINESTRING((0 0,10 0))

query T
SELECT ST_AsText(ST_RemoveSmallParts('MULTILINESTRING((0 0,5 5))'::geometry, 5, 5))
----
MULTILINESTRING((0 0,5 5))

query T
SELECT ST_AsText(ST_RemoveSmallParts('POLYGON((0 0,10 0,10 10,0 0),(1 1,2 1,2 2,1 1))'::geometry, 5, 5))
----
POLYGON((0 0,10 0,10 10,0 0))

query T
SELECT ST_AsText(ST_RemoveSmallParts('LINESTRING(0 0,1 1)'::geometry, 5, 5))
----
LINESTRING EMPTY

query T
SELECT ST_AsText(ST_RemoveSmallParts('POLYGON((0 0,1 0,1 1,0 0))'::geometry, 5, 5))
----
POLYGON EMPTY

query T
SELECT ST_AsText(ST_RemoveSmallParts('MULTIPOLYGON(((0 0,10 0,10 1,0 0)))'::geometry, 5, 5))
----
MULTIPOLYGON EMPTY

query T
SELECT ST_AsText(ST_RemoveSmallParts('MULTIPOLYGON(((0 0,10 0,10 1,0 0)))'::geometry, 5, 0))
----
MULTIPOLYGON(((0 0,10 0,10 1,0 0)))

query T
SELECT ST_AsText(ST_RemoveSmallParts('MULTIPOLYGON(((0 0,10 0,10 1,0 0)))'::geometry, 0, 5))
----
MULTIPOLYGON EMPTY

query T
SELECT ST_AsText(ST_RemoveSmallParts('MULTIPOLYGON(((0 0,10 0,10 1,0 0)))'::geometry, -1, -1))
----
MULTIPOLYGON(((0 0,10 0,10 1,0 0)))

# Points and collections are unchanged
query T
SELECT ST_AsText(ST_RemoveSmallParts('MULTIPOINT((0 0),(1 1))'::geometry, 5, 5))
----
MULTIPOINT((0 0),(1 1))

query T
SELECT ST_AsText(ST_RemoveSmallParts('GEOMETRYCOLLECTION(LINESTRING(0 0,1 1),LINESTRING(0 0,10 10))'::geometry, 5, 5))
----
GEOMETRYCOLLECTION(LINESTRING(0 0,1 1),LINESTRING(0 0,10 10))

# Z, M, the SRID, EMPTY and NULL
query T
SELECT ST_AsEWKT(ST_RemoveSmallParts('SRID=4326;MULTILINESTRING Z ((0 0 1,10 10 2),(0 0 1,1 1 1))'::geometry, 5, 5))
----
SRID=4326;MULTILINESTRING((0 0 1,10 10 2))

query T
SELECT ST_AsText(ST_RemoveSmallParts('MULTIPOLYGON EMPTY'::geometry, 5, 5))
----
MULTIPOLYGON EMPTY

query T
SELECT ST_RemoveSmallParts(NULL::geometry, 5, 5)
----
NULL

query T
SELECT ST_AsText(ST_RemoveSmallParts('LINESTRING(0 0,1 1)'::geometry, NULL, 5))
----
NULL
