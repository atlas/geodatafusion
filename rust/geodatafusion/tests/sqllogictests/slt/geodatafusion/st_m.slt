# Edge cases for ST_M, not covered by the PostGIS docs examples.

# Every dimension
query R
SELECT ST_M('POINT(1 2)'::geometry)
----
NULL

query R
SELECT ST_M('POINT Z (1 2 3)'::geometry)
----
NULL

query R
SELECT ST_M('POINT M (1 2 3)'::geometry)
----
3

query R
SELECT ST_M('POINT ZM (1 2 3 4)'::geometry)
----
4

# WKB input
query R
SELECT ST_M(ST_GeomFromEWKT('SRID=4326;POINT ZM (1 2 3 4)'))
----
4

# EMPTY and NULL
query R
SELECT ST_M('POINT EMPTY'::geometry)
----
NULL

query R
SELECT ST_M(NULL::geometry)
----
NULL

# Other geometry types are an error
statement error
SELECT ST_M('LINESTRING(0 0,1 1)'::geometry)

statement error
SELECT ST_M('MULTIPOINT(1 2)'::geometry)

# A column, including NULL
query R rowsort
SELECT ST_M(g) FROM (VALUES ('POINT ZM (1 2 3 4)'::geometry), (NULL::geometry), ('POINT(5 6)'::geometry)) AS t(g)
----
4
NULL
NULL
