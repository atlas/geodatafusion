# Edge cases for ST_InteriorRingN, not covered by the PostGIS docs examples.

# Each interior ring
query T
SELECT ST_AsText(ST_InteriorRingN('POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 1),(3 3,3.5 3,3.5 3.5,3 3))'::geometry, 1))
----
LINESTRING(1 1,2 1,2 2,1 1)

query T
SELECT ST_AsText(ST_InteriorRingN('POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 1),(3 3,3.5 3,3.5 3.5,3 3))'::geometry, 2))
----
LINESTRING(3 3,3.5 3,3.5 3.5,3 3)

# Out of range
query T
SELECT ST_AsText(ST_InteriorRingN('POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 1),(3 3,3.5 3,3.5 3.5,3 3))'::geometry, 3))
----
NULL

query T
SELECT ST_AsText(ST_InteriorRingN('POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 1),(3 3,3.5 3,3.5 3.5,3 3))'::geometry, 0))
----
NULL

query T
SELECT ST_AsText(ST_InteriorRingN('POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 1),(3 3,3.5 3,3.5 3.5,3 3))'::geometry, -1))
----
NULL

query T
SELECT ST_AsText(ST_InteriorRingN('POLYGON((0 0,1 0,1 1,0 0))'::geometry, 1))
----
NULL

# Other types, including MULTIPOLYGON, give NULL
query T
SELECT ST_AsText(ST_InteriorRingN('MULTIPOLYGON(((0 0,4 0,4 4,0 0),(1 1,2 1,2 2,1 1)))'::geometry, 1))
----
NULL

query T
SELECT ST_AsText(ST_InteriorRingN('LINESTRING(0 0,1 1,1 0,0 0)'::geometry, 1))
----
NULL

query T
SELECT ST_AsText(ST_InteriorRingN('GEOMETRYCOLLECTION(POLYGON((0 0,4 0,4 4,0 0),(1 1,2 1,2 2,1 1)))'::geometry, 1))
----
NULL

# EMPTY
query T
SELECT ST_AsText(ST_InteriorRingN('POLYGON EMPTY'::geometry, 1))
----
NULL

query T
SELECT ST_AsText(ST_InteriorRingN('POINT EMPTY'::geometry, 1))
----
NULL

# Z, M and the SRID are kept
query T
SELECT ST_AsEWKT(ST_InteriorRingN('SRID=4326;POLYGON M ((0 0 1,4 0 1,4 4 1,0 0 1),(1 1 2,2 1 2,2 2 2,1 1 2))'::geometry, 1))
----
SRID=4326;LINESTRINGM(1 1 2,2 1 2,2 2 2,1 1 2)

query T
SELECT ST_AsEWKT(ST_InteriorRingN('SRID=3857;POLYGON ZM ((0 0 1 5,4 0 1 5,4 4 1 5,0 0 1 5),(1 1 2 6,2 1 2 6,2 2 2 6,1 1 2 6))'::geometry, 1))
----
SRID=3857;LINESTRING(1 1 2 6,2 1 2 6,2 2 2 6,1 1 2 6)

# NULL
query T
SELECT ST_InteriorRingN(NULL::geometry, 1)
----
NULL

query T
SELECT ST_AsText(ST_InteriorRingN('POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 1),(3 3,3.5 3,3.5 3.5,3 3))'::geometry, NULL))
----
NULL

# Columns for both arguments
query IT rowsort
SELECT n, ST_AsText(ST_InteriorRingN(g, n)) FROM (VALUES ('POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 1),(3 3,3.5 3,3.5 3.5,3 3))'::geometry, 1), ('POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 1),(3 3,3.5 3,3.5 3.5,3 3))'::geometry, 2), (NULL::geometry, 1), ('POLYGON((0 0,4 0,4 4,0 4,0 0),(1 1,2 1,2 2,1 1),(3 3,3.5 3,3.5 3.5,3 3))'::geometry, NULL)) AS t(g, n)
----
1 LINESTRING(1 1,2 1,2 2,1 1)
1 NULL
2 LINESTRING(3 3,3.5 3,3.5 3.5,3 3)
NULL NULL
