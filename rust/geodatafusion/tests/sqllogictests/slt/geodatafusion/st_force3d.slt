# Edge cases for ST_Force3D, not covered by the PostGIS docs examples.

# Every dimension
query T
SELECT ST_AsEWKT(ST_Force3D('POINT(1 2)'::geometry, 7))
----
POINT(1 2 7)

query T
SELECT ST_AsEWKT(ST_Force3D('POINT Z (1 2 3)'::geometry, 7))
----
POINT(1 2 3)

query T
SELECT ST_AsEWKT(ST_Force3D('POINT M (1 2 4)'::geometry, 7))
----
POINT(1 2 7)

query T
SELECT ST_AsEWKT(ST_Force3D('POINT ZM (1 2 3 4)'::geometry, 7))
----
POINT(1 2 3)

# Every geometry type, and the SRID
query T
SELECT ST_AsEWKT(ST_Force3D('SRID=4326;LINESTRING M (0 0 1,1 1 2)'::geometry, 7))
----
SRID=4326;LINESTRING(0 0 7,1 1 7)

query T
SELECT ST_AsEWKT(ST_Force3D('POLYGON Z ((0 0 1,4 0 1,4 4 1,0 0 1))'::geometry, 7))
----
POLYGON((0 0 1,4 0 1,4 4 1,0 0 1))

query T
SELECT ST_AsEWKT(ST_Force3D('MULTIPOINT ZM ((1 2 3 4),(5 6 7 8))'::geometry, 7))
----
MULTIPOINT(1 2 3,5 6 7)

query T
SELECT ST_AsEWKT(ST_Force3D('GEOMETRYCOLLECTION(POINT(1 2),LINESTRING(0 0,1 1))'::geometry, 7))
----
GEOMETRYCOLLECTION(POINT(1 2 7),LINESTRING(0 0 7,1 1 7))

# EMPTY keeps the new dimension
query T
SELECT ST_AsEWKT(ST_Force3D('POINT EMPTY'::geometry, 7))
----
POINT EMPTY

query I
SELECT ST_Zmflag(ST_Force3D('POINT EMPTY'::geometry, 7))
----
2

query I
SELECT ST_Zmflag(ST_Force3D('GEOMETRYCOLLECTION ZM EMPTY'::geometry, 7))
----
2

# NULL
query T
SELECT ST_Force3D(NULL::geometry, 7)
----
NULL
