# Edge cases for ST_GeogFromWKB, not covered by the PostGIS docs examples.

query T
SELECT ST_AsEWKT(ST_GeogFromWKB(decode('0101000000000000000000F03F0000000000000040', 'hex')))
----
SRID=4326;POINT(1 2)

query T
SELECT ST_AsEWKT(ST_GeogFromWKB(decode('0101000020AD100000000000000000F03F0000000000000040', 'hex')))
----
SRID=4269;POINT(1 2)

query T
SELECT ST_AsEWKT(ST_GeogFromWKB(decode('0101000000000000000020674000000000000059C0', 'hex')))
----
SRID=4326;POINT(-175 -80)

query error
SELECT ST_GeogFromWKB(decode('0101000020110f0000000000000000f03f0000000000000040', 'hex'))

query T
SELECT ST_GeogFromWKB(NULL)
----
NULL
