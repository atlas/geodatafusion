# Edge cases for ST_ChaikinSmoothing, not covered by the PostGIS docs examples.

# Lines keep their end points
query T
SELECT ST_AsText(ST_ChaikinSmoothing('LINESTRING(0 0,8 8,0 16)'::geometry))
----
LINESTRING(0 0,6 6,6 10,0 16)

query T
SELECT ST_AsText(ST_ChaikinSmoothing('LINESTRING(0 0,8 8,0 16)'::geometry, 2))
----
LINESTRING(0 0,4.5 4.5,6 7,6 9,4.5 11.5,0 16)

query T
SELECT ST_AsText(ST_ChaikinSmoothing('LINESTRING(0 0,8 8,0 16)'::geometry, 5))
----
LINESTRING(0 0,1.8984375 1.8984375,2.8359375 2.8515625,3.4453125 3.4921875,3.9375 4.03125,4.3125 4.46875,4.640625 4.875,4.921875 5.25,5.15625 5.59375,5.34375 5.90625,5.5078125 6.2109375,5.6484375 6.5078125,5.765625 6.796875,5.859375 7.078125,5.9296875 7.3515625,5.9765625 7.6171875,6 7.875,6 8.125,5.9765625 8.3828125,5.9296875 8.6484375,5.859375 8.921875,5.765625 9.203125,5.6484375 9.4921875,5.5078125 9.7890625,5.34375 10.09375,5.15625 10.40625,4.921875 10.75,4.640625 11.125,4.3125 11.53125,3.9375 11.96875,3.4453125 12.5078125,2.8359375 13.1484375,1.8984375 14.1015625,0 16)

query T
SELECT ST_AsText(ST_ChaikinSmoothing('LINESTRING(0 0,8 8,0 16)'::geometry, 1, true))
----
LINESTRING(0 0,6 6,6 10,0 16)

query T
SELECT ST_AsText(ST_ChaikinSmoothing('LINESTRING(0 0,1 0,2 0,3 0)'::geometry, 1, true))
----
LINESTRING(0 0,0.75 0,1.25 0,1.75 0,2.25 0,3 0)

query T
SELECT ST_AsText(ST_ChaikinSmoothing('LINESTRING(0 0,8 8)'::geometry))
----
LINESTRING(0 0,8 8)

query T
SELECT ST_AsText(ST_ChaikinSmoothing('LINESTRING(0 0.1,0.3 0.7,1.1 0.3)'::geometry, 3))
----
LINESTRING(0 0.1,0.1265625 0.353125,0.2 0.46875,0.2625 0.53125,0.328125 0.56875,0.396875 0.58125,0.4859375 0.571875,0.5953125 0.540625,0.7625 0.46875,1.1 0.3)

# Rings keep their first point only on request
query T
SELECT ST_AsText(ST_ChaikinSmoothing('POLYGON((0 0,8 8,0 16,0 0))'::geometry))
----
POLYGON((2 2,6 6,6 10,2 14,0 12,0 4,2 2))

query T
SELECT ST_AsText(ST_ChaikinSmoothing('POLYGON((0 0,8 8,0 16,0 0))'::geometry, 1, true))
----
POLYGON((0 0,6 6,6 10,2 14,0 12,0 0))

query T
SELECT ST_AsText(ST_ChaikinSmoothing('POLYGON((0 0,8 8,0 16,0 0))'::geometry, 2))
----
POLYGON((3 3,5 5,6 7,6 9,5 11,3 13,1.5 13.5,0.5 12.5,0 10,0 6,0.5 3.5,1.5 2.5,3 3))

query T
SELECT ST_AsText(ST_ChaikinSmoothing('MULTIPOLYGON(((0 0,8 8,0 16,0 0)),((20 0,28 8,20 16,20 0)))'::geometry))
----
MULTIPOLYGON(((2 2,6 6,6 10,2 14,0 12,0 4,2 2)),((22 2,26 6,26 10,22 14,20 12,20 4,22 2)))

# Z, and M only for XYZM
query T
SELECT ST_AsText(ST_ChaikinSmoothing('LINESTRING Z (0 0 0,8 8 8,0 16 0)'::geometry))
----
LINESTRING Z (0 0 0,6 6 6,6 10 6,0 16 0)

query T
SELECT ST_AsText(ST_ChaikinSmoothing('LINESTRING M (0 0 4,8 8 8,0 16 4)'::geometry))
----
LINESTRING M (0 0 4,6 6 0,6 10 0,0 16 4)

query T
SELECT ST_AsText(ST_ChaikinSmoothing('LINESTRING ZM (0 0 0 0,8 8 8 8,0 16 0 0)'::geometry))
----
LINESTRING ZM (0 0 0 0,6 6 6 6,6 10 6 6,0 16 0 0)

query T
SELECT ST_AsText(ST_ChaikinSmoothing('POLYGON M ((0 0 4,8 8 4,0 16 4,0 0 4))'::geometry))
----
POLYGON M ((2 2 0,6 6 0,6 10 0,2 14 0,0 12 0,0 4 0,2 2 0))

# Points, collections, EMPTY, the SRID and NULL
query T
SELECT ST_AsText(ST_ChaikinSmoothing('POINT(1 1)'::geometry))
----
POINT(1 1)

query T
SELECT ST_AsText(ST_ChaikinSmoothing('MULTIPOINT((1 1),(2 2))'::geometry))
----
MULTIPOINT((1 1),(2 2))

query T
SELECT ST_AsText(ST_ChaikinSmoothing('GEOMETRYCOLLECTION(LINESTRING(0 0,8 8,0 16),POINT(1 1))'::geometry))
----
GEOMETRYCOLLECTION(LINESTRING(0 0,6 6,6 10,0 16),POINT(1 1))

query T
SELECT ST_AsText(ST_ChaikinSmoothing('LINESTRING EMPTY'::geometry))
----
LINESTRING EMPTY

query T
SELECT ST_AsEWKT(ST_ChaikinSmoothing('SRID=4326;LINESTRING(0 0,8 8,0 16)'::geometry))
----
SRID=4326;LINESTRING(0 0,6 6,6 10,0 16)

query T
SELECT ST_ChaikinSmoothing(NULL::geometry)
----
NULL

query T
SELECT ST_AsText(ST_ChaikinSmoothing('LINESTRING(0 0,8 8,0 16)'::geometry, NULL))
----
NULL

# 1 to 5 iterations
query error
SELECT ST_ChaikinSmoothing('LINESTRING(0 0,8 8,0 16)'::geometry, 0)

query error
SELECT ST_ChaikinSmoothing('LINESTRING(0 0,8 8,0 16)'::geometry, 6)
