# Edge cases for ST_Zmflag, not covered by the PostGIS docs examples.

# Every dimension
query I
SELECT ST_Zmflag('POINT(1 2)'::geometry)
----
0

query I
SELECT ST_Zmflag('POINT Z (1 2 3)'::geometry)
----
2

query I
SELECT ST_Zmflag('POINT M (1 2 3)'::geometry)
----
1

query I
SELECT ST_Zmflag('POINT ZM (1 2 3 4)'::geometry)
----
3

query I
SELECT ST_Zmflag('MULTIPOLYGON M (((0 0 1,1 0 1,1 1 1,0 0 1)))'::geometry)
----
1

query I
SELECT ST_Zmflag('GEOMETRYCOLLECTION Z (POINT Z (1 2 3))'::geometry)
----
2

# EMPTY keeps the dimension it was written with
query I
SELECT ST_Zmflag('POINT EMPTY'::geometry)
----
0

query I
SELECT ST_Zmflag('POINT Z EMPTY'::geometry)
----
2

query I
SELECT ST_Zmflag('LINESTRING M EMPTY'::geometry)
----
1

query I
SELECT ST_Zmflag('GEOMETRYCOLLECTION ZM EMPTY'::geometry)
----
3

query I
SELECT ST_Zmflag(NULL::geometry)
----
NULL

# A column, including NULL
query I rowsort
SELECT ST_Zmflag(g) FROM (VALUES ('POINT ZM (1 2 3 4)'::geometry), (NULL::geometry), ('LINESTRING(0 0,1 1)'::geometry), ('POINT M (1 2 3)'::geometry)) AS t(g)
----
0
1
3
NULL
