# Edge cases for ST_Distance, not covered by the PostGIS docs examples.

# NULL arguments
query R
SELECT ST_Distance(NULL::geometry, 'POINT(0 0)'::geometry)
----
NULL

query R
SELECT ST_Distance('POINT(0 0)'::geometry, NULL::geometry)
----
NULL

# Same SRID
query R
SELECT ST_Distance(ST_SetSRID('POINT(0 0)'::geometry, 4326), ST_SetSRID('POINT(3 4)'::geometry, 4326))
----
5

# Mixed SRIDs are an error
statement error
SELECT ST_Distance(ST_SetSRID('POINT(0 0)'::geometry, 4326), ST_SetSRID('POINT(3 4)'::geometry, 3857))

# Wrong argument types are an error
statement error
SELECT ST_Distance('POINT(0 0)'::geometry, 1)

# Edge cases recorded with the native implementation.

# Points, lines and polygons
query R
SELECT ST_Distance('POINT(0 0)'::geometry, 'POINT(3 4)'::geometry)
----
5

query R
SELECT ST_Distance('POINT(0 0)'::geometry, 'LINESTRING(-1 1,1 1)'::geometry)
----
1

query R
SELECT ST_Distance('POINT(0 0)'::geometry, 'LINESTRING(2 0,3 0)'::geometry)
----
2

query R
SELECT ST_Distance('LINESTRING(0 0,10 10)'::geometry, 'LINESTRING(0 10,10 0)'::geometry)
----
0

query R
SELECT ST_Distance('LINESTRING(0 0,1 0)'::geometry, 'LINESTRING(2 1,3 5)'::geometry)
----
1.41421356237

query R
SELECT ST_Distance('POINT(5 5)'::geometry, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry)
----
0

query R
SELECT ST_Distance('POINT(5 5)'::geometry, 'POLYGON((0 0,10 0,10 10,0 10,0 0),(4 4,6 4,6 6,4 6,4 4))'::geometry)
----
1

query R
SELECT ST_Distance('POINT(10 5)'::geometry, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry)
----
0

query R
SELECT ST_Distance('LINESTRING(2 2,3 3)'::geometry, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry)
----
0

query R
SELECT ST_Distance('LINESTRING(-5 5,5 5)'::geometry, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry)
----
0

query R
SELECT ST_Distance('POLYGON((1 1,2 1,2 2,1 1))'::geometry, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry)
----
0

query R
SELECT ST_Distance('POLYGON((0 0,1 0,1 1,0 0))'::geometry, 'POLYGON((3 0,4 0,4 1,3 0))'::geometry)
----
2

query R
SELECT ST_Distance('POLYGON((4.5 4.5,5.5 4.5,5.5 5.5,4.5 4.5))'::geometry, 'POLYGON((0 0,10 0,10 10,0 10,0 0),(4 4,6 4,6 6,4 6,4 4))'::geometry)
----
0.5

# A point a rounding error from a line or ring
query R
SELECT ST_Distance('LINESTRING(5 3,4 4)'::geometry, 'POINT(4.5 3.4999999999999996)'::geometry)
----
0.000000000000000314018491737

# Invalid polygons: a hole sticking out of the shell is ignored from outside
query R
SELECT ST_Distance('POLYGON((0 0,10 0,10 10,0 10,0 0),(5 5,15 5,15 7,5 7,5 5))'::geometry, 'POINT(20 6)'::geometry)
----
10

query R
SELECT ST_Distance('POLYGON((0 0,2 0,0 2,2 2,0 0))'::geometry, 'POINT(1 0.5)'::geometry)
----
0

# Collections
query R
SELECT ST_Distance('MULTIPOINT((10 10),(3 4))'::geometry, 'POINT(0 0)'::geometry)
----
5

query R
SELECT ST_Distance('GEOMETRYCOLLECTION(POINT EMPTY,POINT(3 4))'::geometry, 'POINT(0 0)'::geometry)
----
5

query R
SELECT ST_Distance('MULTIPOINT(EMPTY,(3 4))'::geometry, 'POINT(0 0)'::geometry)
----
5

query R
SELECT ST_Distance('GEOMETRYCOLLECTION(LINESTRING(10 0,10 10),POLYGON((0 0,1 0,1 1,0 0)))'::geometry, 'POINT(3 0)'::geometry)
----
2

# Z and M are ignored
query R
SELECT ST_Distance('POINT Z (0 0 0)'::geometry, 'POINT Z (3 4 100)'::geometry)
----
5

query R
SELECT ST_Distance('POINT M (0 0 7)'::geometry, 'LINESTRING M (3 0 1,3 4 2)'::geometry)
----
3

# EMPTY gives NULL
query R
SELECT ST_Distance('POINT EMPTY'::geometry, 'POINT(0 0)'::geometry)
----
NULL

query R
SELECT ST_Distance('POINT(0 0)'::geometry, 'GEOMETRYCOLLECTION EMPTY'::geometry)
----
NULL

query R
SELECT ST_Distance('MULTIPOLYGON EMPTY'::geometry, 'POLYGON EMPTY'::geometry)
----
NULL

# A column, including NULL
query R rowsort
SELECT ST_Distance(g, 'POINT(0 0)'::geometry) FROM (VALUES ('POINT(3 4)'::geometry), (NULL::geometry), ('POINT EMPTY'::geometry)) AS t(g)
----
5
NULL
NULL

# Geography
query R
SELECT ST_Distance('POINT(0 0)'::geography, 'POINT(1 0)'::geography)
----
111319.490793

query R
SELECT ST_Distance('POINT(0 0)'::geography, 'POINT(1 0)'::geography, false)
----
111195.079735

query R
SELECT ST_Distance('POINT(0 0)'::geography, 'POINT(180 0)'::geography)
----
20003931.4586

query R
SELECT ST_Distance('POINT(0 0)'::geography, 'POINT(0 0)'::geography)
----
0

query R
SELECT ST_Distance('MULTIPOINT((0 0),(5 5))'::geography, 'POINT(1 2)'::geography)
----
247576.472648

# Geometry with geography is cast to geography
query R
SELECT ST_Distance('POINT(0 0)'::geography, 'POINT(1 2)'::geometry)
----
247576.472648

query R
SELECT ST_Distance('POINT(0 0)'::geometry, 'POINT(1 2)'::geometry, true)
----
247576.472648

query R
SELECT ST_Distance('SRID=4269;POINT(0 0)'::geography, 'SRID=4269;POINT(1 2)'::geography)
----
247576.472641

query R
SELECT ST_Distance('POINT Z(0 0 0)'::geography, 'POINT Z(1 0 1000)'::geography)
----
111319.490793

query R
SELECT ST_Distance('POINT EMPTY'::geography, 'POINT(1 2)'::geography)
----
NULL

query R
SELECT ST_Distance('POINT(0 0)'::geography, 'POINT(1 0)'::geography, NULL)
----
NULL

query error
SELECT ST_Distance('POINT(0 0)'::geography, 'SRID=4269;POINT(1 2)'::geography)

# Geography lines and polygons: the nearest points on the sphere, measured on the spheroid
query R
SELECT ST_Distance('POINT(0 0.5)'::geography, 'LINESTRING(1 0,1 1)'::geography)
----
111315.280032

query R
SELECT ST_Distance('POINT(0 0.5)'::geography, 'LINESTRING(1 0,1 1)'::geography, false)
----
111190.845337

query R
SELECT ST_Distance('LINESTRING(0 0,1 1)'::geography, 'LINESTRING(0 1,1 0)'::geography)
----
0

query R
SELECT ST_Distance('LINESTRING(0 0,10 0)'::geography, 'LINESTRING(5 1,6 2)'::geography)
----
110574.388558

query R
SELECT ST_Distance('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geography, 'POINT(5 5)'::geography)
----
0

query R
SELECT ST_Distance('POLYGON((0 0,10 0,10 10,0 10,0 0),(4 4,6 4,6 6,4 6,4 4))'::geography, 'POINT(5 5)'::geography)
----
110898.66346

query R
SELECT ST_Distance('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geography, 'POLYGON((20 0,30 0,30 10,20 10,20 0))'::geography)
----
1096351.55457

query R
SELECT ST_Distance('LINESTRING(179 0,-179 0)'::geography, 'POINT(180 1)'::geography)
----
110574.388558

query R
SELECT ST_Distance('LINESTRING(-10 89,170 89)'::geography, 'POINT(0 0)'::geography)
----
9891969.06882

query R
SELECT ST_Distance('GEOMETRYCOLLECTION(POINT(0 0),LINESTRING(5 5,6 6))'::geography, 'MULTIPOLYGON(((5 4,7 4,7 5,5 4)))'::geography)
----
98912.9895721
