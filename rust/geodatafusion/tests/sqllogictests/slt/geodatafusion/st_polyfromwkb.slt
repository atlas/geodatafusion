# Edge cases for ST_PolyFromWKB, not covered by the PostGIS docs examples.

# The right type, with and without SRID
query T
SELECT ST_PolyFromWKB(ST_AsBinary('POLYGON((0 0,1 0,1 1,0 0))'::geometry))
----
POLYGON((0 0,1 0,1 1,0 0))

query T
SELECT ST_PolyFromWKB(ST_AsBinary('POLYGON((0 0,1 0,1 1,0 0))'::geometry), 4326)
----
SRID=4326;POLYGON((0 0,1 0,1 1,0 0))

query T
SELECT ST_PolyFromWKB(ST_AsEWKB('SRID=3857;POLYGON((0 0,1 0,1 1,0 0))'::geometry))
----
SRID=3857;POLYGON((0 0,1 0,1 1,0 0))

query T
SELECT ST_PolyFromWKB(ST_AsBinary('POLYGON EMPTY'::geometry))
----
POLYGON EMPTY

# Another type is NULL
query T
SELECT ST_PolyFromWKB(ST_AsBinary('MULTIPOLYGON(((0 0,1 0,1 1,0 0)))'::geometry))
----
NULL

# Truncated input is an error
statement error
SELECT ST_PolyFromWKB(decode('0101', 'hex'))

# NULL
query T
SELECT ST_PolyFromWKB(NULL)
----
NULL

query T
SELECT ST_PolyFromWKB(ST_AsBinary('POLYGON((0 0,1 0,1 1,0 0))'::geometry), NULL)
----
NULL
