# Edge cases for ST_SymDifference, not covered by the PostGIS docs examples.

# Overlapping, disjoint and touching inputs
query T
SELECT ST_SymDifference('POLYGON((0 0,2 0,2 2,0 2,0 0))'::geometry, 'POLYGON((1 1,3 1,3 3,1 3,1 1))'::geometry)
----
MULTIPOLYGON(((2 0,0 0,0 2,1 2,1 1,2 1,2 0)),((2 2,1 2,1 3,3 3,3 1,2 1,2 2)))

query T
SELECT ST_SymDifference('POINT(0 0)'::geometry, 'POINT(1 1)'::geometry)
----
MULTIPOINT((0 0),(1 1))

query T
SELECT ST_SymDifference('LINESTRING(0 0,2 2)'::geometry, 'POLYGON((1 1,3 1,3 3,1 3,1 1))'::geometry)
----
GEOMETRYCOLLECTION(POLYGON((1 3,3 3,3 1,1 1,1 3)),LINESTRING(0 0,1 1))

query T
SELECT ST_SymDifference('MULTIPOINT((0 0),(1.5 1.5))'::geometry, 'POLYGON((1 1,3 1,3 3,1 3,1 1))'::geometry)
----
GEOMETRYCOLLECTION(POLYGON((1 3,3 3,3 1,1 1,1 3)),POINT(0 0))

query T
SELECT ST_SymDifference('GEOMETRYCOLLECTION(POINT(1.5 1.5),LINESTRING(0 0,5 5))'::geometry, 'POLYGON((1 1,3 1,3 3,1 3,1 1))'::geometry)
----
GEOMETRYCOLLECTION(LINESTRING(0 0,1 1),LINESTRING(3 3,5 5),POLYGON((1 3,3 3,3 1,1 1,1 3)))

# gridSize
query T
SELECT ST_SymDifference('LINESTRING(0 0,2.3 2.3)'::geometry, 'POLYGON((1 1,3 1,3 3,1 3,1 1))'::geometry, 0.5)
----
GEOMETRYCOLLECTION(POLYGON((1 3,3 3,3 1,1 1,1 3)),LINESTRING(0 0,1 1))

query T
SELECT ST_SymDifference('POLYGON((0 0,2 0,2 2,0 2,0 0))'::geometry, 'POLYGON((1 1,3 1,3 3,1 3,1 1))'::geometry, -1)
----
MULTIPOLYGON(((2 0,0 0,0 2,1 2,1 1,2 1,2 0)),((2 2,1 2,1 3,3 3,3 1,2 1,2 2)))

query T
SELECT ST_SymDifference('POLYGON((0 0,2 0,2 2,0 2,0 0))'::geometry, 'POLYGON((1 1,3 1,3 3,1 3,1 1))'::geometry, NULL)
----
NULL

# Z kept, M dropped
query T
SELECT ST_SymDifference('LINESTRING Z (0 0 1,2 0 2)'::geometry, 'LINESTRING(1 -1,1 1)'::geometry)
----
MULTILINESTRING Z ((0 0 1,1 0 1.5),(1 0 1.5,2 0 2),(1 -1 1.5,1 0 1.5),(1 0 1.5,1 1 1.5))

query T
SELECT ST_SymDifference('LINESTRING M (0 0 1,4 4 2)'::geometry, 'POLYGON((1 1,3 1,3 3,1 3,1 1))'::geometry)
----
GEOMETRYCOLLECTION(POLYGON((3 1,1 1,1 3,3 3,3 1)),LINESTRING(0 0,1 1),LINESTRING(3 3,4 4))

query T
SELECT ST_SymDifference('POLYGON ZM ((0 0 1 5,2 0 1 5,2 2 1 5,0 2 1 5,0 0 1 5))'::geometry, 'POLYGON((1 1,3 1,3 3,1 3,1 1))'::geometry)
----
MULTIPOLYGON Z (((2 0 1,0 0 1,0 2 1,1 2 1,1 1 1,2 1 1,2 0 1)),((2 2 1,1 2 1,1 3 1,3 3 1,3 1 1,2 1 1,2 2 1)))

# EMPTY inputs
query T
SELECT ST_SymDifference('LINESTRING M (0 0 1,5 5 2)'::geometry, 'POINT EMPTY'::geometry)
----
LINESTRING M (0 0 1,5 5 2)

query T
SELECT ST_SymDifference('POINT M EMPTY'::geometry, 'POLYGON((1 1,3 1,3 3,1 3,1 1))'::geometry)
----
POLYGON((1 1,3 1,3 3,1 3,1 1))

query T
SELECT ST_SymDifference('POINT EMPTY'::geometry, 'LINESTRING M (0 0 1,5 5 2)'::geometry)
----
LINESTRING M (0 0 1,5 5 2)

query T
SELECT ST_SymDifference('POLYGON EMPTY'::geometry, 'POINT Z EMPTY'::geometry)
----
POLYGON EMPTY

# SRID
query T
SELECT ST_SymDifference('SRID=4326;POINT(1 1)'::geometry, 'SRID=4326;MULTIPOINT((1 1),(2 2))'::geometry)
----
SRID=4326;POINT(2 2)

statement error
SELECT ST_SymDifference('SRID=4326;POINT(1 1)'::geometry, 'SRID=3857;POINT(1 1)'::geometry)

# NULL
query T
SELECT ST_SymDifference(NULL::geometry, 'POLYGON((1 1,3 1,3 3,1 3,1 1))'::geometry)
----
NULL

query T
SELECT ST_SymDifference('POLYGON((0 0,2 0,2 2,0 2,0 0))'::geometry, NULL::geometry)
----
NULL

# Columns
query T rowsort
SELECT ST_SymDifference(a, b) FROM (VALUES ('POLYGON((0 0,2 0,2 2,0 2,0 0))'::geometry, 'POLYGON((1 1,3 1,3 3,1 3,1 1))'::geometry), ('POINT(1.5 1.5)'::geometry, 'POLYGON((1 1,3 1,3 3,1 3,1 1))'::geometry), (NULL::geometry, 'POLYGON((1 1,3 1,3 3,1 3,1 1))'::geometry)) AS t(a, b)
----
MULTIPOLYGON(((2 0,0 0,0 2,1 2,1 1,2 1,2 0)),((2 2,1 2,1 3,3 3,3 1,2 1,2 2)))
NULL
POLYGON((1 3,3 3,3 1,1 1,1 3))
