# Edge cases for ST_OrientedEnvelope, not covered by the PostGIS docs examples.

# Every type
query T
SELECT ST_OrientedEnvelope('POINT(1 2)'::geometry)
----
POINT(1 2)

query T
SELECT ST_OrientedEnvelope('MULTIPOINT((2 7),(4 2))'::geometry)
----
LINESTRING(2 7,4 2)

query T
SELECT ST_OrientedEnvelope('MULTIPOINT((0 0),(10 0),(5 8),(5 3))'::geometry)
----
POLYGON((10 0,0 0,0 8,10 8,10 0))

query T
SELECT ST_OrientedEnvelope('LINESTRING(3 7,10 20,5 10)'::geometry)
----
POLYGON((3 7,10 20,10.2981651376 19.8394495413,3.29816513761 6.83944954128,3 7))

query T
SELECT ST_OrientedEnvelope('POLYGON((0 0,10 0,10 10,0 10,0 0),(2 2,4 2,4 4,2 4,2 2))'::geometry)
----
POLYGON((0 0,0 10,10 10,10 0,0 0))

query T
SELECT ST_OrientedEnvelope('MULTIPOLYGON(((0 0,1 0,1 1,0 0)),((5 5,6 5,6 6,5 5)))'::geometry)
----
POLYGON((0 0,6 6,6.5 5.5,0.5 -0.5,0 0))

query T
SELECT ST_OrientedEnvelope('GEOMETRYCOLLECTION(POINT(1 1),LINESTRING(2 2,5 2))'::geometry)
----
POLYGON((5 2,1 1,0.823529411765 1.70588235294,4.82352941176 2.70588235294,5 2))

query T
SELECT ST_OrientedEnvelope('LINESTRING(0 0,1 1,2 2)'::geometry)
----
LINESTRING(0 0,2 2)

# Z and M
query T
SELECT ST_OrientedEnvelope('MULTIPOINT Z ((0 0 1),(10 0 2),(5 8 3))'::geometry)
----
POLYGON((10 0,0 0,0 8,10 8,10 0))

query T
SELECT ST_OrientedEnvelope('MULTIPOINT M ((0 0 1),(10 0 2),(5 8 3))'::geometry)
----
POLYGON((10 0,0 0,0 8,10 8,10 0))

query T
SELECT ST_OrientedEnvelope('LINESTRING ZM (0 0 1 5,10 0 2 6)'::geometry)
----
LINESTRING(0 0,10 0)

# SRID
query T
SELECT ST_OrientedEnvelope('SRID=4326;MULTIPOINT((0 0),(10 0),(5 8))'::geometry)
----
SRID=4326;POLYGON((10 0,0 0,0 8,10 8,10 0))

# EMPTY and NULL
query T
SELECT ST_OrientedEnvelope('POINT EMPTY'::geometry)
----
POLYGON EMPTY

query T
SELECT ST_OrientedEnvelope('POLYGON M EMPTY'::geometry)
----
POLYGON EMPTY

query T
SELECT ST_OrientedEnvelope('GEOMETRYCOLLECTION EMPTY'::geometry)
----
POLYGON EMPTY

query T
SELECT ST_OrientedEnvelope('MULTIPOINT(EMPTY,(1 1))'::geometry)
----
POINT(1 1)

query T
SELECT ST_OrientedEnvelope(NULL::geometry)
----
NULL

# A column, including NULL
query T rowsort
SELECT ST_OrientedEnvelope(g) FROM (VALUES ('MULTIPOINT((0 0),(10 0),(5 8))'::geometry), (NULL::geometry), ('POINT(1 2)'::geometry)) AS t(g)
----
NULL
POINT(1 2)
POLYGON((10 0,0 0,0 8,10 8,10 0))
