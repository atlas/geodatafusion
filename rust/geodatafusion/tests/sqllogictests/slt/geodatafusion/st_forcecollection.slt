# Edge cases for ST_ForceCollection, not covered by the PostGIS docs examples.

# Single geometries
query T
SELECT ST_AsText(ST_ForceCollection('POINT(1 2)'::geometry))
----
GEOMETRYCOLLECTION(POINT(1 2))

query T
SELECT ST_AsText(ST_ForceCollection('LINESTRING(0 0,1 1)'::geometry))
----
GEOMETRYCOLLECTION(LINESTRING(0 0,1 1))

query T
SELECT ST_AsText(ST_ForceCollection('POLYGON((0 0,1 0,1 1,0 0))'::geometry))
----
GEOMETRYCOLLECTION(POLYGON((0 0,1 0,1 1,0 0)))

# Collections
query T
SELECT ST_AsText(ST_ForceCollection('MULTIPOINT((1 2))'::geometry))
----
GEOMETRYCOLLECTION(POINT(1 2))

query T
SELECT ST_AsText(ST_ForceCollection('MULTIPOINT((1 2),(3 4))'::geometry))
----
GEOMETRYCOLLECTION(POINT(1 2),POINT(3 4))

query T
SELECT ST_AsText(ST_ForceCollection('MULTIPOINT(EMPTY,(1 1))'::geometry))
----
GEOMETRYCOLLECTION(POINT EMPTY,POINT(1 1))

query T
SELECT ST_AsText(ST_ForceCollection('MULTILINESTRING((0 0,1 1),(2 2,3 3))'::geometry))
----
GEOMETRYCOLLECTION(LINESTRING(0 0,1 1),LINESTRING(2 2,3 3))

query T
SELECT ST_AsText(ST_ForceCollection('MULTIPOLYGON(((0 0,1 0,1 1,0 0)),EMPTY)'::geometry))
----
GEOMETRYCOLLECTION(POLYGON((0 0,1 0,1 1,0 0)),POLYGON EMPTY)

query T
SELECT ST_AsText(ST_ForceCollection('GEOMETRYCOLLECTION(POINT(1 2))'::geometry))
----
GEOMETRYCOLLECTION(POINT(1 2))

query T
SELECT ST_AsText(ST_ForceCollection('GEOMETRYCOLLECTION(MULTIPOINT((1 2),(3 4)))'::geometry))
----
GEOMETRYCOLLECTION(MULTIPOINT((1 2),(3 4)))

# EMPTY
query T
SELECT ST_AsText(ST_ForceCollection('POINT EMPTY'::geometry))
----
GEOMETRYCOLLECTION(POINT EMPTY)

query T
SELECT ST_AsText(ST_ForceCollection('LINESTRING EMPTY'::geometry))
----
GEOMETRYCOLLECTION(LINESTRING EMPTY)

query T
SELECT ST_AsText(ST_ForceCollection('POLYGON EMPTY'::geometry))
----
GEOMETRYCOLLECTION(POLYGON EMPTY)

query T
SELECT ST_AsText(ST_ForceCollection('MULTIPOINT EMPTY'::geometry))
----
GEOMETRYCOLLECTION EMPTY

query T
SELECT ST_AsText(ST_ForceCollection('GEOMETRYCOLLECTION EMPTY'::geometry))
----
GEOMETRYCOLLECTION EMPTY

# Z, M and the SRID are kept
query T
SELECT ST_AsEWKT(ST_ForceCollection('SRID=4326;POINT ZM (1 2 3 4)'::geometry))
----
SRID=4326;GEOMETRYCOLLECTION(POINT(1 2 3 4))

query T
SELECT ST_AsEWKT(ST_ForceCollection('LINESTRING M (0 0 1,1 1 2)'::geometry))
----
GEOMETRYCOLLECTIONM(LINESTRINGM(0 0 1,1 1 2))

query T
SELECT ST_AsEWKT(ST_ForceCollection('SRID=3857;MULTIPOINT Z ((1 2 3),(4 5 6))'::geometry))
----
SRID=3857;GEOMETRYCOLLECTION(POINT(1 2 3),POINT(4 5 6))

query I
SELECT ST_Zmflag(ST_ForceCollection('POINT Z EMPTY'::geometry))
----
2

# NULL
query T
SELECT ST_ForceCollection(NULL::geometry)
----
NULL

# A column, including NULL
query T rowsort
SELECT ST_AsText(ST_ForceCollection(g)) FROM (VALUES ('POINT(1 2)'::geometry), (NULL::geometry), ('MULTIPOINT((1 2),(3 4))'::geometry)) AS t(g)
----
GEOMETRYCOLLECTION(POINT(1 2))
GEOMETRYCOLLECTION(POINT(1 2),POINT(3 4))
NULL
