# Edge cases for ST_MLineFromWKB, not covered by the PostGIS docs examples.

# The right type, with and without SRID
query T
SELECT ST_MLineFromWKB(ST_AsBinary('MULTILINESTRING((0 0,1 1))'::geometry))
----
MULTILINESTRING((0 0,1 1))

query T
SELECT ST_MLineFromWKB(ST_AsBinary('MULTILINESTRING((0 0,1 1))'::geometry), 4326)
----
SRID=4326;MULTILINESTRING((0 0,1 1))

query T
SELECT ST_MLineFromWKB(ST_AsEWKB('SRID=3857;MULTILINESTRING((0 0,1 1))'::geometry))
----
SRID=3857;MULTILINESTRING((0 0,1 1))

query T
SELECT ST_MLineFromWKB(ST_AsBinary('MULTILINESTRING EMPTY'::geometry))
----
MULTILINESTRING EMPTY

# Another type is NULL
query T
SELECT ST_MLineFromWKB(ST_AsBinary('LINESTRING(0 0,1 1)'::geometry))
----
NULL

# Truncated input is an error
statement error
SELECT ST_MLineFromWKB(decode('0101', 'hex'))

# NULL
query T
SELECT ST_MLineFromWKB(NULL)
----
NULL

query T
SELECT ST_MLineFromWKB(ST_AsBinary('MULTILINESTRING((0 0,1 1))'::geometry), NULL)
----
NULL
