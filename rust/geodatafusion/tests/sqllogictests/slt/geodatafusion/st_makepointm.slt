# Edge cases for ST_MakePointM, not covered by the PostGIS docs examples.

query T
SELECT ST_MakePointM(1.5, 2.5, 3.5)
----
POINT M (1.5 2.5 3.5)

# Integer and NULL coordinates
query T
SELECT ST_MakePointM(1, 2, 3)
----
POINT M (1 2 3)

query T
SELECT ST_MakePointM(1, 2, NULL)
----
NULL

# A column, including NULL
query T rowsort
SELECT ST_MakePointM(x, y, m) FROM (VALUES (1.0, 2.0, 3.0), (NULL, 3.0, 4.0), (4.0, 5.0, 6.0)) AS t(x, y, m)
----
NULL
POINT M (1 2 3)
POINT M (4 5 6)
