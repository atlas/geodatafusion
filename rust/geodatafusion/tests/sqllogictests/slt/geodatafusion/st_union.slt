# Edge cases for ST_Union, not covered by the PostGIS docs examples.

# Unions
query T
SELECT ST_Union('POLYGON((0 0,2 0,2 2,0 2,0 0))'::geometry, 'POLYGON((1 1,3 1,3 3,1 3,1 1))'::geometry)
----
POLYGON((2 0,0 0,0 2,1 2,1 3,3 3,3 1,2 1,2 0))

query T
SELECT ST_Union('POINT(1 2)'::geometry, 'POINT(1 2)'::geometry)
----
POINT(1 2)

query T
SELECT ST_Union('POINT(1 2)'::geometry, 'POINT(3 4)'::geometry)
----
MULTIPOINT((1 2),(3 4))

query T
SELECT ST_Union('LINESTRING(0 0,2 0)'::geometry, 'LINESTRING(1 0,3 0)'::geometry)
----
MULTILINESTRING((0 0,1 0),(1 0,2 0),(2 0,3 0))

# An EMPTY input returns the other unchanged
query T
SELECT ST_Union('POINT EMPTY'::geometry, 'POINT(3 4)'::geometry)
----
POINT(3 4)

query T
SELECT ST_Union('POINT(3 4)'::geometry, 'POINT EMPTY'::geometry)
----
POINT(3 4)

query T
SELECT ST_Union('POINT EMPTY'::geometry, 'LINESTRING EMPTY'::geometry)
----
LINESTRING EMPTY

query T
SELECT ST_Union('POINT M (1 2 3)'::geometry, 'POINT EMPTY'::geometry)
----
POINT M (1 2 3)

query T
SELECT ST_Union('POINT EMPTY'::geometry, 'POINT M (1 2 3)'::geometry)
----
POINT M (1 2 3)

query T
SELECT ST_Union('GEOMETRYCOLLECTION(POINT(1 1),POINT(1 1))'::geometry, 'POINT EMPTY'::geometry)
----
GEOMETRYCOLLECTION(POINT(1 1),POINT(1 1))

# Z is kept, M dropped
query T
SELECT ST_Union('POINT Z (1 2 3)'::geometry, 'POINT Z (3 4 5)'::geometry)
----
MULTIPOINT Z ((1 2 3),(3 4 5))

query T
SELECT ST_Union('POINT M (1 2 3)'::geometry, 'POINT(3 4)'::geometry)
----
MULTIPOINT((1 2),(3 4))

query T
SELECT ST_Union('POINT M (1 2 3)'::geometry, 'POINT M (1 2 3)'::geometry)
----
POINT(1 2)

# gridSize
query T
SELECT ST_Union('POINT(0.3 0.3)'::geometry, 'POINT(1.2 1.4)'::geometry, 0.5)
----
MULTIPOINT((0.5 0.5),(1 1.5))

query T
SELECT ST_Union('POINT(0.3 0.3)'::geometry, 'POINT(1.2 1.4)'::geometry, -1)
----
MULTIPOINT((0.3 0.3),(1.2 1.4))

query T
SELECT ST_Union('POLYGON((0 0,2 0,2 2,0 2,0 0))'::geometry, 'POLYGON((1 1,3 1,3 3,1 3,1 1))'::geometry, 0.5)
----
POLYGON((2 0,0 0,0 2,1 2,1 3,3 3,3 1,2 1,2 0))

# SRID and NULL
query T
SELECT ST_Union('SRID=4326;POINT(1 2)'::geometry, 'SRID=4326;POINT(3 4)'::geometry)
----
SRID=4326;MULTIPOINT((1 2),(3 4))

query T
SELECT ST_Union('POINT(1 2)'::geometry, NULL::geometry)
----
NULL

query T
SELECT ST_Union('POINT(0.3 0.3)'::geometry, 'POINT(1.2 1.4)'::geometry, NULL::float8)
----
NULL

# Mixed SRIDs are an error
statement error
SELECT ST_Union('SRID=4326;POINT(1 2)'::geometry, 'SRID=3857;POINT(3 4)'::geometry)
