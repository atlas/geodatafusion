query T
SELECT ST_Buffer('LINESTRING(0 0,10 0,10 10)'::geometry, 1, 'side=left')
----
POLYGON((10 10,10 0,0 0,0 1,9 1,9 10,10 10))

query T
SELECT ST_Buffer('LINESTRING(0 0,10 0,10 10)'::geometry, 1, 'side=right')
----
POLYGON((0 0,10 0,10 10,11 10,11 0,10.9807852804 -0.195090322016,10.9238795325 -0.382683432365,10.8314696123 -0.55557023302,10.7071067812 -0.707106781187,10.555570233 -0.831469612303,10.3826834324 -0.923879532511,10.195090322 -0.980785280403,10 -1,0 -1,0 0))

