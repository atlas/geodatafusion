SELECT ST_Buffer('LINESTRING(0 0,10 0,10 10)'::geometry, 1, 'quad_segs=abc')
----
POLYGON((9 1,9 10,10 11,11 10,11 0,10 -1,0 -1,-1 0,0 1,9 1))

query T
SELECT ST_Buffer('LINESTRING(0 0,10 0,10 10)'::geometry, 1, 'endcap=flat join=bevel quad_segs=1')
----
POLYGON((9 1,9 10,11 10,11 0,10 -1,0 -1,0 1,9 1))

