# Edge cases for ST_PointN, not covered by the PostGIS docs examples.

# From the start and from the end
query T
SELECT ST_AsText(ST_PointN('LINESTRING(0 0,1 1,2 2)'::geometry, 1))
----
POINT(0 0)

query T
SELECT ST_AsText(ST_PointN('LINESTRING(0 0,1 1,2 2)'::geometry, 3))
----
POINT(2 2)

query T
SELECT ST_AsText(ST_PointN('LINESTRING(0 0,1 1,2 2)'::geometry, -1))
----
POINT(2 2)

query T
SELECT ST_AsText(ST_PointN('LINESTRING(0 0,1 1,2 2)'::geometry, -3))
----
POINT(0 0)

# Out of range
query T
SELECT ST_AsText(ST_PointN('LINESTRING(0 0,1 1,2 2)'::geometry, 0))
----
NULL

query T
SELECT ST_AsText(ST_PointN('LINESTRING(0 0,1 1,2 2)'::geometry, 4))
----
NULL

query T
SELECT ST_AsText(ST_PointN('LINESTRING(0 0,1 1,2 2)'::geometry, -4))
----
NULL

# Only a LINESTRING has points
query T
SELECT ST_AsText(ST_PointN('POINT(1 1)'::geometry, 1))
----
NULL

query T
SELECT ST_AsText(ST_PointN('MULTILINESTRING((0 0,1 1))'::geometry, 1))
----
NULL

query T
SELECT ST_AsText(ST_PointN('POLYGON((0 0,1 0,1 1,0 0))'::geometry, 1))
----
NULL

query T
SELECT ST_AsText(ST_PointN('GEOMETRYCOLLECTION(LINESTRING(0 0,1 1))'::geometry, 1))
----
NULL

# EMPTY
query T
SELECT ST_AsText(ST_PointN('LINESTRING EMPTY'::geometry, 1))
----
NULL

query T
SELECT ST_AsText(ST_PointN('LINESTRING EMPTY'::geometry, -1))
----
NULL

# Z, M and the SRID are kept
query T
SELECT ST_AsEWKT(ST_PointN('SRID=4326;LINESTRING Z (0 0 1,1 1 2)'::geometry, 2))
----
SRID=4326;POINT(1 1 2)

query T
SELECT ST_AsEWKT(ST_PointN('LINESTRING M (0 0 1,1 1 2)'::geometry, -2))
----
POINTM(0 0 1)

query T
SELECT ST_AsEWKT(ST_PointN('SRID=3857;LINESTRING ZM (0 0 1 2,1 1 3 4)'::geometry, 1))
----
SRID=3857;POINT(0 0 1 2)

# NULL
query T
SELECT ST_PointN(NULL::geometry, 1)
----
NULL

query T
SELECT ST_AsText(ST_PointN('LINESTRING(0 0,1 1,2 2)'::geometry, NULL))
----
NULL

# Columns for both arguments
query IT rowsort
SELECT n, ST_AsText(ST_PointN(g, n)) FROM (VALUES ('LINESTRING(0 0,1 1,2 2)'::geometry, 1), ('LINESTRING(0 0,1 1,2 2)'::geometry, -1), (NULL::geometry, 1), ('LINESTRING(0 0,1 1,2 2)'::geometry, NULL)) AS t(g, n)
----
-1 POINT(2 2)
1 NULL
1 POINT(0 0)
NULL NULL
