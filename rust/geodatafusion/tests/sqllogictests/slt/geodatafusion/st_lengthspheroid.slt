# Edge cases for ST_LengthSpheroid, not covered by the PostGIS docs examples.

query R
SELECT ST_LengthSpheroid('LINESTRING(0 0,1 0,1 1)'::geometry, 'SPHEROID["WGS 84",6378137,298.257223563]')
----
221893.879351

# Z adds to each segment's length
query R
SELECT ST_LengthSpheroid('LINESTRING Z(0 0 0,1 0 1000)'::geometry, 'SPHEROID["WGS 84",6378137,298.257223563]')
----
111323.982279

# Polygon rings count, in collections too
query R
SELECT ST_LengthSpheroid('POLYGON((0 0,1 0,1 1,0 0))'::geometry, 'SPHEROID["WGS 84",6378137,298.257223563]')
----
378793.447642

query R
SELECT ST_LengthSpheroid('GEOMETRYCOLLECTION(LINESTRING(0 0,1 0),POLYGON((0 0,1 0,1 1,0 0)),POINT(5 5))'::geometry, 'SPHEROID["WGS 84",6378137,298.257223563]')
----
490112.938436

query R
SELECT ST_LengthSpheroid('MULTILINESTRING((0 0,1 0),(2 2,3 3))'::geometry, 'SPHEROID["WGS 84",6378137,298.257223563]')
----
268148.819909

query R
SELECT ST_LengthSpheroid('POINT(0 0)'::geometry, 'SPHEROID["WGS 84",6378137,298.257223563]')
----
0

query R
SELECT ST_LengthSpheroid('LINESTRING EMPTY'::geometry, 'SPHEROID["WGS 84",6378137,298.257223563]')
----
0

query R
SELECT ST_LengthSpheroid('LINESTRING(0 0,1 0)'::geometry, NULL)
----
NULL
