# Edge cases for ST_ForceRHR, not covered by the PostGIS docs examples.

# Exterior and interior rings are reversed as needed
query T
SELECT ST_AsText(ST_ForceRHR('POLYGON((0 0,4 0,4 4,0 0),(1 1,1 2,2 2,1 1))'::geometry))
----
POLYGON((0 0,4 4,4 0,0 0),(1 1,2 2,1 2,1 1))

query T
SELECT ST_AsText(ST_ForceRHR('POLYGON((0 0,0 4,4 4,0 0),(1 1,2 1,2 2,1 1))'::geometry))
----
POLYGON((0 0,0 4,4 4,0 0),(1 1,2 1,2 2,1 1))

query T
SELECT ST_AsText(ST_ForceRHR('POLYGON((0 0,4 0,4 4,0 0),(1 1,1 2,2 2,1 1),(3 1,3.5 1,3.5 2,3 1))'::geometry))
----
POLYGON((0 0,4 4,4 0,0 0),(1 1,2 2,1 2,1 1),(3 1,3.5 1,3.5 2,3 1))

query T
SELECT ST_AsText(ST_ForceRHR('MULTIPOLYGON(((0 0,4 0,4 4,0 0)),((5 5,5 6,6 6,5 5)))'::geometry))
----
MULTIPOLYGON(((0 0,4 4,4 0,0 0)),((5 5,5 6,6 6,5 5)))

query T
SELECT ST_AsText(ST_ForceRHR('GEOMETRYCOLLECTION(POLYGON((0 0,4 0,4 4,0 0)),LINESTRING(0 0,1 1))'::geometry))
----
GEOMETRYCOLLECTION(POLYGON((0 0,4 4,4 0,0 0)),LINESTRING(0 0,1 1))

# Rings with no area count as counter-clockwise
query T
SELECT ST_AsText(ST_ForceRHR('POLYGON((0 0,1 0,2 0,0 0))'::geometry))
----
POLYGON((0 0,2 0,1 0,0 0))

query T
SELECT ST_AsText(ST_ForceRHR('POLYGON((0 0,0 4,4 4,0 0),(1 1,2 1,3 1,1 1))'::geometry))
----
POLYGON((0 0,0 4,4 4,0 0),(1 1,2 1,3 1,1 1))

# Other types are unchanged
query T
SELECT ST_AsText(ST_ForceRHR('LINESTRING(0 0,1 1,1 0,0 0)'::geometry))
----
LINESTRING(0 0,1 1,1 0,0 0)

query T
SELECT ST_AsText(ST_ForceRHR('MULTIPOINT((1 1),(2 2))'::geometry))
----
MULTIPOINT((1 1),(2 2))

# Z, M and the SRID are kept
query T
SELECT ST_AsEWKT(ST_ForceRHR('SRID=4326;POLYGON ZM ((0 0 1 2,4 0 3 4,4 4 5 6,0 0 1 2))'::geometry))
----
SRID=4326;POLYGON((0 0 1 2,4 4 5 6,4 0 3 4,0 0 1 2))

query T
SELECT ST_AsEWKT(ST_ForceRHR('POLYGON M ((0 0 1,0 4 2,4 4 3,0 0 1))'::geometry))
----
POLYGONM((0 0 1,0 4 2,4 4 3,0 0 1))

# EMPTY and NULL
query T
SELECT ST_AsText(ST_ForceRHR('POLYGON EMPTY'::geometry))
----
POLYGON EMPTY

query T
SELECT ST_AsText(ST_ForceRHR('GEOMETRYCOLLECTION EMPTY'::geometry))
----
GEOMETRYCOLLECTION EMPTY

query T
SELECT ST_ForceRHR(NULL::geometry)
----
NULL
