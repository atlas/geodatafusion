# Edge cases for ST_Points.

# Every geometry type
query T
SELECT ST_AsText(ST_Points('POINT(1 2)'::geometry))
----
MULTIPOINT((1 2))

query T
SELECT ST_AsText(ST_Points('LINESTRING(0 0,1 1,0 0)'::geometry))
----
MULTIPOINT((0 0),(1 1),(0 0))

query T
SELECT ST_AsText(ST_Points('POLYGON((0 0,4 0,4 4,0 0),(1 1,2 1,2 2,1 1))'::geometry))
----
MULTIPOINT((0 0),(4 0),(4 4),(0 0),(1 1),(2 1),(2 2),(1 1))

query T
SELECT ST_AsText(ST_Points('MULTIPOINT((1 1),(1 1),(2 2))'::geometry))
----
MULTIPOINT((1 1),(1 1),(2 2))

query T
SELECT ST_AsText(ST_Points('MULTILINESTRING((0 0,1 1),(2 2,3 3))'::geometry))
----
MULTIPOINT((0 0),(1 1),(2 2),(3 3))

query T
SELECT ST_AsText(ST_Points('MULTIPOLYGON(((0 0,1 0,1 1,0 0)),((5 5,6 5,6 6,5 5)))'::geometry))
----
MULTIPOINT((0 0),(1 0),(1 1),(0 0),(5 5),(6 5),(6 6),(5 5))

query T
SELECT ST_AsText(ST_Points('GEOMETRYCOLLECTION(POINT(9 9),LINESTRING(0 0,1 1),POLYGON((0 0,1 0,1 1,0 0)))'::geometry))
----
MULTIPOINT((9 9),(0 0),(1 1),(0 0),(1 0),(1 1),(0 0))

# EMPTY
query T
SELECT ST_AsText(ST_Points('POINT EMPTY'::geometry))
----
MULTIPOINT EMPTY

query T
SELECT ST_AsText(ST_Points('LINESTRING EMPTY'::geometry))
----
MULTIPOINT EMPTY

query T
SELECT ST_AsText(ST_Points('GEOMETRYCOLLECTION EMPTY'::geometry))
----
MULTIPOINT EMPTY

query T
SELECT ST_AsText(ST_Points('MULTIPOINT(EMPTY,(1 1))'::geometry))
----
MULTIPOINT((1 1))

query T
SELECT ST_AsText(ST_Points('GEOMETRYCOLLECTION(POINT EMPTY,LINESTRING(0 0,1 1))'::geometry))
----
MULTIPOINT((0 0),(1 1))

query I
SELECT ST_Zmflag(ST_Points('POINT Z EMPTY'::geometry))
----
2

# Z, M and the SRID are kept
query T
SELECT ST_AsEWKT(ST_Points('SRID=4326;GEOMETRYCOLLECTION ZM (POINT ZM (1 1 1 1),POLYGON ZM ((0 0 1 2,1 0 1 2,1 1 1 2,0 0 1 2)))'::geometry))
----
SRID=4326;MULTIPOINT(1 1 1 1,0 0 1 2,1 0 1 2,1 1 1 2,0 0 1 2)

query T
SELECT ST_AsEWKT(ST_Points('LINESTRING M (0 0 1,1 1 2)'::geometry))
----
MULTIPOINTM(0 0 1,1 1 2)

query T
SELECT ST_AsEWKT(ST_Points('SRID=3857;MULTIPOINT Z ((1 2 3))'::geometry))
----
SRID=3857;MULTIPOINT(1 2 3)

# NULL
query T
SELECT ST_Points(NULL::geometry)
----
NULL

# A column, including NULL
query T rowsort
SELECT ST_AsText(ST_Points(g)) FROM (VALUES ('LINESTRING(0 0,1 1,2 2)'::geometry), (NULL::geometry), ('POINT(1 1)'::geometry)) AS t(g)
----
MULTIPOINT((0 0),(1 1),(2 2))
MULTIPOINT((1 1))
NULL
