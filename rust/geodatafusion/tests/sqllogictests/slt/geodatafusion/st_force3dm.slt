# Edge cases for ST_Force3DM, not covered by the PostGIS docs examples.

# Every dimension
query T
SELECT ST_AsEWKT(ST_Force3DM('POINT(1 2)'::geometry, 8))
----
POINTM(1 2 8)

query T
SELECT ST_AsEWKT(ST_Force3DM('POINT Z (1 2 3)'::geometry, 8))
----
POINTM(1 2 8)

query T
SELECT ST_AsEWKT(ST_Force3DM('POINT M (1 2 4)'::geometry, 8))
----
POINTM(1 2 4)

query T
SELECT ST_AsEWKT(ST_Force3DM('POINT ZM (1 2 3 4)'::geometry, 8))
----
POINTM(1 2 4)

# Every geometry type, and the SRID
query T
SELECT ST_AsEWKT(ST_Force3DM('SRID=4326;LINESTRING M (0 0 1,1 1 2)'::geometry, 8))
----
SRID=4326;LINESTRINGM(0 0 1,1 1 2)

query T
SELECT ST_AsEWKT(ST_Force3DM('POLYGON Z ((0 0 1,4 0 1,4 4 1,0 0 1))'::geometry, 8))
----
POLYGONM((0 0 8,4 0 8,4 4 8,0 0 8))

query T
SELECT ST_AsEWKT(ST_Force3DM('MULTIPOINT ZM ((1 2 3 4),(5 6 7 8))'::geometry, 8))
----
MULTIPOINTM(1 2 4,5 6 8)

query T
SELECT ST_AsEWKT(ST_Force3DM('GEOMETRYCOLLECTION(POINT(1 2),LINESTRING(0 0,1 1))'::geometry, 8))
----
GEOMETRYCOLLECTIONM(POINTM(1 2 8),LINESTRINGM(0 0 8,1 1 8))

# EMPTY keeps the new dimension
query T
SELECT ST_AsEWKT(ST_Force3DM('POINT EMPTY'::geometry, 8))
----
POINTM EMPTY

query I
SELECT ST_Zmflag(ST_Force3DM('POINT EMPTY'::geometry, 8))
----
1

query I
SELECT ST_Zmflag(ST_Force3DM('GEOMETRYCOLLECTION ZM EMPTY'::geometry, 8))
----
1

# NULL
query T
SELECT ST_Force3DM(NULL::geometry, 8)
----
NULL

# Default and NULL fill values
query T
SELECT ST_AsEWKT(ST_Force3DM('POINT(1 2)'::geometry))
----
POINTM(1 2 0)

query T
SELECT ST_AsEWKT(ST_Force3DM('POINT(1 2)'::geometry, NULL))
----
NULL
