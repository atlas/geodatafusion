# Edge cases for ST_AddMeasure, not covered by the PostGIS docs examples.

# Measures along the length
query T
SELECT ST_AsEWKT(ST_AddMeasure('LINESTRING(0 0,10 0,10 10)'::geometry, 0, 20))
----
LINESTRINGM(0 0 0,10 0 10,10 10 20)

query T
SELECT ST_AsEWKT(ST_AddMeasure('LINESTRING(0 0,3 1,7 -2)'::geometry, 0.3, 7.1))
----
LINESTRINGM(0 0 0.3,3 1 2.934496029714993,7 -2 7.1)

query T
SELECT ST_AsEWKT(ST_AddMeasure('LINESTRING(0 0,10 0)'::geometry, 10, 0))
----
LINESTRINGM(0 0 10,10 0 0)

query T
SELECT ST_AsEWKT(ST_AddMeasure('LINESTRING Z (0 0 1,10 0 2)'::geometry, 5, 15))
----
LINESTRING(0 0 1 5,10 0 2 15)

query T
SELECT ST_AsEWKT(ST_AddMeasure('LINESTRING M (0 0 1,10 0 2)'::geometry, 5, 15))
----
LINESTRINGM(0 0 5,10 0 15)

query T
SELECT ST_AsEWKT(ST_AddMeasure('LINESTRING ZM (0 0 1 9,10 0 2 9)'::geometry, 5, 15))
----
LINESTRING(0 0 1 5,10 0 2 15)

query T
SELECT ST_AsEWKT(ST_AddMeasure('MULTILINESTRING((0 0,10 0),(20 0,30 0))'::geometry, 0, 10))
----
MULTILINESTRINGM((0 0 0,10 0 5),(20 0 5,30 0 10))

query T
SELECT ST_AsEWKT(ST_AddMeasure('MULTILINESTRING((0 0,0 0),(1 1,2 2))'::geometry, 0, 10))
----
MULTILINESTRINGM((0 0 0,0 0 0),(1 1 0,2 2 10))

query T
SELECT ST_AsEWKT(ST_AddMeasure('MULTILINESTRING((0 0,10 0),EMPTY)'::geometry, 0, 10))
----
MULTILINESTRINGM((0 0 0,10 0 10),EMPTY)

query T
SELECT ST_AsEWKT(ST_AddMeasure('LINESTRING(0 0,0 0)'::geometry, 0, 10))
----
LINESTRINGM(0 0 0,0 0 10)

query T
SELECT ST_AsEWKT(ST_AddMeasure('LINESTRING(0 0,0 0,0 0)'::geometry, 0, 10))
----
LINESTRINGM(0 0 0,0 0 5,0 0 10)

query T
SELECT ST_AsEWKT(ST_AddMeasure('LINESTRING EMPTY'::geometry, 0, 10))
----
LINESTRINGM EMPTY

query T
SELECT ST_AsEWKT(ST_AddMeasure('SRID=4326;LINESTRING(0 0,10 0)'::geometry, 0, 1))
----
SRID=4326;LINESTRINGM(0 0 0,10 0 1)

# NULL
query T
SELECT ST_AddMeasure(NULL::geometry, 0, 1)
----
NULL

query T
SELECT ST_AsText(ST_AddMeasure('LINESTRING(0 0,10 0)'::geometry, NULL, 1))
----
NULL

# Only lines
query error
SELECT ST_AddMeasure('POINT(0 0)'::geometry, 0, 10)
