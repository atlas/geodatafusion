# Edge cases for ST_Force2D, not covered by the PostGIS docs examples.

# Every dimension
query T
SELECT ST_AsEWKT(ST_Force2D('POINT(1 2)'::geometry))
----
POINT(1 2)

query T
SELECT ST_AsEWKT(ST_Force2D('POINT Z (1 2 3)'::geometry))
----
POINT(1 2)

query T
SELECT ST_AsEWKT(ST_Force2D('POINT M (1 2 4)'::geometry))
----
POINT(1 2)

query T
SELECT ST_AsEWKT(ST_Force2D('POINT ZM (1 2 3 4)'::geometry))
----
POINT(1 2)

# Every geometry type, and the SRID
query T
SELECT ST_AsEWKT(ST_Force2D('SRID=4326;LINESTRING M (0 0 1,1 1 2)'::geometry))
----
SRID=4326;LINESTRING(0 0,1 1)

query T
SELECT ST_AsEWKT(ST_Force2D('POLYGON Z ((0 0 1,4 0 1,4 4 1,0 0 1))'::geometry))
----
POLYGON((0 0,4 0,4 4,0 0))

query T
SELECT ST_AsEWKT(ST_Force2D('MULTIPOINT ZM ((1 2 3 4),(5 6 7 8))'::geometry))
----
MULTIPOINT(1 2,5 6)

query T
SELECT ST_AsEWKT(ST_Force2D('GEOMETRYCOLLECTION(POINT(1 2),LINESTRING(0 0,1 1))'::geometry))
----
GEOMETRYCOLLECTION(POINT(1 2),LINESTRING(0 0,1 1))

# EMPTY keeps the new dimension
query T
SELECT ST_AsEWKT(ST_Force2D('POINT EMPTY'::geometry))
----
POINT EMPTY

query I
SELECT ST_Zmflag(ST_Force2D('POINT EMPTY'::geometry))
----
0

query I
SELECT ST_Zmflag(ST_Force2D('GEOMETRYCOLLECTION ZM EMPTY'::geometry))
----
0

# NULL
query T
SELECT ST_Force2D(NULL::geometry)
----
NULL
