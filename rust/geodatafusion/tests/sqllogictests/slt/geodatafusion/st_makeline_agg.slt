# Edge cases for ST_MakeLine_Agg, PostGIS's aggregate ST_MakeLine(geometry), not covered by the
# PostGIS docs examples. The PostGIS engine defines st_makeline_agg from PostGIS's own ST_MakeLine.

# Points, multipoints and lines, in input order
query T
SELECT ST_MakeLine_Agg(g) FROM (VALUES ('POINT(1 2)'::geometry), ('POINT(3 4)'::geometry)) AS t(g)
----
LINESTRING(1 2,3 4)

query T
SELECT ST_MakeLine_Agg(g) FROM (VALUES ('POINT(1 2)'::geometry)) AS t(g)
----
LINESTRING(1 2)

query T
SELECT ST_MakeLine_Agg(g) FROM (VALUES ('MULTIPOINT((0 0),(1 1))'::geometry), ('POINT(2 2)'::geometry)) AS t(g)
----
LINESTRING(0 0,1 1,2 2)

query T
SELECT ST_MakeLine_Agg(g) FROM (VALUES ('LINESTRING(0 0,1 1)'::geometry), ('LINESTRING(1 1,2 2)'::geometry)) AS t(g)
----
LINESTRING(0 0,1 1,2 2)

# Repeated points stay, except where a line starts
query T
SELECT ST_MakeLine_Agg(g) FROM (VALUES ('POINT(1 2)'::geometry), ('POINT(1 2)'::geometry), ('POINT(3 4)'::geometry)) AS t(g)
----
LINESTRING(1 2,1 2,3 4)

query T
SELECT ST_MakeLine_Agg(g) FROM (VALUES ('LINESTRING(0 0,1 1)'::geometry), ('POINT(1 1)'::geometry), ('POINT(1 1)'::geometry)) AS t(g)
----
LINESTRING(0 0,1 1,1 1,1 1)

query T
SELECT ST_MakeLine_Agg(g) FROM (VALUES ('POINT(1 1)'::geometry), ('LINESTRING(1 1,2 2)'::geometry)) AS t(g)
----
LINESTRING(1 1,2 2)

query T
SELECT ST_MakeLine_Agg(g) FROM (VALUES ('MULTIPOINT((0 0),(0 0))'::geometry), ('POINT(0 0)'::geometry)) AS t(g)
----
LINESTRING(0 0,0 0,0 0)

# Other geometry types, NULLs and EMPTY parts are skipped
query T
SELECT ST_MakeLine_Agg(g) FROM (VALUES ('POINT(0 0)'::geometry), ('POLYGON((0 0,1 0,1 1,0 0))'::geometry), ('POINT(2 2)'::geometry)) AS t(g)
----
LINESTRING(0 0,2 2)

query T
SELECT ST_MakeLine_Agg(g) FROM (VALUES ('MULTILINESTRING((0 0,1 1))'::geometry), ('POINT(2 2)'::geometry)) AS t(g)
----
LINESTRING(2 2)

query T
SELECT ST_MakeLine_Agg(g) FROM (VALUES ('GEOMETRYCOLLECTION(POINT(0 0))'::geometry), ('POINT(2 2)'::geometry)) AS t(g)
----
LINESTRING(2 2)

query T
SELECT ST_MakeLine_Agg(g) FROM (VALUES ('POINT(1 2)'::geometry), (NULL::geometry), ('POINT(3 4)'::geometry)) AS t(g)
----
LINESTRING(1 2,3 4)

query T
SELECT ST_MakeLine_Agg(g) FROM (VALUES ('MULTIPOINT(EMPTY,(1 1))'::geometry), ('POINT(2 2)'::geometry)) AS t(g)
----
LINESTRING(1 1,2 2)

query T
SELECT ST_MakeLine_Agg(g) FROM (VALUES ('POINT EMPTY'::geometry)) AS t(g)
----
LINESTRING EMPTY

# Nothing usable gives NULL
query T
SELECT ST_MakeLine_Agg(g) FROM (VALUES ('POLYGON((0 0,1 0,1 1,0 0))'::geometry)) AS t(g)
----
NULL

query T
SELECT ST_MakeLine_Agg(g) FROM (VALUES (NULL::geometry)) AS t(g)
----
NULL

# Z, M and SRID
query T
SELECT ST_MakeLine_Agg(g) FROM (VALUES ('POINT Z (1 2 3)'::geometry), ('POINT(3 4)'::geometry)) AS t(g)
----
LINESTRING Z (1 2 3,3 4 0)

query T
SELECT ST_MakeLine_Agg(g) FROM (VALUES ('POINT M (1 2 3)'::geometry), ('POINT M (3 4 5)'::geometry)) AS t(g)
----
LINESTRING M (1 2 3,3 4 5)

query T
SELECT ST_MakeLine_Agg(g) FROM (VALUES ('SRID=4326;POINT(1 2)'::geometry), ('SRID=4326;POINT(3 4)'::geometry)) AS t(g)
----
SRID=4326;LINESTRING(1 2,3 4)

# No rows give NULL
query T
SELECT ST_MakeLine_Agg(g) FROM (SELECT 'POINT(1 1)'::geometry AS g WHERE false) AS t
----
NULL

# ORDER BY inside the call
query T
SELECT ST_MakeLine_Agg(g ORDER BY i DESC) FROM (VALUES (1, 'POINT(1 2)'::geometry), (2, 'POINT(3 4)'::geometry), (3, 'POINT(5 6)'::geometry)) AS t(i, g)
----
LINESTRING(5 6,3 4,1 2)

# GROUP BY
query IT rowsort
SELECT k, ST_MakeLine_Agg(g ORDER BY i) FROM (VALUES (1, 1, 'POINT(1 2)'::geometry), (1, 2, 'POINT(3 4)'::geometry), (2, 3, 'LINESTRING(0 0,1 1)'::geometry), (3, 4, NULL::geometry)) AS t(k, i, g) GROUP BY k
----
1 LINESTRING(1 2,3 4)
2 LINESTRING(0 0,1 1)
3 NULL
