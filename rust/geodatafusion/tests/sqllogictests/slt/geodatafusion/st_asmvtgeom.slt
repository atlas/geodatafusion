# Edge cases for ST_AsMVTGeom, not covered by the PostGIS docs examples.

# Arguments: defaults, and NULL extent, buffer or clip_geom take the default
query T
SELECT ST_AsText(ST_AsMVTGeom('POINT(1 1)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10))))
----
POINT(410 3686)

query T
SELECT ST_AsText(ST_AsMVTGeom('POINT(1 1)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), NULL))
----
POINT(410 3686)

query T
SELECT ST_AsText(ST_AsMVTGeom('POINT(5 266)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, NULL))
----
POINT(5 -256)

query T
SELECT ST_AsText(ST_AsMVTGeom('POINT(5 267)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, NULL))
----
NULL

query T
SELECT ST_AsText(ST_AsMVTGeom('POINT(5 20)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0, NULL))
----
NULL

# NULL geometry, EMPTY geometries
query T
SELECT ST_AsText(ST_AsMVTGeom(NULL::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10))))
----
NULL

query T
SELECT ST_AsText(ST_AsMVTGeom(NULL::geometry, NULL))
----
NULL

query T
SELECT ST_AsText(ST_AsMVTGeom('POINT EMPTY'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10))))
----
NULL

query T
SELECT ST_AsText(ST_AsMVTGeom('POLYGON EMPTY'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10))))
----
NULL

query T
SELECT ST_AsText(ST_AsMVTGeom('GEOMETRYCOLLECTION EMPTY'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10))))
----
NULL

query T
SELECT ST_AsText(ST_AsMVTGeom('MULTIPOINT(1 1, EMPTY, 2 2)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
MULTIPOINT((1 9),(2 8))

# Invalid arguments are errors, checked before the geometry
query error
SELECT ST_AsText(ST_AsMVTGeom('POINT(1 1)'::geometry, NULL))

query error
SELECT ST_AsText(ST_AsMVTGeom('POINT EMPTY'::geometry, NULL))

query error
SELECT ST_AsText(ST_AsMVTGeom('POINT(1 1)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(0, 10))))

query error
SELECT ST_AsText(ST_AsMVTGeom('POINT EMPTY'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 0))

query error
SELECT ST_AsText(ST_AsMVTGeom('POINT(1 1)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), -10))

query error
SELECT ST_AsText(ST_AsMVTGeom('POINT(1 1)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 0)), 0))

# A geometry as bounds, and the SRID of the input
query T
SELECT ST_AsText(ST_AsMVTGeom('POINT(1 1)'::geometry, 'POLYGON((0 0, 10 0, 10 10, 0 10, 0 0))'::geometry, 10))
----
POINT(1 9)

query T
SELECT ST_AsEWKT(ST_AsMVTGeom('SRID=3857;POINT(1 1)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10))
----
SRID=3857;POINT(1 9)

query T
SELECT ST_AsEWKT(ST_AsMVTGeom('SRID=4326;LINESTRING(-5 5, 15 5)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
SRID=4326;LINESTRING(0 5,10 5)

query T
SELECT ST_AsEWKT(ST_AsMVTGeom('SRID=3857;POLYGON((1 1, 3 1, 3 3, 1 3, 1 1))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
SRID=3857;POLYGON((1 9,1 7,3 7,3 9,1 9))

# Transform: y points down, the scale may differ per axis, and halfway values round to even
query T
SELECT ST_AsText(ST_AsMVTGeom('POINT(1 1)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(20, 10)), 10))
----
POINT(0 9)

query T
SELECT ST_AsText(ST_AsMVTGeom('POINT(1 1)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(3, 3)), 4096))
----
POINT(1365 2731)

query T
SELECT ST_AsText(ST_AsMVTGeom('MULTIPOINT(0.5 5, 1.5 5, 2.5 5)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
MULTIPOINT((0 5),(2 5))

query T
SELECT ST_AsText(ST_AsMVTGeom('POINT(-1.5 5)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 2))
----
POINT(-2 5)

query T
SELECT ST_AsText(ST_AsMVTGeom('POINT(5 0.5)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
POINT(5 10)

query T
SELECT ST_AsText(ST_AsMVTGeom('POINT(5 11.5)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 2))
----
POINT(5 -2)

query T
SELECT ST_AsText(ST_AsMVTGeom('POINT(-81.463 -30)'::geometry, ST_MakeBox2D(ST_Point(-81.228, -34.236), ST_Point(-71.228, -24.236)), 1000, -1))
----
POINT(-24 576)

query T
SELECT ST_AsText(ST_AsMVTGeom('POINT(-57.335 -48.329)'::geometry, ST_MakeBox2D(ST_Point(-68.02, -73.526), ST_Point(-58.02, -41.672)), 1000, 64))
----
NULL

# Points: clipped after rounding, edges included
query T
SELECT ST_AsText(ST_AsMVTGeom('POINT(10.4 10)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
POINT(10 0)

query T
SELECT ST_AsText(ST_AsMVTGeom('POINT(10.6 10)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
NULL

query T
SELECT ST_AsText(ST_AsMVTGeom('POINT(11.4 10)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 1))
----
POINT(11 0)

query T
SELECT ST_AsText(ST_AsMVTGeom('POINT(-0.6 5)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
NULL

query T
SELECT ST_AsText(ST_AsMVTGeom('POINT(20 10)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0, false))
----
POINT(20 0)

# Multipoints are sorted, lose repeats in 2D, and become points
query T
SELECT ST_AsText(ST_AsMVTGeom('MULTIPOINT(1 1, 1 1, 2 2, 20 20, 1.2 1.1)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
MULTIPOINT((1 9),(2 8))

query T
SELECT ST_AsText(ST_AsMVTGeom('MULTIPOINT(1 3, 1 1, 3 1, 2 9)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
MULTIPOINT((1 7),(1 9),(2 1),(3 9))

query T
SELECT ST_AsText(ST_AsMVTGeom('MULTIPOINT(1 1, 20 20)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
POINT(1 9)

query T
SELECT ST_AsText(ST_AsMVTGeom('MULTIPOINT(20 20, 30 30)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
NULL

query T
SELECT ST_AsText(ST_AsMVTGeom('MULTIPOINT Z (1 1 1, 1 1 2, 3 3 3)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
MULTIPOINT Z ((1 9 1),(3 7 3))

# Z and M of points: kept, but clipping (by GEOS) drops M and points on the edges
query T
SELECT ST_AsText(ST_AsMVTGeom('POINT Z (1 1 5)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10))
----
POINT Z (1 9 5)

query T
SELECT ST_AsText(ST_AsMVTGeom('POINT M (1 1 5)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10))
----
POINT M (1 9 5)

query T
SELECT ST_AsText(ST_AsMVTGeom('MULTIPOINT M (1 1 1, 3 3 3)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
MULTIPOINT M ((1 9 1),(3 7 3))

query T
SELECT ST_AsText(ST_AsMVTGeom('MULTIPOINT ZM (1 1 1 1, 3 3 3 3, 20 20 5 5)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
MULTIPOINT Z ((1 9 1),(3 7 3))

query T
SELECT ST_AsText(ST_AsMVTGeom('MULTIPOINT(1 1, 9 9, 10 10)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
MULTIPOINT((1 9),(9 1),(10 0))

query T
SELECT ST_AsText(ST_AsMVTGeom('MULTIPOINT(1 1, 10 10, 11 11)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
POINT(1 9)

# A negative buffer is read as unsigned, so it doesn't clip
query T
SELECT ST_AsText(ST_AsMVTGeom('POINT(5 50)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, -1))
----
POINT(5 -40)

query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING(5 -50, 5 50)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, -1))
----
LINESTRING(5 60,5 -40)

query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING(-1e12 26.864, 1e12 61.915)'::geometry, ST_MakeBox2D(ST_Point(-5.643, 26.864), ST_Point(29.407, 61.915)), 10, -1))
----
LINESTRING(-4294967295 5,4294967305 5)

query T
SELECT ST_AsText(ST_AsMVTGeom('POLYGON((-50 -50, 50 -50, 50 50, -50 50, -50 -50))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, -1))
----
POLYGON((-50 60,-50 -40,50 -40,50 60,-50 60))

# Geometries smaller than half a tile unit both ways are dropped before rounding
query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING(1.25 1, 1.75 1)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
LINESTRING(1 9,2 9)

query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING(1.26 1, 1.75 1)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
NULL

query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING(1.45 1, 1.55 1)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0, false))
----
NULL

query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING(1 1, 1 1.9)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 20)), 10, 0))
----
NULL

query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING(1 1, 1 2)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 20)), 10, 0))
----
LINESTRING(1 10,1 9)

query T
SELECT ST_AsText(ST_AsMVTGeom('GEOMETRYCOLLECTION(LINESTRING(1.45 1, 1.55 1), POINT(5 5))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
LINESTRING(1 9,2 9)

query T
SELECT ST_AsText(ST_AsMVTGeom('POLYGON((1.45 1.45, 1.55 1.45, 1.55 1.55, 1.45 1.55, 1.45 1.45), (1.46 1.46, 5 1.46, 5 5, 1.46 1.46))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
NULL

# Lines: repeats and collinear points go, collapsed lines go
query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING(1 1, 2 2, 3 3)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
LINESTRING(1 9,3 7)

query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING(1 1, 1.2 1.2, 3 3)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
LINESTRING(1 9,3 7)

query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING(0 0, 5 0, 3 0, 10 0)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
LINESTRING(0 10,5 10,3 10,10 10)

query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING(1 1, 3 3, 1 1)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
LINESTRING(1 9,3 7,1 9)

query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING(1 1, 1.6 1)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
LINESTRING(1 9,2 9)

query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING(1 1, 0.6 1)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
NULL

query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING(1 1, 2 1.4, 3 1)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
LINESTRING(1 9,3 9)

query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING Z (1 1 1, 2 2 7, 3 3 3)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
LINESTRING Z (1 9 1,3 7 3)

query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING Z (-1.117 -90.868 4.401, 8.883 -80.868 -1.972, 8.883 -80.868 2)'::geometry, ST_MakeBox2D(ST_Point(-1.117, -90.868), ST_Point(8.883, -80.868)), 100, -1))
----
LINESTRING Z (0 100 4.401,100 0 2)

query T
SELECT ST_AsText(ST_AsMVTGeom('MULTILINESTRING((1 1, 1.1 1.1), (3 3, 4 4))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
LINESTRING(3 7,4 6)

query T
SELECT ST_AsText(ST_AsMVTGeom('MULTILINESTRING((3 3, 4 4), (1 1, 2 2), (1 1, 2 2))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
MULTILINESTRING((3 7,4 6),(1 9,2 8),(1 9,2 8))

# Lines are clipped by GEOS after rounding, then rounded again
query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING(-5 0.3, 15 3.3)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
LINESTRING(0 9,10 8)

query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING(-5 5, 5 5, 5 15, 7 15, 7 5, 15 5)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
MULTILINESTRING((0 5,5 5,5 0),(7 0,7 5,10 5))

query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING(0 -5, 0 15)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
NULL

query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING(0 0, 10 0, 10 10)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
LINESTRING(0 10,10 10,10 0)

query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING(20 20, 30 30)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
NULL

query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING(1 1, 9 1, 9 9, 20 9)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0, false))
----
LINESTRING(1 9,9 9,9 1,20 1)

query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING(-1e10 5, 1e10 5)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 4096, 0, false))
----
LINESTRING(-4096000000000 2048,4096000000000 2048)

# Z and M of lines: clipping interpolates Z and drops M
query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING Z (-5 5 1, 15 5 3)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
LINESTRING Z (0 5 1.5,10 5 2.5)

query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING M (-5 5 1, 15 5 3)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
LINESTRING(0 5,10 5)

query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING M (1 1 1, 3 3 3)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
LINESTRING M (1 9 1,3 7 3)

query T
SELECT ST_AsText(ST_AsMVTGeom('LINESTRING ZM (1 1 1 1, 3 3 3 3)'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
LINESTRING ZM (1 9 1 1,3 7 3 3)

# Polygons: made valid by Wagyu, in its orientation, whatever the input's
query T
SELECT ST_AsText(ST_AsMVTGeom('POLYGON((1 1, 3 1, 3 3, 1 3, 1 1))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
POLYGON((1 9,1 7,3 7,3 9,1 9))

query T
SELECT ST_AsText(ST_AsMVTGeom('POLYGON((1 1, 1 3, 3 3, 3 1, 1 1))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
POLYGON((3 7,3 9,1 9,1 7,3 7))

query T
SELECT ST_AsText(ST_AsMVTGeom('POLYGON((1 1, 9 1, 9 9, 1 9, 1 1), (3 3, 3 5, 5 5, 5 3, 3 3))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
POLYGON((1 9,1 1,9 1,9 9,1 9),(5 5,3 5,3 7,5 7,5 5))

query T
SELECT ST_AsText(ST_AsMVTGeom('POLYGON((1 1, 9 1, 9 9, 1 9, 1 1), (3 3, 5 3, 5 5, 3 5, 3 3), (6 6, 7 6, 7 7, 6 7, 6 6))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
POLYGON((1 9,1 1,9 1,9 9,1 9),(3 7,5 7,5 5,3 5,3 7),(6 4,7 4,7 3,6 3,6 4))

query T
SELECT ST_AsText(ST_AsMVTGeom('POLYGON((0 0, 10 0, 10 5, 0 -5, 0 0))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0, false))
----
MULTIPOLYGON(((5 10,10 5,10 10,5 10)),((5 10,0 15,0 10,5 10)))

query T
SELECT ST_AsText(ST_AsMVTGeom('POLYGON((0 0, 4 4, 4 0, 0 4, 0 0))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
MULTIPOLYGON(((4 6,4 10,2 8,4 6)),((0 6,2 8,0 10,0 6)))

query T
SELECT ST_AsText(ST_AsMVTGeom('POLYGON Z ((1 1 1, 3 1 1, 3 3 1, 1 3 1, 1 1 1))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
POLYGON((1 9,1 7,3 7,3 9,1 9))

query T
SELECT ST_AsText(ST_AsMVTGeom('POLYGON M ((1 1 1, 3 1 1, 3 3 1, 1 3 1, 1 1 1))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
POLYGON((1 9,1 7,3 7,3 9,1 9))

# Polygons: the rings of all parts are unioned under the even-odd rule
query T
SELECT ST_AsText(ST_AsMVTGeom('MULTIPOLYGON(((1 1, 3 1, 3 3, 1 3, 1 1)), ((2 2, 4 2, 4 4, 2 4, 2 2)))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
MULTIPOLYGON(((3 8,3 7,2 7,2 6,4 6,4 8,3 8)),((3 8,3 9,1 9,1 7,2 7,2 8,3 8)))

query T
SELECT ST_AsText(ST_AsMVTGeom('MULTIPOLYGON(((1 1, 3 1, 3 3, 1 3, 1 1)), ((1 1, 3 1, 3 3, 1 3, 1 1)))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
NULL

query T
SELECT ST_AsText(ST_AsMVTGeom('MULTIPOLYGON(((5 5, 7 5, 7 7, 5 7, 5 5)), ((1 1, 3 1, 3 3, 1 3, 1 1)))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
MULTIPOLYGON(((1 9,1 7,3 7,3 9,1 9)),((5 5,5 3,7 3,7 5,5 5)))

query T
SELECT ST_AsText(ST_AsMVTGeom('POLYGON((1 1, 3 1, 3 3, 1 3, 1 1), (5 5, 7 5, 7 7, 5 7, 5 5))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
MULTIPOLYGON(((1 9,1 7,3 7,3 9,1 9)),((5 5,5 3,7 3,7 5,5 5)))

query T
SELECT ST_AsText(ST_AsMVTGeom('POLYGON((1 1, 9 1, 9 9, 1 9, 1 1), (1 1, 5 1, 5 5, 1 5, 1 1))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
POLYGON((1 5,1 1,9 1,9 9,5 9,5 5,1 5))

# Polygons: small, collapsed and degenerate rings
query T
SELECT ST_AsText(ST_AsMVTGeom('POLYGON((1 1, 2 1, 1 2, 1 1))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
NULL

query T
SELECT ST_AsText(ST_AsMVTGeom('POLYGON((1 1, 3 1, 1 2, 1 1))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
POLYGON((1 8,3 9,1 9,1 8))

query T
SELECT ST_AsText(ST_AsMVTGeom('POLYGON((1.6 1.6, 2.4 1.6, 2.4 2.4, 1.6 2.4, 1.6 1.6))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
NULL

query T
SELECT ST_AsText(ST_AsMVTGeom('POLYGON((1 1, 2 1, 3 1, 1 1), (5 5, 6 5, 6 6, 5 5))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
NULL

query T
SELECT ST_AsText(ST_AsMVTGeom('POLYGON((1 1, 3 1, 3 3, 1 3, 1 1), (1.1 1.1, 1.2 1.1, 1.2 1.2, 1.1 1.1))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
POLYGON((1 9,1 7,3 7,3 9,1 9))

query T
