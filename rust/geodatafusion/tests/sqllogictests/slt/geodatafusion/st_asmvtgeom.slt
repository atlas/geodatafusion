# Polygons whose shell is clipped away go, holes and all
query T
SELECT ST_AsText(ST_AsMVTGeom('POLYGON((-50 -50, -30 -50, -30 -30, -50 -30, -50 -50), (5 5, 7 5, 7 7, 5 7, 5 5))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
NULL

query T
SELECT ST_AsText(ST_AsMVTGeom('MULTIPOLYGON(((-50 -50, -30 -50, -30 -30, -50 -30, -50 -50), (5 5, 7 5, 7 7, 5 7, 5 5)), ((8 8, 9 8, 9 9, 8 9, 8 8)))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
POLYGON((8 2,8 1,9 1,9 2,8 2))

query T
SELECT ST_AsText(ST_AsMVTGeom('POLYGON((1 1, 9 1, 9 9, 1 9, 1 1), (2 2, 20 2, 20 3, 2 3, 2 2))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
MULTIPOLYGON(((9 7,2 7,2 8,9 8,9 9,1 9,1 1,9 1,9 7)),((9 7,10 7,10 8,9 8,9 7)))

# Without clipping, rings are clipped to the shells' bounding box
query T
SELECT ST_AsText(ST_AsMVTGeom('POLYGON((0 0, 10 0, 10 10, 0 10, 0 0), (1 1, 1000 1, 2 2, 1 2, 1 1))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(4096, 4096)), 4096, 0, false))
