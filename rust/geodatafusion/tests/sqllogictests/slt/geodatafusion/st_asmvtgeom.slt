# Collections keep their parts of the highest dimension
query T
SELECT ST_AsText(ST_AsMVTGeom('GEOMETRYCOLLECTION(POINT(1 1), LINESTRING(1 1, 3 3))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
LINESTRING(1 9,3 7)

query T
SELECT ST_AsText(ST_AsMVTGeom('GEOMETRYCOLLECTION(POINT(1 1), POINT(2 2))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
