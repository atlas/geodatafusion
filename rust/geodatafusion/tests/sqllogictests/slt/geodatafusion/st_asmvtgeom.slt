# Polygons are clipped in double precision and truncated
query T
SELECT ST_AsText(ST_AsMVTGeom('POLYGON((-5 -5, 15 -5, 15 15, -5 15, -5 -5))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
----
POLYGON((0 10,0 0,10 0,10 10,0 10))

