query T
SELECT ST_AsText(ST_AsMVTGeom('GEOMETRYCOLLECTION(POLYGON((1 1, 3 1, 3 3, 1 3, 1 1)), LINESTRING(5 5, 7 5), POLYGON((5 5, 7 5, 7 7, 5 5)))'::geometry, ST_MakeBox2D(ST_Point(0, 0), ST_Point(10, 10)), 10, 0))
