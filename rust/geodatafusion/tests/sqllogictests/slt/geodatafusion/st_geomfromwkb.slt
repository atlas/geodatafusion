# Edge cases for ST_GeomFromWKB, not covered by the PostGIS docs examples.

# ISO WKB, EWKB, both byte orders
query T
SELECT ST_GeomFromWKB(decode('0101000000000000000000F03F0000000000000040', 'hex'))
----
POINT(1 2)

query T
SELECT ST_GeomFromWKB(decode('01E9030000000000000000F03F00000000000000400000000000000840', 'hex'))
----
POINT Z (1 2 3)

query T
SELECT ST_GeomFromWKB(decode('00000000013FF00000000000004000000000000000', 'hex'))
----
POINT(1 2)

query T
SELECT ST_GeomFromWKB(decode('0101000020E6100000000000000000F03F0000000000000040', 'hex'))
----
SRID=4326;POINT(1 2)

query T
SELECT ST_GeomFromWKB(decode('01010000A0E6100000000000000000F03F00000000000000400000000000000840', 'hex'))
----
SRID=4326;POINT Z (1 2 3)

query T
SELECT ST_GeomFromWKB(decode('0101000000000000000000F87F000000000000F87F', 'hex'))
----
POINT EMPTY

# Trailing bytes are ignored
query T
SELECT ST_GeomFromWKB(decode('0101000000000000000000F03F000000000000004000', 'hex'))
----
POINT(1 2)

# The srid argument overrides an embedded SRID
query T
SELECT ST_GeomFromWKB(decode('0101000000000000000000F03F0000000000000040', 'hex'), 4326)
----
SRID=4326;POINT(1 2)

query T
SELECT ST_GeomFromWKB(decode('0101000020E6100000000000000000F03F0000000000000040', 'hex'), 3857)
----
SRID=3857;POINT(1 2)

query T
SELECT ST_GeomFromWKB(decode('0101000000000000000000F03F0000000000000040', 'hex'), -5)
----
POINT(1 2)

query T
SELECT ST_GeomFromWKB(decode('0101000000000000000000F03F0000000000000040', 'hex'), NULL)
----
NULL

# Round trips
query T
SELECT ST_GeomFromWKB(ST_AsEWKB('SRID=4326;MULTIPOLYGON Z (((0 0 1,1 0 1,1 1 1,0 0 1)))'::geometry))
----
SRID=4326;MULTIPOLYGON Z (((0 0 1,1 0 1,1 1 1,0 0 1)))

query T
SELECT ST_GeomFromWKB(ST_AsBinary('GEOMETRYCOLLECTION M (POINT M (1 2 3),LINESTRING M EMPTY)'::geometry, 'XDR'))
----
GEOMETRYCOLLECTION M (POINT M (1 2 3),LINESTRING M EMPTY)

# Truncated input is an error
statement error
SELECT ST_GeomFromWKB(decode('0101', 'hex'))

# NULL
query T
SELECT ST_GeomFromWKB(NULL)
----
NULL

# A column, including NULL
query T rowsort
SELECT ST_GeomFromWKB(decode(h, 'hex')) FROM (VALUES ('0101000000000000000000F03F0000000000000040'), (NULL), ('00000000013FF00000000000004000000000000000')) AS t(h)
----
NULL
POINT(1 2)
POINT(1 2)

# Nested collections
query T
SELECT ST_AsText(ST_GeomFromWKB(ST_AsBinary('GEOMETRYCOLLECTION(GEOMETRYCOLLECTION(POINT(1 2)),POINT(3 4))'::geometry)))
----
GEOMETRYCOLLECTION(GEOMETRYCOLLECTION(POINT(1 2)),POINT(3 4))
