# Edge cases for ST_Transform, not covered by the PostGIS docs examples.

# To an SRID
query T
SELECT ST_Transform('SRID=4326;POINT(1 2)'::geometry, 3857)
----
SRID=3857;POINT(111319.490793 222684.208506)

query T
SELECT ST_Transform('SRID=4326;LINESTRING(0 0,10 10,-71 42)'::geometry, 3857)
----
SRID=3857;LINESTRING(0 0,1113194.90793 1118889.97486,-7903683.84632 5160979.44405)

query T
SELECT ST_Transform('SRID=3857;POINT(111319.49079327357 222684.20850554405)'::geometry, 4326)
----
SRID=4326;POINT(1 2)

query T
SELECT ST_Transform('SRID=4326;POLYGON((0 0,1 0,1 1,0 0),(0.2 0.2,0.4 0.2,0.4 0.4,0.2 0.2))'::geometry, 32631)
----
SRID=32631;POLYGON((166021.443081 0,277404.560324 0,277438.263521 110597.972524,166021.443081 0),(188307.066359 22132.6113937,210586.835213 22128.9437481,210592.096745 44257.8917917,188307.066359 22132.6113937))

query T
SELECT ST_Transform('SRID=4326;GEOMETRYCOLLECTION(POINT(1 2),LINESTRING(0 0,1 1))'::geometry, 3857)
----
SRID=3857;GEOMETRYCOLLECTION(POINT(111319.490793 222684.208506),LINESTRING(0 0,111319.490793 111325.142866))

query T
SELECT ST_Transform('SRID=2249;POINT(743238 2967416)'::geometry, 4326)
----
SRID=4326;POINT(-71.1776848522 42.3902896513)

query T
SELECT ST_Transform('SRID=4326;POINT(143 -37)'::geometry, 7844)
----
SRID=7844;POINT(143 -37)

query T
SELECT ST_Transform('SRID=4326;POINT(-71 42)'::geometry, 102003)
----
SRID=102003;POINT(2033016.72601 773087.759548)

# Z is transformed, M kept
query T
SELECT ST_Transform('SRID=4326;POINT ZM (1 2 3 4)'::geometry, 4978)
----
SRID=4978;POINT ZM (6373309.7623 111246.535709 221104.65001 4)

query T
SELECT ST_Transform('SRID=4326;POINT M (1 2 4)'::geometry, 3857)
----
SRID=3857;POINT M (111319.490793 222684.208506 4)

query T
SELECT ST_Transform('SRID=4326;POINT Z (1 2 3)'::geometry, 3857)
----
SRID=3857;POINT Z (111319.490793 222684.208506 3)

# The same SRID, and EMPTY
query T
SELECT ST_Transform('SRID=4326;POINT(1 2)'::geometry, 4326)
----
SRID=4326;POINT(1 2)

query T
SELECT ST_Transform('SRID=4326;POINT EMPTY'::geometry, 3857)
----
SRID=3857;POINT EMPTY

query T
SELECT ST_Transform('SRID=4326;MULTIPOINT(EMPTY,(1 2))'::geometry, 3857)
----
SRID=3857;MULTIPOINT(EMPTY,(111319.490793 222684.208506))

# PROJ texts, which give SRID 0 unless the target is an SRID
query T
SELECT ST_Transform('SRID=4326;POINT(1 2)'::geometry, 'EPSG:3857')
----
POINT(111319.490793 222684.208506)

query T
SELECT ST_Transform('SRID=4326;POINT(-160 70)'::geometry, '+proj=gnom +ellps=WGS84 +lat_0=70 +lon_0=-160 +no_defs')
----
POINT(0 0)

query T
SELECT ST_Transform('POINT(1 2)'::geometry, 'EPSG:4326', 'EPSG:3857')
----
POINT(111319.490793 222684.208506)

query T
SELECT ST_Transform('POINT(1 2)'::geometry, 'EPSG:4326', 3857)
----
SRID=3857;POINT(111319.490793 222684.208506)

query T
SELECT ST_Transform('POINT(1 2)'::geometry, '+proj=longlat +datum=WGS84 +no_defs', 3857)
----
SRID=3857;POINT(111319.490793 222684.208506)

# NULL
query T
SELECT ST_Transform(NULL::geometry, 3857)
----
NULL

query T
SELECT ST_Transform('SRID=4326;POINT(1 2)'::geometry, NULL::text)
----
NULL

# Errors
query error
SELECT ST_Transform('POINT(1 2)'::geometry, 3857)

query error
SELECT ST_Transform('SRID=4326;POINT(1 2)'::geometry, 0)

query error
SELECT ST_Transform('SRID=4326;POINT(1 2)'::geometry, 'nonsense')

query error
SELECT ST_Transform('SRID=4326;POINT(1 100)'::geometry, 3857)

# A column
query error
SELECT ST_Transform(g, 3857)) FROM (VALUES ('SRID=4326;POINT(1 2)'::geometry), (NULL::geometry), ('SRID=4326;POINT(-71 42)'::geometry)) AS t(g
