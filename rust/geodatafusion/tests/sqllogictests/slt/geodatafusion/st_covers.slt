# ST_Covers with constant and column arguments in both positions, NULL constants, and geography.

# Constant first argument, column second
query TT rowsort
SELECT ST_AsText(g), ST_Covers('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, g)
FROM (VALUES ('POINT(5 5)'::geometry), ('POINT(20 20)'::geometry), ('POLYGON((0 0,20 0,20 20,0 20,0 0))'::geometry)) AS t(g)
----
POINT(20 20) false
POINT(5 5) true
POLYGON((0 0,20 0,20 20,0 20,0 0)) false

# Column first argument, constant second
query TT rowsort
SELECT ST_AsText(g), ST_Covers(g, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry)
FROM (VALUES ('POINT(5 5)'::geometry), ('POINT(20 20)'::geometry), ('POLYGON((0 0,20 0,20 20,0 20,0 0))'::geometry)) AS t(g)
----
POINT(20 20) false
POINT(5 5) false
POLYGON((0 0,20 0,20 20,0 20,0 0)) true

# Column arguments on both sides
query TTT rowsort
SELECT ST_AsText(a), ST_AsText(b), ST_Covers(a, b)
FROM (VALUES
  ('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 'POINT(5 5)'::geometry),
  ('POINT(5 5)'::geometry, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry)
) AS t(a, b)
----
POINT(5 5) POLYGON((0 0,10 0,10 10,0 10,0 0)) false
POLYGON((0 0,10 0,10 10,0 10,0 0)) POINT(5 5) true

# NULL constant first argument
query T rowsort
SELECT ST_Covers(NULL::geometry, g)
FROM (VALUES ('POINT(5 5)'::geometry), ('POINT(20 20)'::geometry)) AS t(g)
----
NULL
NULL

# NULL constant second argument
query T rowsort
SELECT ST_Covers(g, NULL::geometry)
FROM (VALUES ('POINT(5 5)'::geometry), ('POINT(20 20)'::geometry)) AS t(g)
----
NULL
NULL

# Point, line and polygon pairs
query T
SELECT ST_Covers('POINT(5 5)'::geometry, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry)
----
false

query T
SELECT ST_Covers('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 'POINT(5 5)'::geometry)
----
true

query T
SELECT ST_Covers('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 'POINT(10 5)'::geometry)
----
true

query T
SELECT ST_Covers('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 'LINESTRING(-5 5,15 5)'::geometry)
----
false

query T
SELECT ST_Covers('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 'POLYGON((5 5,15 5,15 15,5 15,5 5))'::geometry)
----
false

query T
SELECT ST_Covers('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 'POLYGON((10 0,20 0,20 10,10 10,10 0))'::geometry)
----
false

query T
SELECT ST_Covers('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 'POLYGON((0 0,0 10,10 10,10 0,0 0))'::geometry)
----
true

query T
SELECT ST_Covers('LINESTRING(0 0,10 10)'::geometry, 'LINESTRING(0 10,10 0)'::geometry)
----
false

query T
SELECT ST_Covers('MULTIPOINT((1 1),(20 20))'::geometry, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry)
----
false

query T
SELECT ST_Covers('GEOMETRYCOLLECTION(POINT(5 5),LINESTRING(1 1,2 2))'::geometry, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry)
----
false

query T
SELECT ST_Covers('POINT Z (5 5 1)'::geometry, 'POLYGON M ((0 0 1,10 0 1,10 10 1,0 10 1,0 0 1))'::geometry)
----
false

# EMPTY inputs
query T
SELECT ST_Covers('POINT EMPTY'::geometry, 'POINT(1 1)'::geometry)
----
false

query T
SELECT ST_Covers('POINT(1 1)'::geometry, 'POLYGON EMPTY'::geometry)
----
false

query T
SELECT ST_Covers('POINT EMPTY'::geometry, 'POINT EMPTY'::geometry)
----
false

query T
SELECT ST_Covers('GEOMETRYCOLLECTION(POINT EMPTY,POINT(1 1))'::geometry, 'POINT(1 1)'::geometry)
----
true

query T
SELECT ST_Covers('POLYGON EMPTY'::geometry, 'GEOMETRYCOLLECTION(LINESTRING EMPTY,POINT(1 1))'::geometry)
----
false

# SRID
query T
SELECT ST_Covers('SRID=4326;POINT(1 1)'::geometry, 'SRID=4326;POINT(1 1)'::geometry)
----
true

statement error
SELECT ST_Covers('SRID=4326;POINT(1 1)'::geometry, 'SRID=3857;POINT(1 1)'::geometry)

# NULL
query T
SELECT ST_Covers(NULL::geometry, 'POINT(1 1)'::geometry)
----
NULL

# Columns on both sides
query T rowsort
SELECT ST_Covers(a, b) FROM (VALUES ('POINT(5 5)'::geometry, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry), ('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geometry, 'POINT(5 5)'::geometry), ('POINT(1 1)'::geometry, NULL::geometry)) AS t(a, b)
----
NULL
false
true

# Geography: a polygon covers points inside it and on its shell, but not on a hole's edge
query TTTT
SELECT ST_Covers('POLYGON((0 0,10 0,10 10,0 10,0 0),(4 4,6 4,6 6,4 6,4 4))'::geography, 'POINT(1 1)'::geography), ST_Covers('POLYGON((0 0,10 0,10 10,0 10,0 0),(4 4,6 4,6 6,4 6,4 4))'::geography, 'POINT(10 5)'::geography), ST_Covers('POLYGON((0 0,10 0,10 10,0 10,0 0),(4 4,6 4,6 6,4 6,4 4))'::geography, 'POINT(5 5)'::geography), ST_Covers('POLYGON((0 0,10 0,10 10,0 10,0 0),(4 4,6 4,6 6,4 6,4 4))'::geography, 'POINT(4 5)'::geography)
----
true true false false

# It covers lines and polygons whose edges don't cross or touch its rings: not its boundary, nor itself
query TTTTT
SELECT ST_Covers('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geography, 'LINESTRING(1 1, 5 5)'::geography), ST_Covers('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geography, 'LINESTRING(1 1, 10 5)'::geography), ST_Covers('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geography, 'LINESTRING(0 0, 10 0)'::geography), ST_Covers('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geography, 'POLYGON((0 0,10 0,10 10,0 10,0 0))'::geography), ST_Covers('POLYGON((0 0,10 0,10 10,5 2,0 10,0 0))'::geography, 'LINESTRING(1 5, 9 5)'::geography)
----
true false false false false

# A hole inside the covered polygon isn't noticed
query T
SELECT ST_Covers('POLYGON((0 0,10 0,10 10,0 10,0 0),(4 4,6 4,6 6,4 6,4 4))'::geography, 'POLYGON((1 1,9 1,9 9,1 9,1 1))'::geography)
----
true

# A line covers points on its edges, and lines by their first and last points
query TTTTT
SELECT ST_Covers('LINESTRING(0 0, 10 0)'::geography, 'POINT(5 0)'::geography), ST_Covers('LINESTRING(0 0, 10 0)'::geography, 'POINT(5 0.000000000001)'::geography), ST_Covers('LINESTRING(0 0, 10 0)'::geography, 'POINT(5 0.000000000003)'::geography), ST_Covers('LINESTRING(0 0, 10 0)'::geography, 'LINESTRING(2 0, 50 50, 3 0)'::geography), ST_Covers('LINESTRING(0 0, 10 0)'::geography, 'LINESTRING(0 0, 5 5)'::geography)
----
true true false true false

# A point covers the same point; nothing else covers anything
query TTTT
SELECT ST_Covers('POINT(1 2)'::geography, 'POINT(1 2)'::geography), ST_Covers('POINT(1 2)'::geography, 'POINT(1 2.000000000001)'::geography), ST_Covers('POINT(0 0)'::geography, 'LINESTRING(0 0, 0 0)'::geography), ST_Covers('LINESTRING(0 0, 10 0, 10 10, 0 10, 0 0)'::geography, 'POLYGON((0 0, 10 0, 10 10, 0 10, 0 0))'::geography)
----
true false false false

# One part must cover all of the other
query TTTT
SELECT ST_Covers('MULTIPOLYGON(((0 0,10 0,10 10,0 10,0 0)),((20 0,30 0,30 10,20 0)))'::geography, 'MULTIPOINT(5 5, 6 6)'::geography), ST_Covers('MULTIPOLYGON(((0 0,10 0,10 10,0 10,0 0)),((20 0,30 0,30 10,20 0)))'::geography, 'MULTIPOINT(5 5, 25 2)'::geography), ST_Covers('MULTIPOINT(0 0, 1 1)'::geography, 'MULTIPOINT(1 1, 0 0)'::geography), ST_Covers('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geography, 'GEOMETRYCOLLECTION(POINT(1 1), LINESTRING(2 2, 3 3))'::geography)
----
true false false true

# EMPTY, NULL, geometry cast to geography, and mixed SRIDs
query TTTT
SELECT ST_Covers('POINT EMPTY'::geography, 'POINT(0 0)'::geography), ST_Covers('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geography, 'GEOMETRYCOLLECTION EMPTY'::geography), ST_Covers('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geography, NULL::geography), ST_Covers('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geography, 'POINT(1 1)'::geometry)
----
false false NULL true

query error
SELECT ST_Covers('POLYGON((0 0,10 0,10 10,0 10,0 0))'::geography, 'SRID=4269;POINT(1 1)'::geography)
