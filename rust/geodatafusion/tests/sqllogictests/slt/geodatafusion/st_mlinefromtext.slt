# Edge cases for ST_MLineFromText, not covered by the PostGIS docs examples.

# The right type, with and without SRID
query T
SELECT ST_MLineFromText('MULTILINESTRING((0 0,1 1))')
----
MULTILINESTRING((0 0,1 1))

query T
SELECT ST_MLineFromText('MULTILINESTRING((0 0,1 1))', 4326)
----
SRID=4326;MULTILINESTRING((0 0,1 1))

query T
SELECT ST_MLineFromText('SRID=3857;MULTILINESTRING((0 0,1 1))')
----
SRID=3857;MULTILINESTRING((0 0,1 1))

query T
SELECT ST_MLineFromText('MULTILINESTRING EMPTY')
----
MULTILINESTRING EMPTY

# Another type is NULL
query T
SELECT ST_MLineFromText('LINESTRING(0 0,1 1)')
----
NULL

query T
SELECT ST_MLineFromText('GEOMETRYCOLLECTION EMPTY')
----
NULL

# Invalid text is an error
statement error
SELECT ST_MLineFromText('nonsense')

# NULL
query T
SELECT ST_MLineFromText(NULL)
----
NULL

query T
SELECT ST_MLineFromText('MULTILINESTRING((0 0,1 1))', NULL)
----
NULL

# A column, including NULL and another type
query T rowsort
SELECT ST_MLineFromText(t) FROM (VALUES ('MULTILINESTRING((0 0,1 1))'), (NULL), ('LINESTRING(0 0,1 1)')) AS v(t)
----
MULTILINESTRING((0 0,1 1))
NULL
NULL
