# Edge cases for ST_YMin, not covered by the PostGIS docs examples.

# Every type
query R
SELECT ST_YMin('POINT(1 2)'::geometry)
----
2

query R
SELECT ST_YMin('LINESTRING(0 0,3 4)'::geometry)
----
0

query R
SELECT ST_YMin('POLYGON((0 0,10 0,10 10,0 0),(1 1,2 1,2 2,1 1))'::geometry)
----
0

query R
SELECT ST_YMin('MULTIPOINT(1 2,-3 4)'::geometry)
----
2

query R
SELECT ST_YMin('GEOMETRYCOLLECTION(POINT(5 6),LINESTRING(0 0,1 -1))'::geometry)
----
-1

# Every dimension
query R
SELECT ST_YMin('LINESTRING Z (1 2 3,4 5 -6)'::geometry)
----
2

query R
SELECT ST_YMin('LINESTRING M (1 2 3,4 5 6)'::geometry)
----
2

query R
SELECT ST_YMin('LINESTRING ZM (1 2 3 4,4 5 6 7)'::geometry)
----
2

query R
SELECT ST_YMin('SRID=4326;POINT(1 2)'::geometry)
----
2

# EMPTY and NULL
query R
SELECT ST_YMin('POINT EMPTY'::geometry)
----
NULL

query R
SELECT ST_YMin('LINESTRING Z EMPTY'::geometry)
----
NULL

query R
SELECT ST_YMin('GEOMETRYCOLLECTION EMPTY'::geometry)
----
NULL

query R
SELECT ST_YMin('MULTIPOINT(EMPTY,(1 1))'::geometry)
----
1

query R
SELECT ST_YMin('GEOMETRYCOLLECTION(POINT EMPTY,POINT(3 4))'::geometry)
----
4

query R
SELECT ST_YMin(NULL::geometry)
----
NULL

# A column, including NULL
query R rowsort
SELECT ST_YMin(g) FROM (VALUES ('LINESTRING Z (1 2 3,4 5 6)'::geometry), (NULL::geometry), ('POINT EMPTY'::geometry)) AS t(g)
----
2
NULL
NULL
