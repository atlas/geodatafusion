# Example 1
query T
SELECT ST_AsText(ST_LineSubstring( 'LINESTRING (20 180, 50 20, 90 80, 120 40, 180 150)', 0.333, 0.666))
----
LINESTRING(45.17311810399485 45.74337011202746,50 20,90 80,112.97593050157862 49.36542599789519)

# Example 2
