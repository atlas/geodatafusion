# Example 1
query T
SELECT ST_PointFromText('POINT(-71.064544 42.28787)')
----
POINT(-71.064544 42.28787)

query T
SELECT ST_PointFromText('POINT(-71.064544 42.28787)', 4326)
----
SRID=4326;POINT(-71.064544 42.28787)
