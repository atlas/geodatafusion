# Example 1
query T
SELECT ST_EndPoint('POINT(1 1)'::geometry) IS NULL AS is_null
----
true

# Example 2
query T
SELECT ST_AsEWKT(ST_EndPoint('LINESTRING(1 1 2, 1 2 3, 0 0 5)'))
----
POINT(0 0 5)

# Example 3
query T
SELECT ST_AsText(ST_EndPoint('CIRCULARSTRING(5 2,-3 1.999999, -2 1, -4 2, 6 3)'::geometry))
----
POINT(6 3)
