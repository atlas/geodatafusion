# Example 1
query T
SELECT ST_MPointFromText('MULTIPOINT((1 2),(3 4))')
----
MULTIPOINT((1 2),(3 4))

query T
SELECT ST_MPointFromText('MULTIPOINT((-70.9590 42.1180),(-70.9611 42.1223))', 4326)
----
SRID=4326;MULTIPOINT((-70.959 42.118),(-70.9611 42.1223))
