# Example 1
query T
SELECT ST_PointZM(-71.104, 42.315, 3.4, 4.5, 4326)
----
SRID=4326;POINT ZM (-71.104 42.315 3.4 4.5)

# Example 2
query T
SELECT ST_PointZM(-71.104, 42.315, 3.4, 4.5, srid => 4326)
----
SRID=4326;POINT ZM (-71.104 42.315 3.4 4.5)

# Example 3
query T
SELECT ST_PointZM(-71.104, 42.315, 3.4, 4.5)
----
