# Example 1
query T
SELECT Box2D(ST_GeomFromText('LINESTRING(1 2, 3 4, 5 6)'))
----
BOX(1 2,5 6)

# Example 2
query T
SELECT Box2D(ST_GeomFromText('CIRCULARSTRING(220268 150415,220227 150505,220227 150406)'))
----
BOX(220186.995122 150406,220288.248781 150506.126829)
