# Example 1
query I
SELECT ST_NumCurves('COMPOUNDCURVE(
    (2 2, 2.5 2.5),
    CIRCULARSTRING(2.5 2.5, 4.5 2.5, 3.5 3.5),
    (3.5 3.5, 2.5 4.5, 3 5, 2 2)
  )')
----
3

query I
SELECT ST_NumCurves('COMPOUNDCURVE EMPTY')
----
0
