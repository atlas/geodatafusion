# Example 1
query TT
SELECT ST_AsText(geom) as line, ST_AsText(ST_Reverse(geom)) As reverseline
FROM
(SELECT ST_MakeLine(ST_Point(1,2),
		ST_Point(1,10)) As geom) as foo
----
LINESTRING(1 2,1 10) LINESTRING(1 10,1 2)
