# PostGIS documentation examples for ST_Relate
# Source: PostGIS 3.6.4 doc/reference_relationship.xml (https://postgis.net/docs/ST_Relate.html)
# The SQL in this file is derived from the PostGIS documentation, licensed CC BY-SA 3.0.
# Generated by dev/extract_postgis_doc_examples.py; expected results recorded from PostGIS
# with `--complete`. Do not edit by hand; regenerate instead.

# Example 1
query T
SELECT ST_Relate( 'POINT(1 2)',
                  ST_Buffer( 'POINT(1 2)', 2))
----
0FFFFF212

query T
SELECT ST_Relate( 'LINESTRING(1 2, 3 4)',
                  'LINESTRING(5 6, 7 8)' )
----
FF1FF0102

# Example 2
query TT
WITH data AS (SELECT
  'LINESTRING(1 1, 3 3)'::geometry AS a_line,
  'MULTILINESTRING((3 3, 3 5), (3 3, 5 3))':: geometry AS b_multiline
)
SELECT ST_Relate( a_line, b_multiline, 1) AS bnr_mod2,
       ST_Relate( a_line, b_multiline, 2) AS bnr_endpoint
    FROM data
----
FF10F0102 FF1F00102
