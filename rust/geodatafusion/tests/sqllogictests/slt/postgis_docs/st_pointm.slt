# Example 1
query T
SELECT ST_PointM(-71.104, 42.315, 3.4, 4326)
----
SRID=4326;POINT M (-71.104 42.315 3.4)

# Example 2
query T
SELECT ST_PointM(-71.104, 42.315, 3.4, srid => 4326)
----
SRID=4326;POINT M (-71.104 42.315 3.4)

# Example 3
query T
SELECT ST_PointM(-71.104, 42.315, 3.4)
----
POINT M (-71.104 42.315 3.4)
