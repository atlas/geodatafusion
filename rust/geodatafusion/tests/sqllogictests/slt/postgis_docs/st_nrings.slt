# Example 1
query II
SELECT ST_NRings(geom) As Nrings, ST_NumInteriorRings(geom) As ninterrings
					FROM (SELECT ST_GeomFromText('POLYGON((1 2, 3 4, 5 6, 1 2))') As geom) As foo
