# Generated by dev/extract_postgis_doc_examples.py; expected results recorded from PostGIS
# with `--complete`. Do not edit by hand; regenerate instead.

# Example 1
query T
SELECT ST_AsText(ST_PointOnSurface('POINT(0 5)'::geometry))
----
POINT(0 5)

query T
SELECT ST_AsText(ST_PointOnSurface('LINESTRING(0 5, 0 10)'::geometry))
----
POINT(0 5)

query T
SELECT ST_AsText(ST_PointOnSurface('POLYGON((0 0, 0 5, 5 5, 5 0, 0 0))'::geometry))
----
POINT(2.5 2.5)

query T
SELECT ST_AsEWKT(ST_PointOnSurface(ST_GeomFromEWKT('LINESTRING(0 5 1, 0 0 1, 0 10 2)')))
----
POINT(0 0 1)

# Example 2
query TT
SELECT ST_AsText(ST_PointOnSurface(geom)) AS pt_on_surf,
       ST_AsText(ST_Centroid(geom)) AS centroid
    FROM (SELECT 'POLYGON ((130 120, 120 190, 30 140, 50 20, 190 20,
                      170 100, 90 60, 90 130, 130 120))'::geometry AS geom) AS t
----
POINT(62.5 110) POINT(100.18264840182648 85.11415525114155)
