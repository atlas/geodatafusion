# PostGIS documentation examples for ST_MakeLine
# Source: PostGIS 3.6.4 doc/reference_constructor.xml (https://postgis.net/docs/ST_MakeLine.html)
# The SQL in this file is derived from the PostGIS documentation, licensed CC BY-SA 3.0.
# Generated by dev/extract_postgis_doc_examples.py; expected results recorded from PostGIS
# with `--complete`. Do not edit by hand; regenerate instead.

# Example 1
query T
SELECT ST_AsText( ST_MakeLine(ST_Point(1,2), ST_Point(3,4)) )
----
LINESTRING(1 2,3 4)

# Example 2
query T
SELECT ST_AsEWKT( ST_MakeLine(ST_MakePoint(1,2,3), ST_MakePoint(3,4,5) ))
----
LINESTRING(1 2 3,3 4 5)

# Example 3
query T
select ST_AsText( ST_MakeLine( 'LINESTRING(0 0, 1 1)', 'LINESTRING(2 2, 3 3)' ) )
----
LINESTRING(0 0,1 1,2 2,3 3)

# Example 4
query T
SELECT ST_AsEWKT( ST_MakeLine(
          ARRAY[ ST_MakePoint(1,2,3), ST_MakePoint(3,4,5), ST_MakePoint(6,6,6) ]  ))
----
LINESTRING(1 2 3,3 4 5,6 6 6)
