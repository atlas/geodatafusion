# Generated by dev/extract_postgis_doc_examples.py; expected results recorded from PostGIS
# with `--complete`. Do not edit by hand; regenerate instead.

# Example 1
query T
SELECT ST_AsText(ST_Envelope('POINT(1 3)'::geometry))
----
POINT(1 3)

query T
SELECT ST_AsText(ST_Envelope('LINESTRING(0 0, 1 3)'::geometry))
----
POLYGON((0 0,0 3,1 3,1 0,0 0))

query T
SELECT ST_AsText(ST_Envelope('POLYGON((0 0, 0 1, 1.0000001 1, 1.0000001 0, 0 0))'::geometry))
----
POLYGON((0 0,0 1,1.0000001 1,1.0000001 0,0 0))

query T
SELECT ST_AsText(ST_Envelope('POLYGON((0 0, 0 1, 1.0000000001 1, 1.0000000001 0, 0 0))'::geometry))
----
POLYGON((0 0,0 1,1.0000000001 1,1.0000000001 0,0 0))

query TTT
SELECT Box3D(geom), Box2D(geom), ST_AsText(ST_Envelope(geom)) As envelopewkt
	FROM (SELECT 'POLYGON((0 0, 0 1000012333334.34545678, 1.0000001 1, 1.0000001 0, 0 0))'::geometry As geom) As foo
----
BOX3D(0 0 0,1.0000001 1000012333330 0) BOX(0 0,1.0000001 1000012333330) POLYGON((0 0,0 1000012333334.3455,1.0000001 1000012333334.3455,1.0000001 0,0 0))

# Example 2
query T
SELECT ST_AsText(ST_Envelope(
		ST_Collect(
			ST_GeomFromText('LINESTRING(55 75,125 150)'),
				ST_Point(20, 80))
				)) As wktenv
----
POLYGON((20 75,20 150,125 150,125 75,20 75))
