# Example 1
query T
SELECT ST_AsText(ST_ChaikinSmoothing(geom)) smoothed
FROM (SELECT  'POLYGON((0 0, 8 8, 0 16, 0 0))'::geometry geom) AS foo
----
POLYGON((2 2,6 6,6 10,2 14,0 12,0 4,2 2))

