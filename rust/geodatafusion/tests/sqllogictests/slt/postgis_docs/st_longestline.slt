# PostGIS documentation examples for ST_LongestLine
# Source: PostGIS 3.6.4 doc/reference_measure.xml (https://postgis.net/docs/ST_LongestLine.html)
# The SQL in this file is derived from the PostGIS documentation, licensed CC BY-SA 3.0.
# Generated by dev/extract_postgis_doc_examples.py; expected results recorded from PostGIS
# with `--complete`. Do not edit by hand; regenerate instead.

# Example 1
query T
SELECT ST_AsText( ST_LongestLine(
        'POINT (160 40)',
        'LINESTRING (10 30, 50 50, 30 110, 70 90, 180 140, 130 190)' )
	) AS lline
----
LINESTRING(160 40,130 190)

# Example 2
query T
SELECT ST_AsText( ST_LongestLine(
        'POLYGON ((190 150, 20 10, 160 70, 190 150))',
        ST_Buffer('POINT(80 160)', 30)
            ) ) AS llinewkt
----
LINESTRING(20 10,91.4805029709527 187.7163859753386)

# Example 3
query TRR
SELECT ST_AsText( ST_LongestLine( geom, geom)) AS llinewkt,
                  ST_MaxDistance( geom, geom) AS max_dist,
                  ST_Length( ST_LongestLine(geom, geom)) AS lenll
FROM (SELECT 'POLYGON ((40 180, 110 160, 180 180, 180 120, 140 90, 160 40, 80 10, 70 40, 20 50, 40 180),
              (60 140, 99 77.5, 90 140, 60 140))'::geometry AS geom) AS t
----
LINESTRING(20 50,180 180) 206.155281281 206.155281281
