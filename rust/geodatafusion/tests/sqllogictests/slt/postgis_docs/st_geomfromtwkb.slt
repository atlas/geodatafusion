# Example 1
query T
SELECT ST_AsText(ST_GeomFromTWKB(ST_AsTWKB('LINESTRING(126 34, 127 35)'::geometry)))
----
LINESTRING(126 34,127 35)

query T
SELECT ST_AsEWKT(
  ST_GeomFromTWKB(E'\\x620002f7f40dbce4040105')
)
----
LINESTRING(-113.98 39.198,-113.981 39.195)
