# Example 3
query ITT rowsort
SELECT ST_ClusterKMeans(geom, 3) over (PARTITION BY type) AS cid, parcel_id, type
    FROM parcels
----
0 001 commercial
0 002 residential
1 006 residential
1 007 commercial
2 003 commercial
2 004 residential
2 005 commercial
