# Example 1
query R
SELECT ST_Y(ST_GeomFromEWKT('POINT(1 2 3 4)'))
----
2

query R
SELECT ST_Y(ST_Centroid(ST_GeomFromEWKT('LINESTRING(1 2 3 4, 1 1 1 1)')))
----
1.5
