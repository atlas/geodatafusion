# Example 1
query T
SELECT ST_VoronoiPolygons(
                'MULTIPOINT (50 30, 60 30, 100 100,10 150, 110 120)'::geometry
            ) AS geom
----
GEOMETRYCOLLECTION(POLYGON((-110 270,100.5 270,59.347826087 132.826086957,36.8181818182 92.2727272727,-110 43.3333333333,-110 270)),POLYGON((-110 -90,-110 43.3333333333,36.8181818182 92.2727272727,55 79.2857142857,55 -90,-110 -90)),POLYGON((230 -20.7142857143,55 79.2857142857,36.8181818182 92.2727272727,59.347826087 132.826086957,230 47.5,230 -20.7142857143)),POLYGON((230 -90,55 -90,55 79.2857142857,230 -20.7142857143,230 -90)),POLYGON((230 270,230 47.5,59.347826087 132.826086957,100.5 270,230 270)))

# Example 2
query T
SELECT ST_VoronoiPolygons(
            'MULTIPOINT (50 30, 60 30, 100 100,10 150, 110 120)'::geometry,
            30) AS geom
----
GEOMETRYCOLLECTION(POLYGON((-110 270,135.555555556 270,36.8181818182 92.2727272727,-110 43.3333333333,-110 270)),POLYGON((230 270,230 -45.7142857143,36.8181818182 92.2727272727,135.555555556 270,230 270)),POLYGON((230 -90,-110 -90,-110 43.3333333333,36.8181818182 92.2727272727,230 -45.7142857143,230 -90)))
