+//! E3 copy only: ST_LineMerge, plus (feature geos-wide) a function touching a broad slice of GEOS.
+use geodatafusion::udf::geos::processing::LineMerge;
+use pyo3::prelude::*;
+
+use crate::impl_udf_coord_type_arg;
+
+impl_udf_coord_type_arg!(LineMerge, PyLineMerge, "LineMerge");
+
+#[cfg(feature = "geos-wide")]
+#[pyfunction]
+fn wide(wkb: &[u8], op: &str, d: f64) -> PyResult<usize> {
+    use ::geos::{BufferParams, Geom, Geometry, PreparedGeometry as _};
+    let e = |e: ::geos::Error| pyo3::exceptions::PyValueError::new_err(e.to_string());
+    let g = Geometry::new_from_wkb(wkb).map_err(e)?;
+    let h = g.buffer(d, 8).map_err(e)?;
+    let out: Geometry = match op {
+        "buffer_params" => g.buffer_with_params(d, &BufferParams::builder().build().map_err(e)?).map_err(e)?,
+        "intersection" => g.intersection(&h).map_err(e)?,
+        "union" => g.union(&h).map_err(e)?,
+        "difference" => g.difference(&h).map_err(e)?,
+        "symdifference" => g.sym_difference(&h).map_err(e)?,
+        "unaryunion" => g.unary_union().map_err(e)?,
+        "makevalid" => g.make_valid().map_err(e)?,
+        "simplify" => g.simplify(d).map_err(e)?,
+        "simplifypt" => g.topology_preserve_simplify(d).map_err(e)?,
+        "pos" => g.point_on_surface().map_err(e)?,
+        "hull" => g.convex_hull().map_err(e)?,
+        "concave" => g.concave_hull(d, false).map_err(e)?,
+        "voronoi" => g.voronoi(None::<&Geometry>, d, false).map_err(e)?,
+        "delaunay" => g.delaunay_triangulation(d, false).map_err(e)?,
+        "offset" => g.offset_curve(d, 8, ::geos::JoinStyle::Round, 5.0).map_err(e)?,
+        "node" => g.node().map_err(e)?,
+        "buildarea" => g.build_area().map_err(e)?,
+        "snap" => g.snap(&h, d).map_err(e)?,
+        "sharedpaths" => g.shared_paths(&h).map_err(e)?,
+        "linemerge" => g.line_merge_directed().map_err(e)?,
+        "mrr" => g.minimum_rotated_rectangle().map_err(e)?,
+        "clip" => g.clip_by_rect(0.0, 0.0, d, d).map_err(e)?,
+        "centroid" => g.get_centroid().map_err(e)?,
+        "boundary" => g.boundary().map_err(e)?,
+        "reverse" => g.reverse().map_err(e)?,
+        "polygonize" => Geometry::polygonize(&[Clone::clone(&g)]).map_err(e)?,
+        "mic" => g.maximum_inscribed_circle(d).map_err(e)?,
+        "minclearanceline" => g.minimum_clearance_line().map_err(e)?,
+        "densify" => g.densify(d).map_err(e)?,
+        "precision" => g.set_precision(d, ::geos::Precision::KeepCollapsed).map_err(e)?,
+        _ => {
+            let p = g.to_prepared_geom().map_err(e)?;
+            let n = [
+                p.contains(&h).map_err(e)?,
+                p.intersects(&h).map_err(e)?,
+                p.covers(&h).map_err(e)?,
+                g.relate(&h).map_err(e)?.len() > 3,
+                g.is_valid_reason().map_err(e)?.is_empty(),
+                g.is_simple().map_err(e)?,
+                g.is_ring().map_err(e)?,
+                g.frechet_distance(&h).map_err(e)? > 0.0,
+                g.hausdorff_distance(&h).map_err(e)? > 0.0,
+                g.distance(&h).map_err(e)? > 0.0,
+                g.minimum_clearance().map_err(e)? > 0.0,
+                g.project(&h).map_err(e)? > 0.0,
+                g.equals_exact(&h, d).map_err(e)?,
+            ];
+            return Ok(n.iter().filter(|x| **x).count());
+        }
+    };
+    let mut w = ::geos::WKBWriter::new().map_err(e)?;
+    Ok(w.write_wkb(&out).map_err(e)?.len())
+}
+
+#[pymodule]
+pub(crate) fn geos(m: &Bound<PyModule>) -> PyResult<()> {
+    m.add_class::<PyLineMerge>()?;
+    #[cfg(feature = "geos-wide")]
+    m.add_wrapped(wrap_pyfunction!(wide))?;
+    Ok(())
+}
