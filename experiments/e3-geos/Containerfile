# Approximates the CI runner (ubuntu-latest = 24.04) for E3.
# GEOS 3.12.1 comes from apt libgeos-dev; cmake + g++ are what geos-src needs.
FROM docker.io/library/ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential cmake pkg-config libgeos-dev ca-certificates curl git python3 python3-venv patchelf \
    && rm -rf /var/lib/apt/lists/*
