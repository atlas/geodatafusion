+#[cfg(test)]
+mod user_doc_test {
+    use datafusion::logical_expr::ScalarUDF;
+    use datafusion::logical_expr::scalar_doc_sections::DOC_SECTION_OTHER;
+    use datafusion_doc::DocSection;
+
+    use super::*;
+
+    const SECTION: DocSection = DocSection {
+        include: true,
+        label: "Measurement Functions",
+        description: None,
+    };
+
+    /// The builder code that `#[user_doc]` replaces, parameterised by section.
+    fn builder_doc(section: DocSection) -> Documentation {
+        Documentation::builder(
+            section,
+            "Returns the area of a polygonal geometry.",
+            "ST_Area(geom)",
+        )
+        .with_argument("geom", "geometry")
+        .build()
+    }
+
+    #[test]
+    fn user_doc_equals_builder() {
+        let generated = ScalarUDF::from(Area::new()).documentation().cloned().unwrap();
+        // Whole struct: section (include, label, description), description, syntax, arguments,
+        // sql_example, alternative_syntax, related_udfs.
+        assert_eq!(generated, builder_doc(SECTION));
+        assert!(generated.doc_section.include);
+        assert_eq!(generated.doc_section.label, "Measurement Functions");
+        assert_eq!(generated.doc_section.description, None);
+        // Relative to the pre-migration builder (DOC_SECTION_OTHER), only the section differs.
+        let old = builder_doc(DOC_SECTION_OTHER);
+        assert_eq!(
+            Documentation { doc_section: old.doc_section.clone(), ..generated.clone() },
+            old
+        );
+        // The rendered doc attribute is non-empty and mentions the syntax.
+        assert!(generated.to_doc_attribute().contains("ST_Area(geom)"));
+    }
+}
